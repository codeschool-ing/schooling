      {
        "text": "To compare the target against it",
        "correct": true,
        "why": "Right. It shows what the target should look like."
      },
      {
        "text": "To give the guests internet access",
        "correct": false,
        "why": "The network is isolated."
      },
      {
        "text": "To hold the snapshots of the other two",
        "correct": false,
        "why": "libvirt keeps them on the host."
      },
