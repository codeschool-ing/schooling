  {
    "id": "ex-hk3mky8q",
    "version": 1,
    "section": "the-network",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What in labnet's description keeps traffic from leaving it?",
    "hint": "Lesson 11.",
    "choices": [
      {
        "text": "Its dhcp range",
        "correct": false,
        "why": "That hands out addresses."
      },
      {
        "text": "It has no forward element",
        "correct": true,
        "why": "Right. No forward, no way out."
      },
      {
        "text": "The bridge name virbr2",
        "correct": false,
        "why": "A name decides nothing."
      },
      {
        "text": "net-autostart",
        "correct": false,
        "why": "That starts it at boot."
      }
    ]
  },
