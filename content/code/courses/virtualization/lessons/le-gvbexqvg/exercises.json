  {
    "id": "ex-98acqykg",
    "version": 1,
    "section": "three-ways",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which way of moving a file between guest and host works the same on every hypervisor?",
    "hint": "Two computers.",
    "choices": [
      {
        "text": "A shared folder, set up in the hypervisor's own settings",
        "correct": false,
        "why": "Each hypervisor does it its own way."
      },
      {
        "text": "Over the network",
        "correct": true,
        "why": "Right. scp, a share, a download."
      },
      {
        "text": "Drag and drop",
        "correct": false,
        "why": "It needs the agent and a desktop."
      },
      {
        "text": "The shared clipboard",
        "correct": false,
        "why": "It needs the agent and a desktop."
      }
    ]
  },
