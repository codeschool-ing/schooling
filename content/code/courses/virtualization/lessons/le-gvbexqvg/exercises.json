    "version": 1,
    "section": "whose-rights",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "The guest's first write to the share was refused. By what?",
    "hint": "Who actually writes on the host?",
    "choices": [
      {
        "text": "The guest's own file permissions",
        "correct": false,
        "why": "ana owned her files there."
      },
      {
        "text": "The read-only flag",
        "correct": false,
        "why": "That was on docs, not share."
      },
      {
        "text": "The folder's rights for libvirt-qemu",
        "correct": true,
        "why": "Right. QEMU writes as itself."
      },
      {
        "text": "A full disk",
        "correct": false,
        "why": "Nothing was full."
      }
    ]
  },
