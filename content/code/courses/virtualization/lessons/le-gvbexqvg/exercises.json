    "difficulty": "medium",
    "drillable": true,
    "prompt": "A guest with a writable shared folder is hit by ransomware. What happens to the shared folder?",
    "hint": "Only one copy.",
    "choices": [
      {
        "text": "Nothing; shares are protected",
        "correct": false,
        "why": "The guest can write in it."
      },
      {
        "text": "The host blocks the change by itself",
        "correct": false,
        "why": "It cannot tell."
      },
      {
        "text": "Only the guest's copy changes",
        "correct": false,
        "why": "There is one copy."
      },
      {
        "text": "It is encrypted too",
        "correct": true,
        "why": "Right. They are the host's files."
      }
    ]
  },
