  {
    "id": "ex-z1f13z2w",
    "version": 1,
    "section": "mounting",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which command mounted the tag share in vm1?",
    "hint": "9p over virtio.",
    "choices": [
      {
        "text": "mount -t 9p -o trans=virtio,version=9p2000.L /srv/share /mnt/share",
        "correct": false,
        "why": "The guest mounts by tag; /srv/share is the host's path."
      },
      {
        "text": "mount -t nfs host:/srv/share /mnt/share",
        "correct": false,
        "why": "That is a network share."
      },
      {
        "text": "mount -t 9p -o trans=virtio,version=9p2000.L share /mnt/share",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "ssh host mount share",
        "correct": false,
        "why": "The mount is inside the guest."
      }
    ]
  },
  {
    "id": "ex-pq03m60h",
    "version": 1,
    "section": "mounting",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does the fstab line carry nofail?",
    "hint": "If the share is not there.",
    "choices": [
      {
        "text": "So writes never fail",
        "correct": false,
        "why": "It is about booting."
      },
      {
        "text": "So the share is read-only",
        "correct": false,
        "why": "That is readonly."
      },
      {
        "text": "So the host cannot unmount it",
        "correct": false,
        "why": "No."
      },
      {
        "text": "So the guest boots without the share",
        "correct": true,
        "why": "Right. No emergency prompt."
      }
    ]
  },
  {
