    "difficulty": "medium",
    "drillable": true,
    "prompt": "Inside the container, the shell said my pid is 1. What does that show?",
    "hint": "Its own view.",
    "choices": [
      {
        "text": "Its own view of processes",
        "correct": true,
        "why": "Right. A namespace."
      },
      {
        "text": "It is the host's first process",
        "correct": false,
        "why": "That is systemd on the host."
      },
      {
        "text": "It runs a kernel of its own",
        "correct": false,
        "why": "It shares the host's."
      },
      {
        "text": "It is a virtual machine",
        "correct": false,
        "why": "It is a container."
      }
    ]
  },
  {
    "id": "ex-zc228sdf",
    "version": 1,
    "section": "what-a-container-sees",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
