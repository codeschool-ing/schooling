    "hint": "It has none of its own.",
    "choices": [
      {
        "text": "vm1's, 6.8.0-139-generic",
        "correct": false,
        "why": "That is the virtual machine's own."
      },
      {
        "text": "The host's",
        "correct": true,
        "why": "Right. 6.18.44-fc-v37."
      },
      {
        "text": "One inside the ubuntu image",
        "correct": false,
        "why": "The image holds no kernel."
      },
      {
        "text": "None; it failed",
        "correct": false,
        "why": "It printed one."
      }
    ]
  },
  {
