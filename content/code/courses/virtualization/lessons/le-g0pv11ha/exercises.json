[
  {
    "id": "ex-j38cm2hx",
    "version": 1,
    "section": "drill",
    "type": "matching",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Match each word to what it names in this course's lab.",
    "hint": "Real computer, software computer, and what sits between.",
    "pairs": [
      {
        "left": "host",
        "right": "The real computer, running Ubuntu"
      },
      {
        "left": "guest",
        "right": "vm1, the computer made of software"
      },
      {
        "left": "hypervisor",
        "right": "QEMU, which makes the guest believe it has hardware"
      },
      {
        "left": "libvirt",
        "right": "The management layer that virsh talks to"
      }
    ],
    "right_distractors": [
      "The network card inside vm1"
    ]
  },
  {
    "id": "ex-estr34h6",
    "version": 1,
    "section": "a-computer-in-a-file",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "qemu-img made vm1.qcow2 with a size of 8G. How much of the host's disk did it take right away?",
    "hint": "qcow2 grows as it is written.",
    "choices": [
      {
        "text": "8 GiB, reserved at once",
        "correct": false,
        "why": "That is a raw, fully allocated disk, not this one."
      },
      {
        "text": "318M, a full copy of the base",
        "correct": false,
        "why": "An overlay copies nothing."
      },
      {
        "text": "Half of it, 4 GiB",
        "correct": false,
        "why": "There is no such rule."
      },
      {
        "text": "Almost nothing",
        "correct": true,
        "why": "Right. It grows only when the guest writes."
      }
    ]
  },
  {
    "id": "ex-srg2tgvs",
    "version": 1,
    "section": "a-computer-in-a-file",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does -b lab-base.qcow2 make the new disk?",
    "hint": "It starts from something without copying it.",
    "choices": [
      {
        "text": "An overlay on that base",
        "correct": true,
        "why": "Right. It holds only its own changes."
      },
      {
        "text": "A backup of the base, made in the background",
        "correct": false,
        "why": "Nothing is copied."
      },
      {
        "text": "A disk that can only be read",
        "correct": false,
        "why": "The guest writes to it all the time."
      },
      {
        "text": "A second disk the guest sees as vdb",
        "correct": false,
        "why": "vdb was the seed disk."
      }
    ]
  },
  {
    "id": "ex-b6batmpg",
    "version": 1,
    "section": "a-computer-in-a-file",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "vm1 writes a file to its disk. Which file on the host changes?",
    "hint": "The base is shared.",
    "choices": [
      {
        "text": "lab-base.qcow2 only",
        "correct": false,
        "why": "Then every guest on that base would see the change."
      },
      {
        "text": "vm1.qcow2 only",
        "correct": true,
        "why": "Right. The base is never written."
      },
      {
        "text": "Both, to keep them in step",
        "correct": false,
        "why": "The base is never written."
      },
      {
        "text": "Neither; it stays in memory",
        "correct": false,
        "why": "A disk write reaches a file."
      }
    ]
  },
  {
    "id": "ex-etc9xsar",
    "version": 1,
    "section": "a-computer-in-a-file",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does virt-install do?",
    "hint": "Memory, processors, disks, network.",
    "choices": [
      {
        "text": "Installs QEMU on the host",
        "correct": false,
        "why": "QEMU was already installed."
      },
      {
        "text": "Copies Ubuntu onto a USB stick",
        "correct": false,
        "why": "No stick is involved."
      },
      {
        "text": "Describes a guest to libvirt and starts it",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Lists the guests that are running",
        "correct": false,
        "why": "That is virsh list."
      }
    ]
  },
  {
    "id": "ex-47djj0j7",
    "version": 1,
    "section": "a-computer-in-a-file",
    "type": "cloze",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "The option that gave vm1 its 1 GiB: virt-install --______ 1024",
    "hint": "A word, in megabytes.",
    "blanks": [
      {
        "accept": [
          "memory"
        ],
        "ignore_case": true,
        "ignore_accents": true
      }
    ]
  },
  {
    "id": "ex-f69x2bfh",
    "version": 1,
    "section": "a-computer-in-a-file",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does this course's virt-install say --virt-type qemu?",
    "hint": "Where it was recorded.",
    "choices": [
      {
        "text": "It runs faster than kvm on every computer",
        "correct": false,
        "why": "It is slower."
      },
      {
        "text": "Ubuntu guests require it",
        "correct": false,
        "why": "They run under kvm too."
      },
      {
        "text": "libvirt refuses kvm for guests with only 1 GiB of memory",
        "correct": false,
        "why": "Memory has nothing to do with it."
      },
      {
        "text": "The recording computer passes no VT-x or AMD-V to it",
        "correct": true,
        "why": "Right. So the processor is imitated in software."
      }
    ]
  },
  {
    "id": "ex-yk1339m8",
    "version": 1,
    "section": "a-computer-in-a-file",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What was the second disk, vm1-seed.img, for?",
    "hint": "The first boot.",
    "choices": [
      {
        "text": "The guest's name and ana's login",
        "correct": true,
        "why": "Right. Read once, then removed."
      },
      {
        "text": "Extra space for the guest's files",
        "correct": false,
        "why": "It was 128K."
      },
      {
        "text": "A copy of the base disk",
        "correct": false,
        "why": "The overlay points at the base."
      },
      {
        "text": "The guest's swap",
        "correct": false,
        "why": "It carried configuration."
      }
    ]
  },
  {
    "id": "ex-e2p522ht",
    "version": 1,
    "section": "from-inside",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which command, run inside vm1, said it was a virtual machine?",
    "hint": "It answered qemu.",
    "choices": [
      {
        "text": "systemd-detect-virt",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "lsblk -d -o NAME,SIZE,TYPE",
        "correct": false,
        "why": "That lists disks."
      },
      {
        "text": "free -h",
        "correct": false,
        "why": "That only counts memory."
      },
      {
        "text": "ip -br addr",
        "correct": false,
        "why": "That listed addresses."
      }
    ]
  },
  {
    "id": "ex-gxjjhn7v",
    "version": 1,
    "section": "from-inside",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "vm1 was given 1024 MiB and free -h shows 961Mi total. Where did the rest go?",
    "hint": "Before free starts counting.",
    "choices": [
      {
        "text": "The host took it back",
        "correct": false,
        "why": "The guest was given the whole 1024."
      },
      {
        "text": "The kernel kept it for itself",
        "correct": true,
        "why": "Right. A real computer shows the same gap."
      },
      {
        "text": "QEMU rounds memory down to 961",
        "correct": false,
        "why": "There is no such rounding."
      },
      {
        "text": "It is the seed disk",
        "correct": false,
        "why": "A disk is not memory."
      }
    ]
  },
  {
    "id": "ex-xs2x1zk8",
    "version": 1,
    "section": "from-inside",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Inside vm1, lsblk shows vda, 8G. What is it on the host?",
    "hint": "A qcow2.",
    "choices": [
      {
        "text": "The file vm1.qcow2",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A partition of the host's disk",
        "correct": false,
        "why": "It is a file."
      },
      {
        "text": "The seed disk",
        "correct": false,
        "why": "That was vdb."
      },
      {
        "text": "A USB stick",
        "correct": false,
        "why": "No stick is involved."
      }
    ]
  },
  {
    "id": "ex-brpwc7zd",
    "version": 1,
    "section": "from-inside",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "lscpu inside vm1 shows Model name: QEMU Virtual CPU version 2.5+. What is that processor?",
    "hint": "No factory makes it.",
    "choices": [
      {
        "text": "The host's real processor",
        "correct": false,
        "why": "The host's has a maker's name."
      },
      {
        "text": "One that exists only in QEMU",
        "correct": true,
        "why": "Right. QEMU imitates it."
      },
      {
        "text": "An old Intel model from 2005",
        "correct": false,
        "why": "It is QEMU's own."
      },
      {
        "text": "A graphics card",
        "correct": false,
        "why": "lscpu lists processors."
      }
    ]
  },
  {
    "id": "ex-rtjmn58n",
    "version": 1,
    "section": "from-inside",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "The grep asked lscpu for Hypervisor vendor and got nothing, yet the guest is a VM. Why?",
    "hint": "It depends on what the processor says.",
    "choices": [
      {
        "text": "lscpu does not work inside guests",
        "correct": false,
        "why": "It printed the model and count."
      },
      {
        "text": "The grep pattern had a mistake in it and matched nothing",
        "correct": false,
        "why": "It matched two other lines fine."
      },
      {
        "text": "vm1 is not really virtual",
        "correct": false,
        "why": "systemd-detect-virt said qemu."
      },
      {
        "text": "QEMU's software processor gives no hypervisor name",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-g36b4225",
    "version": 1,
    "section": "from-inside",
    "type": "multiple-choice",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which of these work inside vm1 as on any Linux machine? Choose all that apply.",
