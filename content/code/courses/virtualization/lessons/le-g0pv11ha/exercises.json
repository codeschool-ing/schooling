      {
        "text": "Installing packages with apt",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Creating users",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Reading logs with journalctl",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Running virsh list to see itself",
        "correct": false,
        "why": "virsh runs on the host."
      }
    ]
  },
  {
    "id": "ex-zjzejq6s",
    "version": 1,
    "section": "from-outside",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "On the host, what is a running guest?",
    "hint": "ps found it.",
    "choices": [
      {
        "text": "A user account",
        "correct": false,
        "why": "ps lists processes."
      },
      {
        "text": "A partition",
        "correct": false,
        "why": "The disk is a file."
      },
      {
        "text": "A qemu-system-x86 process",
        "correct": true,
        "why": "Right. One process per guest."
      },
      {
        "text": "A kernel module",
        "correct": false,
        "why": "It is an ordinary process."
      }
    ]
  },
  {
    "id": "ex-a4n2reks",
    "version": 1,
    "section": "from-outside",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "On the host, what are vm1's two processors?",
    "hint": "Inside one process.",
    "choices": [
      {
        "text": "Two of the host's processors, reserved",
        "correct": false,
        "why": "Nothing is reserved; they share."
      },
      {
        "text": "Two extra chips QEMU adds",
        "correct": false,
        "why": "Software adds no chips."
      },
      {
        "text": "Separate virtual machines",
        "correct": false,
        "why": "They are one guest."
      },
      {
        "text": "Threads of the QEMU process",
        "correct": true,
        "why": "Right. The host schedules them."
      }
    ]
  },
  {
    "id": "ex-fxpy0669",
    "version": 1,
    "section": "from-outside",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "The guest has 1 GiB and the QEMU process's RSS is about 1.5 GiB. What explains the difference?",
    "hint": "Two things share the process.",
    "choices": [
      {
        "text": "The guest is using swap",
        "correct": false,
        "why": "Swap would be inside the guest's disk."
      },
      {
        "text": "ps counts every page twice",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "The base disk is loaded into memory",
        "correct": false,
        "why": "Disks are read in blocks, as needed."
      },
      {
        "text": "QEMU's own memory, besides the guest's",
        "correct": true,
        "why": "Right. Lesson 8 measures it."
      }
    ]
  },
