  {
    "id": "ex-fb2mxn8w",
    "version": 1,
    "section": "switch-off-break-discard",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "When is virsh destroy the right choice for a guest?",
    "hint": "It is pulling the plug.",
    "choices": [
      {
        "text": "Every evening at the end of the day, to save time",
        "correct": false,
        "why": "A guest with open files can lose data."
      },
      {
        "text": "Before taking a backup copy of its disk file",
        "correct": false,
        "why": "Shut it down cleanly for that."
      },
      {
        "text": "To delete its disk file",
        "correct": false,
        "why": "destroy stops it; rm deletes the file."
      },
      {
        "text": "When it is about to be deleted anyway",
        "correct": true,
        "why": "Right. Or when it no longer answers shutdown."
      }
    ]
  },
