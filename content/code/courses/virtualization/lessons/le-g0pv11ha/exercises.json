  {
    "id": "ex-2h9p8vr4",
    "version": 1,
    "section": "switch-off-break-discard",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How does virsh shutdown switch a guest off?",
    "hint": "Like a short press of a power button.",
    "choices": [
      {
        "text": "It kills the QEMU process straight away",
        "correct": false,
        "why": "That is destroy."
      },
      {
        "text": "Ubuntu inside is asked and powers off",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It deletes the guest",
        "correct": false,
        "why": "The guest came back with start."
      },
      {
        "text": "It pauses the guest where it is, in memory",
        "correct": false,
        "why": "It showed shut off, with no process."
      }
    ]
