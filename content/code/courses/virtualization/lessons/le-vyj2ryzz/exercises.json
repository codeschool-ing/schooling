        "correct": true,
        "why": "Right."
      },
      {
        "text": "The server stops in 30 days",
        "correct": false,
        "why": "There is no such limit."
      },
      {
        "text": "Only one guest may run",
        "correct": false,
        "why": "There is no such limit."
      },
      {
        "text": "Backups are switched off until a subscription is bought",
        "correct": false,
        "why": "They work without one."
      }
    ]
  },
