  {
    "id": "ex-hcaxpyjn",
    "version": 1,
    "section": "running-guests",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What is the danger if two nodes each start the same guest on one shared disk?",
    "hint": "Two writers.",
    "choices": [
      {
        "text": "The guest runs twice as fast",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Nothing; they take turns",
        "correct": false,
        "why": "They do not know about each other."
      },
      {
        "text": "The second one gets a new MAC and it is fine",
        "correct": false,
        "why": "The disk is the problem."
      },
      {
        "text": "The disk is destroyed",
        "correct": true,
        "why": "Right. Two systems write over each other."
      }
    ]
  },
