  {
    "id": "ex-h8g7tw6z",
    "version": 1,
    "section": "the-bridge",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is plugged into Proxmox's vmbr0 after installation?",
    "hint": "A real card.",
    "choices": [
      {
        "text": "The server's real network card",
        "correct": true,
        "why": "Right. Guests land on the office network."
      },
      {
        "text": "Nothing at all; it is an isolated bridge",
        "correct": false,
        "why": "That would be a different bridge."
      },
      {
        "text": "A NAT router, like virbr0",
        "correct": false,
        "why": "virbr0 is libvirt's; vmbr0 is joined to the card."
      },
      {
        "text": "The storage",
        "correct": false,
        "why": "Storage is not a network port."
      }
    ]
  },
