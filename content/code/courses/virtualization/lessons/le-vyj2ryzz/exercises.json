        "text": "So a majority decides who is really down",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The licence requires it",
        "correct": false,
        "why": "It is technical."
      },
      {
        "text": "Two nodes cannot share storage",
        "correct": false,
        "why": "They can."
      }
