    "section": "what-proxmox-is",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is Proxmox VE?",
    "hint": "Installed from its own ISO.",
    "choices": [
      {
        "text": "An app you install on Windows",
        "correct": false,
        "why": "It takes over a whole server."
      },
      {
        "text": "A cloud service you rent by the hour",
        "correct": false,
        "why": "It runs on your own server."
      },
      {
        "text": "A disk format for carrying machines between hosts",
        "correct": false,
        "why": "It is a whole system."
      },
      {
        "text": "A Linux distribution that is a hypervisor",
        "correct": true,
        "why": "Right. Debian underneath."
      }
    ]
  },
