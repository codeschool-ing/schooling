  {
    "id": "ex-sfpmcby0",
    "version": 1,
    "section": "keeping-the-rule",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What happens to a rule loaded with nft -f when the host restarts?",
    "hint": "It lives in memory.",
    "choices": [
      {
        "text": "It is gone, and has to be loaded again",
        "correct": true,
        "why": "Right. At boot, by a service of its own."
      },
      {
        "text": "It is saved automatically",
        "correct": false,
        "why": "Nothing saved it."
      },
      {
        "text": "It moves into libvirt",
        "correct": false,
        "why": "No."
      },
      {
        "text": "It applies to every network",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-vaanbpyh",
    "version": 1,
    "section": "keeping-the-rule",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why not paste the lab's rule into /etc/nftables.conf?",
    "hint": "Its third line.",
    "choices": [
      {
        "text": "Ubuntu never reads that file",
        "correct": false,
        "why": "It loads it at boot."
      },
      {
        "text": "Its flush ruleset would clear libvirt's rules",
        "correct": true,
        "why": "Right. On the day it is reloaded."
      },
      {
        "text": "The file only accepts IPv4 rules, and labguard is inet",
        "correct": false,
        "why": "It holds inet tables."
      },
      {
        "text": "nft cannot read two tables from one file",
        "correct": false,
        "why": "It can."
      }
    ]
  },
