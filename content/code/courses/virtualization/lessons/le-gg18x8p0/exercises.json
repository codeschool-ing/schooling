[
  {
    "id": "ex-s950awrt",
    "version": 1,
    "section": "what-isolated-leaves-open",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why did ip route get 10.0.0.50 on the client answer Network is unreachable?",
    "hint": "Read ip route above it.",
    "choices": [
      {
        "text": "The printer was switched off",
        "correct": false,
        "why": "host reached it through lan0."
      },
      {
        "text": "The host dropped the packet",
        "correct": false,
        "why": "No packet left the guest."
      },
      {
        "text": "10.0.0.50 is not a valid address",
        "correct": false,
        "why": "It is the office printer."
      },
      {
        "text": "The client has no default via line",
        "correct": true,
        "why": "Right. It knows only its own network."
      }
    ]
  },
  {
    "id": "ex-20d7hbes",
    "version": 1,
    "section": "what-isolated-leaves-open",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "From the client, before any rule, what on the host answered? Choose all that apply.",
    "hint": "Section 02's holes.",
    "choices": [
      {
        "text": "Its ssh server, port 22",
        "correct": true,
        "why": "Right. Connection succeeded."
      },
      {
        "text": "The notes server, port 8000",
        "correct": true,
        "why": "Right. The toner note."
      },
      {
        "text": "The office printer",
        "correct": false,
        "why": "No route to it."
      },
      {
        "text": "Nothing at all",
        "correct": false,
        "why": "Two things did."
      }
    ]
  },
  {
    "id": "ex-g5bf8m97",
    "version": 1,
    "section": "what-isolated-leaves-open",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did the notes server answer on 10.20.0.1, the lab's side of the host?",
    "hint": "ss -tln.",
    "choices": [
      {
        "text": "It was configured for labnet",
        "correct": false,
        "why": "Nobody named labnet."
      },
      {
        "text": "libvirt forwards port 8000",
        "correct": false,
        "why": "No forwarding was set."
      },
      {
        "text": "It listens on 0.0.0.0, every address",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The client shares its folder",
        "correct": false,
        "why": "The folder is on the host."
      }
    ]
  },
  {
    "id": "ex-grytxtx5",
    "version": 1,
    "section": "what-isolated-leaves-open",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "An isolated network is isolated from what?",
    "hint": "Lesson 11 found DNS.",
    "choices": [
      {
        "text": "The host, not the real network",
        "correct": false,
        "why": "The other way round."
      },
      {
        "text": "Both the host and the real network",
        "correct": false,
        "why": "The host answered."
      },
      {
        "text": "The real network, not the host",
        "correct": true,
        "why": "Right. The host has an address on it."
      },
      {
        "text": "The other guests on it",
        "correct": false,
        "why": "client reached server."
      }
    ]
  },
  {
    "id": "ex-cpf1nq38",
    "version": 1,
    "section": "a-check-from-inside",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "In check.sh, when does a line print OPEN?",
    "hint": "The check function.",
    "choices": [
      {
        "text": "When its command prints something",
        "correct": false,
        "why": "Output is thrown away."
      },
      {
        "text": "When its command succeeds",
        "correct": true,
        "why": "Right. Success means the door is open."
      },
      {
        "text": "When the host asks for it",
        "correct": false,
        "why": "It runs in the guest."
      },
      {
        "text": "When the check takes over three seconds",
        "correct": false,
        "why": "Time is not tested."
      }
    ]
  },
  {
    "id": "ex-m47ymdpr",
    "version": 1,
    "section": "a-check-from-inside",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does nc -z do?",
    "hint": "Knocks.",
    "choices": [
      {
        "text": "Sends a file to the other end of the connection",
        "correct": false,
        "why": "It sends nothing."
      },
      {
        "text": "Opens a port on the host for others to use",
        "correct": false,
        "why": "It only tries one."
      },
      {
        "text": "Lists every open port",
        "correct": false,
        "why": "It tries the one named."
      },
      {
        "text": "Connects and hangs up at once",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-fvbha1dz",
    "version": 1,
    "section": "a-check-from-inside",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does the shared-folder check read /proc/mounts rather than use findmnt -t 9p,virtiofs?",
    "hint": "What does findmnt answer when it finds nothing?",
    "choices": [
      {
        "text": "findmnt is not installed in the guest",
        "correct": false,
        "why": "It is part of util-linux."
      },
      {
        "text": "findmnt needs root",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "findmnt succeeds even when it finds nothing",
        "correct": true,
        "why": "Right. Every guest would say OPEN."
      },
      {
        "text": "/proc/mounts is faster",
        "correct": false,
        "why": "Not the reason."
      }
    ]
  },
  {
