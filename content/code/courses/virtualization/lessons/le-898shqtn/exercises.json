  {
    "id": "ex-h60v4wke",
    "version": 1,
    "section": "the-driver",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which type of hypervisor is VirtualBox?",
    "hint": "It is installed like a program.",
    "choices": [
      {
        "text": "Type 1, bare metal",
        "correct": false,
        "why": "The computer does not boot into it."
      },
      {
        "text": "Type 2",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A container runtime that shares the host's kernel",
        "correct": false,
        "why": "Its guests have their own kernels."
      },
      {
        "text": "A firmware setting",
        "correct": false,
        "why": "It is an application."
      }
    ]
  },
  {
    "id": "ex-w7g0zap2",
    "version": 1,
    "section": "the-driver",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does VirtualBox install a driver in the host's kernel?",
    "hint": "An application cannot reach them alone.",
    "choices": [
      {
        "text": "To draw its window on the host's screen",
        "correct": false,
        "why": "Windows are drawn like any application's."
      },
      {
        "text": "To reach the processor's VT-x or AMD-V",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "To check the licence of the Extension Pack",
        "correct": false,
        "why": "Licences are not checked in the kernel."
      },
      {
        "text": "To read ISO files",
        "correct": false,
        "why": "Files are read the ordinary way."
      }
    ]
  },
