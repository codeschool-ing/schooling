  {
    "id": "ex-725ycgvc",
    "version": 1,
    "section": "the-default-nat",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What do the MASQUERADE lines in the host's firewall do?",
    "hint": "The whole trick.",
    "choices": [
      {
        "text": "Block everything from the guests",
        "correct": false,
        "why": "The guest reached the printer."
      },
      {
        "text": "Send guest traffic out as the host",
        "correct": true,
        "why": "Right. That is NAT."
      },
      {
        "text": "Give the guests their addresses",
        "correct": false,
        "why": "That is DHCP."
      },
      {
        "text": "Hide the host from the guests",
        "correct": false,
        "why": "The host is their router."
      }
    ]
  },
