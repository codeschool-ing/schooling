  {
    "id": "ex-m9gmk9ht",
    "version": 1,
    "section": "the-default-nat",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which line of the default network's XML makes it NAT?",
    "hint": "Where traffic goes.",
    "choices": [
      {
        "text": "<bridge name='virbr0' …/>",
        "correct": false,
        "why": "That names the switch."
      },
      {
        "text": "<range start=… end=…/>",
        "correct": false,
        "why": "That is DHCP."
      },
      {
        "text": "<ip address='192.168.122.1' …>",
        "correct": false,
        "why": "That is the host's address."
      },
      {
        "text": "<forward mode='nat'>",
        "correct": true,
        "why": "Right."
      }
    ]
  },
