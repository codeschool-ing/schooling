  {
    "id": "ex-pmv71e09",
    "version": 1,
    "section": "the-files",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which file do you open in Workstation to add an existing machine?",
    "hint": "The settings.",
    "choices": [
      {
        "text": "The .vmdk",
        "correct": false,
        "why": "That is only the disk."
      },
      {
        "text": "The .vmem file of a suspended guest",
        "correct": false,
        "why": "That is memory."
      },
      {
        "text": "The .vmx",
        "correct": true,
        "why": "Right. Or an .ova."
      },
      {
        "text": "vmware.log",
        "correct": false,
        "why": "That is a log."
      }
    ]
  },
  {
    "id": "ex-m82msb5c",
    "version": 1,
    "section": "the-files",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Ana copies a Workstation machine to a second PC while the original keeps running. What should she answer when asked moved or copied?",
    "hint": "Two of them will be on the network.",
    "choices": [
      {
        "text": "Moved",
        "correct": false,
        "why": "Then both would share one MAC."
      },
      {
        "text": "Either; nothing changes",
        "correct": false,
        "why": "The identity and MAC change."
      },
      {
        "text": "Cancel, and copy only the .vmdk instead",
        "correct": false,
        "why": "The settings would be lost."
      },
      {
        "text": "Copied",
        "correct": true,
        "why": "Right. A new identity and a new MAC."
      }
    ]
  },
  {
    "id": "ex-md8k9aaz",
    "version": 1,
    "section": "the-files",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why copy a Workstation machine switched off rather than suspended?",
    "hint": "What a suspended guest leaves behind.",
    "choices": [
      {
        "text": "Suspended machines cannot be copied at all",
        "correct": false,
        "why": "They can, with more baggage."
      },
      {
        "text": "Switched off makes the disk smaller",
        "correct": false,
        "why": "The disk is the same."
      },
      {
        "text": "It is a licence rule",
        "correct": false,
        "why": "It is technical."
      },
      {
        "text": "A suspended one carries its memory state",
        "correct": true,
        "why": "Right. .vmem and .vmss, tied to that host."
      }
    ]
  },
