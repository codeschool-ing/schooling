  {
    "id": "ex-d0mms027",
    "version": 1,
    "section": "the-products",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Ana is asked to install VMware Workstation on a company's computers. What should she do first?",
    "hint": "The terms have moved.",
    "choices": [
      {
        "text": "Install Player, which is always free for companies",
        "correct": false,
        "why": "Player was discontinued."
      },
      {
        "text": "Copy an installer from her own laptop",
        "correct": false,
        "why": "That does not settle the licence."
      },
      {
        "text": "Nothing; licences do not apply to hypervisors",
        "correct": false,
        "why": "They do."
      },
      {
        "text": "Check the vendor's current terms",
        "correct": true,
        "why": "Right. A licence is a legal question."
      }
    ]
  },
  {
