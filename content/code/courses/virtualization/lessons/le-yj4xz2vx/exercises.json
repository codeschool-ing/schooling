  {
    "id": "ex-3w66tn2d",
    "version": 1,
    "section": "virtual-processors",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Ten guests with two vCPUs each start on a host with four processors. What happens?",
    "hint": "A promise of turns.",
    "choices": [
      {
        "text": "Only two of them start; the rest wait",
        "correct": false,
        "why": "vCPUs are not reserved."
      },
      {
        "text": "The host adds processors to cope",
        "correct": false,
        "why": "It cannot."
      },
      {
        "text": "All start; they take turns",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Each guest sees half a processor",
        "correct": false,
        "why": "Each sees two."
      }
    ]
  },
  {
    "id": "ex-jwh77q3j",
    "version": 1,
    "section": "virtual-processors",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A guest has eight busy threads on a host with four processors. Why can eight vCPUs be slower than four?",
    "hint": "Only four run at once.",
    "choices": [
      {
        "text": "Eight vCPUs is above a licence limit for guests",
        "correct": false,
        "why": "No licence involved."
      },
      {
        "text": "The guest cannot count past four",
        "correct": false,
        "why": "It counts eight."
      },
      {
        "text": "Memory is split eight ways",
        "correct": false,
        "why": "Memory is not split per vCPU."
      },
      {
        "text": "The vCPUs wait on each other for turns",
        "correct": true,
        "why": "Right."
      }
    ]
  },
