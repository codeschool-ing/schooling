[
  {
    "id": "ex-e0qj4h95",
    "version": 1,
    "section": "virtual-processors",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "On the host, what is a vCPU?",
    "hint": "vcpuinfo.",
    "choices": [
      {
        "text": "A thread the scheduler runs in turn",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A real processor set aside for the guest",
        "correct": false,
        "why": "Nothing is set aside."
      },
      {
        "text": "A chip that QEMU adds to the host board",
        "correct": false,
        "why": "Software adds no chips."
      },
      {
        "text": "A licence for one core",
        "correct": false,
        "why": "Unrelated."
      }
    ]
  },
  {
    "id": "ex-ytgmms2d",
    "version": 1,
    "section": "virtual-processors",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "vcpuinfo shows CPU Affinity: yyyy. What does it mean on a host with four processors?",
    "hint": "One letter per host processor.",
    "choices": [
      {
        "text": "The vCPU is pinned to processor 0",
        "correct": false,
        "why": "yyyy allows all four."
      },
      {
        "text": "The guest has four vCPUs",
        "correct": false,
        "why": "It had two."
      },
      {
        "text": "Hyper-threading is on",
        "correct": false,
        "why": "Unrelated."
      },
      {
        "text": "It runs on any of the four",
        "correct": true,
        "why": "Right."
      }
    ]
  },
