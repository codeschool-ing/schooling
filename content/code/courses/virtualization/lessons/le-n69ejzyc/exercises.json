      {
        "text": "Through the guest agent",
        "correct": true,
        "why": "Right. It needs no network."
      },
      {
        "text": "From the DHCP leases",
        "correct": false,
        "why": "vm2 never asked for one."
      },
      {
        "text": "From the disk file's name",
        "correct": false,
        "why": "That says vm2."
      }
    ]
  },
