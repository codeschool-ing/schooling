[
  {
    "id": "ex-0s5xng7r",
    "version": 1,
    "section": "a-full-clone",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is a clone?",
    "hint": "A copy.",
    "choices": [
      {
        "text": "A snapshot",
        "correct": false,
        "why": "A snapshot is a state of the same machine."
      },
      {
        "text": "A backup kept on another server",
        "correct": false,
        "why": "A clone is a machine that runs."
      },
      {
        "text": "A new VM copied from another",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A second name for the same VM",
        "correct": false,
        "why": "It is a separate machine."
      }
    ]
  },
  {
    "id": "ex-0v4tgm0e",
    "version": 1,
    "section": "a-full-clone",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "vm1's disk was a 27M overlay and vm2's full clone is 804M. Why?",
    "hint": "Everything the guest can read.",
    "choices": [
      {
        "text": "virt-clone adds 777M of padding to every clone it makes",
        "correct": false,
        "why": "Nothing is padded."
      },
      {
        "text": "It copied the base underneath too",
        "correct": true,
        "why": "Right. It is independent."
      },
      {
        "text": "vm2 had already been used",
        "correct": false,
        "why": "It had not started yet."
      },
      {
        "text": "It holds memory",
        "correct": false,
        "why": "vm1 was switched off."
      }
    ]
  },
  {
