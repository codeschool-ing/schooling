  },
  {
    "id": "ex-gntvvsd4",
    "version": 1,
    "section": "a-full-clone",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "When is it right to keep the original's MAC addresses on a clone?",
    "hint": "Two cards, one MAC, one network.",
    "choices": [
      {
        "text": "Always; MACs do not matter",
        "correct": false,
        "why": "They would fight over every packet."
      },
      {
        "text": "When the clone is linked",
        "correct": false,
        "why": "Linked or full, the network is the same."
      },
      {
        "text": "When the host has two network cards",
        "correct": false,
        "why": "Unrelated."
      },
      {
        "text": "Never side by side",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-3w1vvkqx",
    "version": 1,
    "section": "a-full-clone",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why was vm1 switched off before cloning?",
    "hint": "A disk that is changing.",
    "choices": [
      {
