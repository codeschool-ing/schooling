  {
    "id": "ex-nde61nze",
    "version": 1,
    "section": "five-ways",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why did `typo` fail to start?",
    "hint": "Read the image name closely.",
    "choices": [
      {
        "text": "Docker Hub was down",
        "correct": false,
        "why": "The lab's nodes reach no registry; the name was also wrong."
      },
      {
        "text": "The tag `1.O` has a letter O",
        "correct": true,
        "why": "Right. No image with that tag was on the node."
      },
      {
        "text": "The node ran out of disk",
        "correct": false,
        "why": "The events say nothing about disk."
      },
      {
        "text": "The pod had no CPU request",
        "correct": false,
        "why": "Requests do not affect pulling."
      }
    ]
  },
  {
    "id": "ex-msd5dq50",
    "version": 1,
    "section": "five-ways",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A pod restarts and its current container has written nothing yet. How do you read why the last one died?",
    "hint": "A flag of `kubectl logs`.",
    "choices": [
      {
        "text": "`kubectl describe node`",
        "correct": false,
        "why": "The node knows nothing of the process's output."
      },
      {
        "text": "`kubectl get events`",
        "correct": false,
        "why": "Events say it restarted, not what it printed."
      },
      {
        "text": "`kubectl logs --previous`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`kubectl exec` into it",
        "correct": false,
        "why": "The previous container is gone."
      }
    ]
  },
  {
    "id": "ex-3tawqeqb",
    "version": 1,
    "section": "reading-each",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`greedy` is `Pending`. Why are there no kubelet events and no logs for it?",
    "hint": "Which component has seen it?",
    "choices": [
      {
        "text": "Logging is off for Pending pods",
        "correct": false,
        "why": "There is simply nothing to log."
      },
      {
        "text": "No node was assigned, so no kubelet saw it",
        "correct": true,
        "why": "Right. Only the scheduler has spoken."
      },
      {
        "text": "Its events expired",
        "correct": false,
        "why": "Events last an hour."
      },
      {
        "text": "The pod has no name yet",
        "correct": false,
        "why": "It has a name; it has no node."
      }
    ]
  },
  {
    "id": "ex-mjx6a6gh",
    "version": 1,
    "section": "reading-each",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`unconfigured` waited until the ConfigMap was created. What happened then?",
    "hint": "Its status a few seconds later.",
    "choices": [
      {
        "text": "It had to be deleted and recreated",
        "correct": false,
        "why": "It started on its own."
      },
      {
        "text": "Nothing until the next deploy",
        "correct": false,
        "why": "No deploy happened."
      },
      {
        "text": "It started with an empty greeting",
        "correct": false,
        "why": "The value existed by then."
      },
      {
        "text": "The kubelet started it",
        "correct": true,
        "why": "Right: `1/1 Running`."
      }
    ]
  },
  {
    "id": "ex-b8kwfy5d",
    "version": 1,
    "section": "reading-each",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "`never-ready` is `Running` but never ready, and its logs are empty. Why empty?",
    "hint": "Where did the probe's connection go?",
    "choices": [
      {
        "text": "The shop does not log",
        "correct": false,
        "why": "It logs every request it receives."
      },
      {
        "text": "Logs are hidden until it is ready",
        "correct": false,
        "why": "Logs never wait for readiness."
      },
      {
        "text": "The probe never reached it",
        "correct": true,
        "why": "Right: port 9090 refused the connection."
      },
      {
        "text": "The kubelet deletes probe logs",
        "correct": false,
        "why": "Nothing deletes them."
      }
    ]
  },
