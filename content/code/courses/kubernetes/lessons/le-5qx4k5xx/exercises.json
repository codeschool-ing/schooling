[
  {
    "id": "ex-matej94a",
    "version": 1,
    "section": "base-overlays",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which file makes the shop that customers use run three copies instead of one?",
    "hint": "The base runs one.",
    "choices": [
      {
        "text": "`base/deployment.yaml`",
        "correct": false,
        "why": "The base says 1."
      },
      {
        "text": "`base/kustomization.yaml`",
        "correct": false,
        "why": "It lists resources and the generator."
      },
      {
        "text": "`overlays/production/replicas.yaml`",
        "correct": true,
        "why": "Right, a patch merged over the base."
      },
      {
        "text": "`overlays/staging/kustomization.yaml`",
        "correct": false,
        "why": "That is staging."
      }
    ]
