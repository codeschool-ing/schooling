  {
    "id": "ex-psz4fg00",
    "version": 1,
    "section": "erasure",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Loki answered the delete request with `204` and listed it as `received`. When are the lines gone?",
    "hint": "Who rewrites chunks?",
    "choices": [
      {
        "text": "Immediately, as the 204 says",
        "correct": false,
        "why": "204 means accepted, not done."
      },
      {
        "text": "After the compactor processes it",
        "correct": true,
        "why": "Right, following a grace period."
      },
      {
        "text": "At the next restart of Loki",
        "correct": false,
        "why": "Restarts do not process deletes."
      },
      {
        "text": "Never: Loki cannot delete",
        "correct": false,
        "why": "It can, through the compactor."
      }
    ]
  },
