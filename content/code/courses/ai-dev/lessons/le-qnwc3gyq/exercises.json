    "choices": [
      {
        "text": "The three SDKs share a tokenizer",
        "correct": false,
        "why": "Each SDK sends text; none counts it."
      },
      {
        "text": "Every provider uses o200k_base",
        "correct": false,
        "why": "Each real provider has its own tokenizer."
      },
      {
        "text": "labllm counted all three",
        "correct": true,
        "why": "Right: real providers would give three different numbers."
      },
      {
        "text": "The question was too short to differ",
        "correct": false,
        "why": "Short texts differ between tokenizers too."
      }
    ]
  },
  {
    "id": "ex-npfg1r43",
    "version": 1,
    "section": "three-shapes",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Code moves from the OpenAI SDK to Anthropic's and forgets the reply limit. What happens?",
