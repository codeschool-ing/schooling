    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What should a client do with `retry-after: 60`?",
    "hint": "The number is in seconds.",
    "choices": [
      {
        "text": "Retry at once, then back off a little more each time",
        "correct": false,
        "why": "Sooner only collects another 429."
      },
      {
        "text": "Wait 60 seconds before the next try",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Switch to a new key",
        "correct": false,
        "why": "That spreads one burst over two limits, and keys are per application."
      },
      {
        "text": "Give up for the day",
        "correct": false,
        "why": "The limit is per minute."
      }
    ]
  },
  {
    "id": "ex-97qb9tyn",
