        "correct": false,
        "why": "There is no default to fall back to."
      },
      {
        "text": "Nothing changes",
        "correct": false,
        "why": "The request is refused."
      },
      {
        "text": "The reply has no limit",
        "correct": false,
        "why": "The request never runs."
      }
    ]
  },
