  {
    "id": "ex-j05896sm",
    "version": 1,
    "section": "retries",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why do the waits between retries carry a random part?",
    "hint": "Think of many clients failing at once.",
    "choices": [
      {
        "text": "To make tests harder",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Because the server's clock drifts",
        "correct": false,
        "why": "The client chooses the wait."
      },
      {
        "text": "To spread retries out",
        "correct": true,
        "why": "Right: clients that failed together do not retry together. That is jitter."
      },
      {
        "text": "To save tokens",
        "correct": false,
        "why": "A wait costs no tokens."
      }
    ]
  },
