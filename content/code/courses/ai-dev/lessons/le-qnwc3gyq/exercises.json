  {
    "id": "ex-xqvtfyyk",
    "version": 1,
    "section": "keys",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A `.env` with a real key was committed last week and deleted today. What fixes it?",
    "hint": "Where is the file now?",
    "choices": [
      {
        "text": "Deleting it was enough",
        "correct": false,
        "why": "It is still in the history."
      },
      {
        "text": "Rewriting the last commit",
        "correct": false,
        "why": "The key was in an earlier one, already pushed."
      },
      {
        "text": "Revoking the key and issuing a new one",
        "correct": true,
        "why": "Right: the old key must stop working."
      },
      {
        "text": "Making the repository private",
        "correct": false,
        "why": "Copies made before stay copies."
      }
    ]
  },
  {
