  {
    "id": "ex-qzdfgk6g",
    "version": 1,
    "section": "functions-and-main",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `if __name__ == \"__main__\":` change?",
    "hint": "Run or import?",
    "choices": [
      {
        "text": "No `main()` on import",
        "correct": true,
        "why": "Right: `main()` runs only when the file is run."
      },
      {
        "text": "It makes the script faster",
        "correct": false,
        "why": "Not that."
      },
      {
        "text": "It is required by `argparse`",
        "correct": false,
        "why": "`argparse` works anywhere."
      },
      {
        "text": "It hides the functions from other files",
        "correct": false,
        "why": "They stay importable."
      }
    ]
  },
