    "section": "text-is-a-type",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "In pandas 3, what is `trips[\"plan\"].dtype == object`?",
    "hint": "Text has its own type now.",
    "choices": [
      {
        "text": "`False`",
        "correct": true,
        "why": "Right: the dtype is `str`."
      },
      {
        "text": "`True`",
        "correct": false,
        "why": "That was pandas 2."
      },
      {
        "text": "An error: dtypes cannot be compared",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "A Series of booleans, one per row",
        "correct": false,
        "why": "A dtype compared gives one answer."
      }
    ]
  },
  {
