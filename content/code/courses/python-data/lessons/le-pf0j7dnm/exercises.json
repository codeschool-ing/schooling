  {
    "id": "ex-2ra6sqes",
    "version": 1,
    "section": "dates",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why give `format=` to `pd.to_datetime`?",
    "hint": "What does `03/04/2025` mean?",
    "choices": [
      {
        "text": "Without it, pandas cannot convert text to dates",
        "correct": false,
        "why": "It can; it infers."
      },
      {
        "text": "It makes the result a string again",
        "correct": false,
        "why": "The result is a datetime."
      },
      {
        "text": "So `03/04/2025` means the day you intend, not a guessed one",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It is required for columns with missing values",
        "correct": false,
        "why": "Missing values become NaT either way."
      }
    ]
  },
  {
    "id": "ex-f1e2jsbw",
    "version": 1,
    "section": "dates",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "You want every trip on the 5th of March. Which condition misses most of them?",
    "hint": "A date written alone means midnight.",
    "choices": [
      {
        "text": "`(start >= \"2025-03-05\") & (start < \"2025-03-06\")`",
        "correct": false,
        "why": "That is the whole day."
      },
      {
        "text": "`(start >= \"2025-03-05\") & (start <= \"2025-03-05\")`",
        "correct": true,
        "why": "Right: it keeps only trips at exactly midnight."
      },
      {
        "text": "`start.dt.date == pd.Timestamp(\"2025-03-05\").date()`",
        "correct": false,
        "why": "That compares whole dates and works."
      },
      {
        "text": "`start.dt.strftime(\"%Y-%m-%d\") == \"2025-03-05\"`",
        "correct": false,
        "why": "Slow, but it works."
      }
    ]
  },
