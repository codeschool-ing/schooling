  {
    "id": "ex-k71apks4",
    "version": 1,
    "section": "text-is-a-type",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`[\" Annual\", \"annual\", \"ANNUAL \", \"day\"]` has four distinct values. What reduces it to two?",
    "hint": "Spaces and capitals.",
    "choices": [
      {
        "text": "`.str.lower()` alone",
        "correct": false,
        "why": "The spaces still differ."
      },
      {
        "text": "`.astype(\"category\")`",
        "correct": false,
        "why": "Categories keep every distinct spelling."
      },
      {
        "text": "`.str.strip()` alone",
        "correct": false,
        "why": "The capitals still differ."
      },
      {
        "text": "`.str.strip().str.lower()`",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-685nhcjn",
    "version": 1,
    "section": "numbers-from-text",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why use `pd.to_numeric(report, errors=\"coerce\")` rather than `report.astype(int)` on text you have not checked?",
    "hint": "One stops at the first problem.",
    "choices": [
      {
        "text": "Because it is faster",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "It shows every failure at once, as `NaN`",
        "correct": true,
        "why": "Right: then you list them."
      },
      {
        "text": "Because it fixes typos like `1O`",
        "correct": false,
        "why": "It turns them into NaN; a person fixes them."
      },
      {
        "text": "Because `astype(int)` rounds",
        "correct": false,
        "why": "It fails on text."
      }
    ]
  },
  {
    "id": "ex-xdtjrsxh",
    "version": 1,
    "section": "numbers-from-text",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "After coercing, `1O` became `NaN`. What should happen next?",
    "hint": "It may have a right answer.",
    "choices": [
      {
        "text": "Drop the row: it is missing",
        "correct": false,
        "why": "It is a typo with a likely value, not a missing reading."
      },
      {
        "text": "Fill it with the column mean",
        "correct": false,
        "why": "That invents a value."
      },
      {
        "text": "Look at it and decide",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Nothing: coercing was the fix",
        "correct": false,
        "why": "Coercing lists problems; it does not fix them."
      }
    ]
  },
