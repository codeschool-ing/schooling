  {
    "id": "ex-cb94cqqr",
    "version": 1,
    "section": "loc",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which line selects the rain of the days with more than 20 mm and more than 31 degrees?",
    "hint": "Each condition in parentheses, `&` between.",
    "choices": [
      {
        "text": "`weather.loc[(weather[\"rain_mm\"] > 20) & (weather[\"temp_max\"] > 31), \"rain_mm\"]`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`weather.loc[weather[\"rain_mm\"] > 20 and weather[\"temp_max\"] > 31, \"rain_mm\"]`",
        "correct": false,
        "why": "`and` on Series raises the ambiguity error."
      },
      {
        "text": "`weather.iloc[(weather[\"rain_mm\"] > 20) & (weather[\"temp_max\"] > 31), \"rain_mm\"]`",
        "correct": false,
        "why": "`iloc` takes positions, not a column name."
      },
      {
        "text": "`weather[\"rain_mm\"].loc[20:31]`",
        "correct": false,
        "why": "That slices labels, not values."
      }
    ]
  },
