    "prompt": "What does a pandas Series add to a NumPy array?",
    "hint": "Something on the left of every value.",
    "choices": [
      {
        "text": "Support for missing values, which NumPy lacks",
        "correct": false,
        "why": "NumPy has `nan` too."
      },
      {
        "text": "An index labelling every element",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A second dtype for every value",
        "correct": false,
        "why": "A Series has one dtype."
      },
      {
        "text": "Faster arithmetic",
        "correct": false,
        "why": "The arithmetic is NumPy's underneath."
      }
    ]
  },
  {
