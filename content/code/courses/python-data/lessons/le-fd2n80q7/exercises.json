  {
    "id": "ex-tkxppy9f",
    "version": 1,
    "section": "lists-of-positions",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`dates[np.array([0, 90, 0])]` gives what?",
    "hint": "Order and repeats are kept.",
    "choices": [
      {
        "text": "Two dates, since repeats are dropped",
        "correct": false,
        "why": "Repeats are allowed."
      },
      {
        "text": "An error: positions must increase",
        "correct": false,
        "why": "Any order is allowed."
      },
      {
        "text": "The dates from position 0 to position 90",
        "correct": false,
        "why": "That is a slice, `dates[0:91]`."
      },
      {
        "text": "Three dates: day 0, day 90, day 0 again",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-0gj8t9kq",
    "version": 1,
    "section": "lists-of-positions",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "`weeks[[0, 51], [3, 4]]` returns two numbers, not a 2 × 2 table. Why?",
    "hint": "The lists pair up.",
    "choices": [
      {
        "text": "The lists pair up: (0, 3), (51, 4)",
        "correct": true,
        "why": "Right; `np.ix_` builds the rectangle."
      },
      {
        "text": "Lists of positions only work on one axis at a time",
        "correct": false,
        "why": "They work on several, paired."
      },
      {
        "text": "Because the result is a view, which cannot be 2 × 2",
        "correct": false,
        "why": "It is a copy, and copies can be any shape."
      },
      {
        "text": "NumPy dropped the other two because they repeat",
        "correct": false,
        "why": "Nothing repeats here."
      }
    ]
  },
  {
