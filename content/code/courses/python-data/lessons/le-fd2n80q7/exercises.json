      {
        "text": "They became 0.0",
        "correct": false,
        "why": "The mask is False for them."
      },
      {
        "text": "Nothing",
        "correct": true,
        "why": "Right: `nan < 0.5` is False."
      },
      {
        "text": "They raised an error",
        "correct": false,
        "why": "Comparisons with nan do not raise."
      },
      {
        "text": "They were removed from the array, making it shorter",
        "correct": false,
        "why": "Assigning never changes length."
      }
    ]
  },
