  },
  {
    "id": "ex-24ccs4qa",
    "version": 1,
    "section": "boolean-masks",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `temp[heavy]` give the temperatures of the heavy-rain days?",
    "hint": "The mask was made from `rain`.",
    "choices": [
      {
        "text": "Because `temp` and `rain` share memory",
        "correct": false,
        "why": "They are separate columns; sharing is not what makes this work."
      },
      {
        "text": "Both arrays have one element per day, in the same order",
        "correct": true,
        "why": "Right: a mask keeps arrays in step."
      },
      {
        "text": "Because NumPy remembers which array the mask came from",
        "correct": false,
        "why": "A mask is just booleans; it remembers nothing."
      },
      {
        "text": "It does not; it gives the rain again",
        "correct": false,
        "why": "Indexing `temp` gives `temp`'s values."
      }
    ]
  },
  {
    "id": "ex-my22xsr0",
    "version": 1,
    "section": "boolean-masks",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "`hot = weeks > 31.5`, shape `(52, 7)`. What is the shape of `weeks[hot]`?",
    "hint": "The selected elements do not form rows.",
    "choices": [
      {
        "text": "`(52, 7)`, with the cold days set to `nan`",
        "correct": false,
        "why": "A mask selects; it does not blank."
      },
      {
        "text": "`(16, 7)`, the weeks with a hot day",
        "correct": false,
        "why": "That needs a row mask: `hot.any(axis=1)`."
      },
      {
        "text": "One-dimensional: `(18,)`, one per hot day",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`(52,)`, one per week",
        "correct": false,
        "why": "That would be a reduction."
      }
    ]
  },
  {
    "id": "ex-ef4e6daj",
    "version": 1,
    "section": "combining-conditions",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`(rain > 20) and (temp > 31)` raises `The truth value of an array … is ambiguous`. What do you write instead?",
    "hint": "The elementwise operator.",
    "choices": [
      {
        "text": "`(rain > 20).all() and (temp > 31).all()`",
        "correct": false,
        "why": "That asks whether every day was both, one answer."
      },
      {
        "text": "`(rain > 20) & (temp > 31)`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`rain > 20 & temp > 31`",
        "correct": false,
        "why": "Without parentheses `&` binds first and it fails."
      },
      {
        "text": "`(rain > 20) + (temp > 31)`",
        "correct": false,
        "why": "That is closer to or, and it counts."
      }
    ]
  },
  {
    "id": "ex-ndym3ky4",
    "version": 1,
    "section": "combining-conditions",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `rain > 20 & temp > 31` fail even though each comparison is valid?",
    "hint": "Operator precedence.",
    "choices": [
      {
        "text": "Because `&` needs integer arrays",
        "correct": false,
        "why": "It works on booleans; the problem is what it is applied to."
      },
      {
        "text": "Because chained comparisons are not allowed on arrays",
        "correct": false,
        "why": "That is a separate problem; the error here comes first."
      },
      {
        "text": "`&` binds first: `20 & temp`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Because `temp` contains `nan`",
        "correct": false,
        "why": "`temp` has no missing values."
      }
    ]
  },
  {
    "id": "ex-0spax7vy",
    "version": 1,
    "section": "combining-conditions",
