[
  {
    "id": "ex-fz6mvp5c",
    "version": 1,
    "section": "positions-and-slices",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which positions does `temp[:3]` hold?",
    "hint": "The stop is not included.",
    "choices": [
      {
        "text": "1, 2 and 3",
        "correct": false,
        "why": "Positions start at 0."
      },
      {
        "text": "0, 1 and 2",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "0, 1, 2 and 3",
        "correct": false,
        "why": "The stop is excluded."
      },
      {
        "text": "The last three",
        "correct": false,
        "why": "That is `temp[-3:]`."
      }
    ]
  },
  {
    "id": "ex-03dx4ngb",
    "version": 1,
    "section": "positions-and-slices",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`weeks` is `(52, 7)`. What is the shape of `weeks[:, 4]`?",
    "hint": "An integer removes its axis.",
    "choices": [
      {
        "text": "`(52, 1)`",
        "correct": false,
        "why": "That would be `weeks[:, 4:5]`."
      },
      {
        "text": "`(7,)`",
        "correct": false,
        "why": "That is one week: `weeks[4]`."
      },
      {
        "text": "`(52,)`",
        "correct": true,
        "why": "Right: every Sunday."
      },
      {
        "text": "`(1, 7)`",
        "correct": false,
        "why": "That is `weeks[4:5]`."
      }
    ]
  },
  {
    "id": "ex-xvwstpqx",
    "version": 1,
    "section": "positions-and-slices",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`weeks[3, 4]` and `weeks[3][4]` give the same number. What is the difference?",
    "hint": "Count the operations.",
    "choices": [
      {
        "text": "Two lookups instead of one",
        "correct": true,
        "why": "Right: two steps instead of one."
      },
      {
        "text": "The second counts from 1",
        "correct": false,
        "why": "Both count from 0."
      },
      {
        "text": "The first returns a copy of the whole row",
        "correct": false,
        "why": "It returns one number."
      },
      {
        "text": "None at all; NumPy rewrites one into the other",
        "correct": false,
        "why": "They are evaluated differently."
      }
    ]
  },
  {
