      {
        "text": "A table of the wrong shape, silently",
        "correct": true,
        "why": "Right: one column and a two-level index here."
      },
      {
        "text": "The right table, since pandas detects the locale",
        "correct": false,
        "why": "It assumes the English convention."
      },
      {
        "text": "The right columns with numbers as text",
        "correct": false,
        "why": "That is what `sep=\";\"` alone gives."
      }
    ]
  },
  {
    "id": "ex-s96fbg0y",
    "version": 1,
    "section": "a-brazilian-csv",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which call reads a file with `;` between columns and `,` as the decimal point?",
    "hint": "Two conventions, two arguments.",
    "choices": [
      {
        "text": "`pd.read_csv(path, sep=\";\")`",
        "correct": false,
        "why": "The numbers stay text."
      },
      {
        "text": "`pd.read_csv(path, decimal=\",\")`",
        "correct": false,
        "why": "The columns do not split."
      },
      {
        "text": "`pd.read_csv(path, sep=\";\", decimal=\",\")`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`pd.read_csv(path, encoding=\"latin-1\")`",
        "correct": false,
        "why": "That is about characters, not separators."
      }
    ]
  },
