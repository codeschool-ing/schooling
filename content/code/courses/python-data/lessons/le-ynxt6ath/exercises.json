      {
        "text": "From a guess based on the column's values",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "From the file's extension",
        "correct": false,
        "why": "The extension says nothing about columns."
      },
      {
        "text": "From the first row only",
        "correct": false,
        "why": "It looks at all the values."
      }
    ]
