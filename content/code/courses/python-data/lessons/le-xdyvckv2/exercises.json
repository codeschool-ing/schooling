  {
    "id": "ex-b0r94ass",
    "version": 1,
    "section": "conditions-without-apply",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "In the `band` function, why does `pd.isna(m)` come first?",
    "hint": "What is `nan < 10`?",
    "choices": [
      {
        "text": "Otherwise a missing length ends up `\"long\"`",
        "correct": true,
        "why": "Right: every comparison with `nan` is `False`."
      },
      {
        "text": "It is faster to test first",
        "correct": false,
        "why": "Order matters for correctness here."
      },
      {
        "text": "`np.select` requires it first",
        "correct": false,
        "why": "The function came before `np.select`."
      },
      {
        "text": "`nan < 10` raises an error",
        "correct": false,
        "why": "It is `False`, silently."
      }
    ]
  },
  {
    "id": "ex-82ejw3ed",
    "version": 1,
    "section": "conditions-without-apply",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Bands are ranges of one number: under 10, 10 to 30, 30 and over. Which call fits best, and keeps the bands in order?",
    "hint": "It returns a categorical.",
    "choices": [
      {
        "text": "`np.where`",
        "correct": false,
        "why": "Two choices only, unless nested."
      },
      {
        "text": "`Series.apply` with a function",
        "correct": false,
        "why": "A loop, and the result is plain text."
      },
      {
        "text": "`pd.cut`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`Series.map` with a dictionary",
        "correct": false,
        "why": "A dictionary maps values, not ranges."
      }
    ]
  },
