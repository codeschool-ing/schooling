      },
      {
        "text": "One row, as a new Series",
        "correct": true,
        "why": "Right: built for every call."
      },
      {
        "text": "The whole DataFrame",
        "correct": false,
        "why": "One row per call."
      },
      {
        "text": "A NumPy array of the row's values",
        "correct": false,
        "why": "pandas hands over a Series."
      }
    ]
  },
  {
    "id": "ex-5zjvvcp5",
    "version": 1,
    "section": "apply-on-rows",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The row version took about 330 ms and the column version under 1 ms. What makes most of the difference?",
    "hint": "How many times does Python run?",
    "choices": [
      {
        "text": "The column version skips the lost bikes",
        "correct": false,
        "why": "Both give the same values, `NaN` included."
      },
      {
        "text": "Datetimes are slow to subtract in any form",
        "correct": false,
        "why": "The column subtraction is fast."
      },
      {
        "text": "A Python call and a new Series for each of 33,337 rows",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`%timeit` runs the row version more times",
        "correct": false,
        "why": "It reports an average per run."
      }
    ]
  },
  {
    "id": "ex-j1f09em8",
    "version": 1,
    "section": "apply-on-rows",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What should you ask before writing `apply(..., axis=1)`?",
    "hint": "If the answer is yes, columns can do it.",
    "choices": [
      {
        "text": "Is the calculation the same for every row?",
        "correct": true,
        "why": "Right: then write it on columns."
      },
      {
        "text": "Does the table fit in memory?",
        "correct": false,
        "why": "It already does."
      },
      {
        "text": "Is the function named?",
        "correct": false,
        "why": "A name does not make it fast."
      },
      {
        "text": "Are there more columns than rows?",
        "correct": false,
        "why": "Not the question."
      }
    ]
  },
  {
