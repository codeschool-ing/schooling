      {
        "text": "Lines cannot be fitted to rain",
        "correct": false,
        "why": "They can; it would be wrong."
      },
      {
        "text": "There are too few days",
        "correct": false,
        "why": "There are 359."
      },
      {
        "text": "The shape is a step, not a slope",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The relationship is positive",
        "correct": false,
        "why": "Trips fall with heavy rain."
      }
    ]
  },
