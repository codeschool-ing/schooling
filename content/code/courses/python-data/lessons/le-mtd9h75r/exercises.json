  {
    "id": "ex-51x8phn7",
    "version": 1,
    "section": "distributions",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does the box of a box plot hold?",
    "hint": "From one quartile to another.",
    "choices": [
      {
        "text": "Every value within one standard deviation",
        "correct": false,
        "why": "It uses quartiles, not the standard deviation."
      },
      {
        "text": "The middle half of the values",
        "correct": true,
        "why": "Right: first to third quartile."
      },
      {
        "text": "All values except the outliers",
        "correct": false,
        "why": "That is box and whiskers."
      },
      {
        "text": "The values around the mean",
        "correct": false,
        "why": "The line inside is the median."
      }
    ]
  },
