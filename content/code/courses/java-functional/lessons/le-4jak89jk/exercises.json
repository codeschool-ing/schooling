    "choices": [
      {
        "text": "Named groups match faster",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "`group(int)` was removed in Java 25",
        "correct": false,
        "why": "It still exists."
      },
      {
        "text": "A name survives a new group",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Numbered groups start at 0 and skip the title",
        "correct": false,
        "why": "Group 3 would be the title today."
      }
    ]
