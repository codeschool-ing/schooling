  {
    "id": "ex-mp495vsk",
    "version": 1,
    "section": "backtracking",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What made `((a++)+)+b` as fast as `a+b`?",
    "hint": "The second `+`.",
    "choices": [
      {
        "text": "`++` is compiled to a loop in native code",
        "correct": false,
        "why": "The cause is the retrying."
      },
      {
        "text": "`a++` never gives letters back",
        "correct": true,
        "why": "Right: nothing to retry."
      },
      {
        "text": "It is the same as `(a+)+b`, optimised",
        "correct": false,
        "why": "It is still three levels."
      },
      {
        "text": "It needs fewer letters to match",
        "correct": false,
        "why": "It matched nothing either."
      }
    ]
  },
