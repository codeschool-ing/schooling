    "section": "instants-and-zones",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`Moment.java` took one instant to three zones. What did Tokyo say that the other two did not?",
    "hint": "The date.",
    "choices": [
      {
        "text": "That it was still Friday the 6th",
        "correct": false,
        "why": "It was ahead, not behind."
      },
      {
        "text": "A different epoch second",
        "correct": false,
        "why": "The instant is the same everywhere."
      },
      {
        "text": "That it was already Sunday the 8th",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "That the instant was invalid there",
        "correct": false,
        "why": "Every zone read it."
      }
    ]
  },
