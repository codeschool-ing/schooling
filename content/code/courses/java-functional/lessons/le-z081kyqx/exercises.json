    "choices": [
      {
        "text": "An exception",
        "correct": false,
        "why": "Nothing was thrown."
      },
      {
        "text": "3 March",
        "correct": false,
        "why": "The overflow is not carried."
      },
      {
        "text": "28 February",
        "correct": true,
        "why": "Right: the last day of the month."
      },
      {
        "text": "2 March",
        "correct": false,
        "why": "That was `plusDays(30)`."
      }
    ]
  },
