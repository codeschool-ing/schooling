    "section": "instants-and-zones",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `java.time` name a zone like `America/Sao_Paulo` instead of an offset like `-03:00`?",
    "hint": "Brazil in 2019.",
    "choices": [
      {
        "text": "The offset is a rule that changes over time",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Offsets are only used for the UTC zone",
        "correct": false,
        "why": "Every zoned time printed one."
      },
      {
        "text": "Names are shorter to store",
        "correct": false,
        "why": "They are longer."
      },
      {
        "text": "Offsets cannot be negative",
        "correct": false,
        "why": "`-05:00` was printed."
      }
    ]
  },
  {
