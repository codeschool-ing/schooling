  {
    "id": "ex-td2wecnh",
    "version": 1,
    "section": "periods-and-durations",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "`Spans.java` asked for 02:30 on 8 March 2026 in New York. What came back?",
    "hint": "The gap was an hour.",
    "choices": [
      {
        "text": "02:30, with the offset `-05:00`",
        "correct": false,
        "why": "That time never happened there."
      },
      {
        "text": "`DateTimeException`: the time does not exist",
        "correct": false,
        "why": "Java did not refuse it."
      },
      {
        "text": "03:30, with the offset `-04:00`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "01:30, moved back before the gap",
        "correct": false,
        "why": "It moved forward."
      }
    ]
  },
