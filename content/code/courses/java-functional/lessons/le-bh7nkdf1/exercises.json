  {
    "id": "ex-fv4g22zf",
    "version": 1,
    "section": "walking-a-tree",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`dune.txt` is 2,000 bytes. Why did `Files.find` with `attrs.size() > 2_000` leave it out?",
    "hint": "Read the comparison.",
    "choices": [
      {
        "text": "The attributes were read before the file was written",
        "correct": false,
        "why": "The files were all written first."
      },
      {
        "text": "`find` skips the files directly inside `fiction`",
        "correct": false,
        "why": "It searched every level."
      },
      {
        "text": "2,000 is not more than 2,000",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The `.txt` filter of the walk above removed it",
        "correct": false,
        "why": "Each stream is separate."
      }
    ]
  },
  {
    "id": "ex-yrefweqw",
    "version": 1,
    "section": "walking-a-tree",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `Tree.java` sort the walk in reverse before deleting?",
    "hint": "What `Files.delete` refuses.",
    "choices": [
      {
        "text": "Deleting in order would skip every second path",
        "correct": false,
        "why": "The stream does not skip."
      },
      {
        "text": "Reverse order is faster on most file systems",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "So every directory is empty when its turn comes",
        "correct": true,
        "why": "Right: children before parents."
      },
      {
        "text": "`Files.walk` returns paths in reverse already",
        "correct": false,
        "why": "It starts at the root."
      }
    ]
  },
