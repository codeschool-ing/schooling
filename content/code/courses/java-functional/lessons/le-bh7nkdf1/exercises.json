  {
    "id": "ex-jwah5e6d",
    "version": 1,
    "section": "paths",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`Names.java` built `Path.of(\"library\", \"fiction\", \"dune.txt\")` for a file that is not there. When did anything fail?",
    "hint": "A `Path` is a name.",
    "choices": [
      {
        "text": "Never: `Files.exists` said `false`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "At `Path.of`, with `NoSuchFileException`",
        "correct": false,
        "why": "Building a path checks nothing."
      },
      {
        "text": "At `toAbsolutePath`, which needs the file",
        "correct": false,
        "why": "It used the working directory only."
      },
      {
        "text": "At `getParent`, which returned `null`",
        "correct": false,
        "why": "It returned `library/fiction`."
      }
    ]
  },
  {
