  {
    "id": "ex-0qxdmbwg",
    "version": 1,
    "section": "reading-and-writing",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`Catalogue.java` called `Files.writeString` with `StandardOpenOption.APPEND`. What would the same call have done with no options?",
    "hint": "The default of both write methods.",
    "choices": [
      {
        "text": "Written to a new file named `catalogue.csv.1`",
        "correct": false,
        "why": "Nothing renames files."
      },
      {
        "text": "Replaced the three lines with one",
        "correct": true,
        "why": "Right: the default replaces the file."
      },
      {
        "text": "Thrown, since the file already existed",
        "correct": false,
        "why": "Without options an existing file is fine."
      },
      {
        "text": "Added to the end, as appending is the default",
        "correct": false,
        "why": "Appending has to be asked for."
      }
    ]
  },
