  {
    "id": "ex-7h49gyfs",
    "version": 1,
    "section": "reading-and-writing",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A log is two gigabytes. Which call reads it without holding all of it in memory?",
    "hint": "Read as it is pulled.",
    "choices": [
      {
        "text": "`Files.size(path)`",
        "correct": false,
        "why": "That reads the size and no content."
      },
      {
        "text": "`Files.lines(path)`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`Files.readString(path)`",
        "correct": false,
        "why": "That builds one string of all of it."
      },
      {
        "text": "`Files.readAllLines(path)`",
        "correct": false,
        "why": "That builds a list of all of it."
      }
    ]
  },
  {
    "id": "ex-j5ntytab",
    "version": 1,
    "section": "reading-and-writing",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does `Files.lines` go in a `try` with resources when a stream from a list does not?",
    "hint": "Lesson 19 section 04.",
    "choices": [
      {
        "text": "A parallel stream needs it to join its threads",
        "correct": false,
        "why": "The stream was sequential."
      },
      {
        "text": "It throws `IOException` from every element",
        "correct": false,
        "why": "The `try` is there to close, not to catch."
      },
      {
        "text": "Its lines are lost when the method returns",
        "correct": false,
        "why": "The sum was printed inside the block."
      },
      {
        "text": "It holds a file descriptor open until it is closed",
        "correct": true,
        "why": "Right, and `sum` does not close it."
      }
    ]
  },
  {
