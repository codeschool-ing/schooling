[
  {
    "id": "ex-rc0cns4w",
    "version": 1,
    "section": "tasks-that-outlive-their-caller",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "In `Orphan.java`, the price lookup failed at 300 ms. What did the stock lookup do?",
    "hint": "Nothing told it.",
    "choices": [
      {
        "text": "It threw the same exception as the price lookup",
        "correct": false,
        "why": "It finished normally and printed."
      },
      {
        "text": "Ran its full second for nobody",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It was cancelled at once",
        "correct": false,
        "why": "That is what the scope does in section 03."
      },
      {
        "text": "It never started",
        "correct": false,
        "why": "It printed `stock: finished, for nobody`."
      }
    ]
  },
  {
    "id": "ex-46cf51x3",
    "version": 1,
    "section": "tasks-that-outlive-their-caller",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does the lesson call the deeper problem with the two lookups in `Orphan.java`?",
    "hint": "Where does their relationship exist?",
    "choices": [
      {
        "text": "Virtual threads are too cheap to track",
        "correct": false,
        "why": "Cost is not the problem."
      },
      {
        "text": "It lives only in the author's head",
        "correct": true,
        "why": "Right: the code never says they are one job."
      },
      {
        "text": "`CompletableFuture` loses exceptions",
        "correct": false,
        "why": "The page did report the failure."
      },
      {
        "text": "The executor closed too early",
        "correct": false,
        "why": "It closed late, waiting for the orphan."
      }
    ]
  },
  {
    "id": "ex-6h8b7wye",
    "version": 1,
    "section": "a-scope-for-tasks",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "With the default policy of `StructuredTaskScope.open()`, what happens when one subtask fails?",
    "hint": "All or nothing.",
    "choices": [
      {
        "text": "The failed subtask is retried",
        "correct": false,
        "why": "Nothing is retried."
      },
      {
        "text": "The JVM exits",
        "correct": false,
        "why": "The exception reaches the caller of `join`."
      },
      {
        "text": "The others finish, and `join` returns the successful ones",
        "correct": false,
        "why": "That is closer to `awaitAll`."
      },
      {
        "text": "The others are cancelled; `join` throws",
        "correct": true,
        "why": "Right: `FailedException`."
      }
    ]
  },
