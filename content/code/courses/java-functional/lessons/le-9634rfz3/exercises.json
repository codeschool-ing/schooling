    "section": "other-policies-and-the-preview",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which `Joiner` keeps the first answer of three mirrors and cancels the rest?",
    "hint": "Any success.",
    "choices": [
      {
        "text": "`anySuccessfulResultOrThrow()`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "the default of `open()`",
        "correct": false,
        "why": "That is all or nothing."
      },
      {
        "text": "`allSuccessfulOrThrow()`",
        "correct": false,
        "why": "That needs every one to succeed."
      },
      {
        "text": "`awaitAll()`",
        "correct": false,
        "why": "That waits for all of them."
      }
    ]
  },
