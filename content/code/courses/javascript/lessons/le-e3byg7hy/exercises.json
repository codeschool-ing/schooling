    "right_distractors": [
      "`Assignment to constant variable.`"
    ]
  },
  {
    "id": "ex-ebm23j7q",
    "version": 1,
    "section": "silent-to-loud",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How deep does `Object.freeze` go?",
    "hint": "Like a spread.",
    "choices": [
      {
        "text": "All the way down",
        "correct": false,
        "why": "Nested objects stay changeable."
      },
      {
        "text": "One level",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It freezes only arrays",
        "correct": false,
        "why": "It freezes any object's own properties."
      },
      {
        "text": "It freezes the variable, not the object",
        "correct": false,
        "why": "That is `const`."
      }
    ]
  },
  {
    "id": "ex-h2afagcb",
    "version": 1,
    "section": "silent-to-loud",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does the section say the difference between the two modes matters, if the frozen object is unchanged either way?",
    "hint": "Where is the bug found?",
    "choices": [
      {
        "text": "Strict mode changes the object back afterwards",
        "correct": false,
        "why": "Nothing was changed to undo."
      },
      {
        "text": "Sloppy mode corrupts the object",
        "correct": false,
        "why": "It was left intact."
      },
      {
        "text": "Strict mode reports it at the line",
        "correct": true,
        "why": "Right, not later from a wrong value."
      },
      {
        "text": "Strict mode is faster",
        "correct": false,
        "why": "Speed is not the argument."
      }
    ]
  },
  {
    "id": "ex-m6gdgy9m",
    "version": 1,
    "section": "this-in-strict",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What did a plain call of a sloppy function give for `this`?",
    "hint": "`this === globalThis`.",
    "choices": [
      {
        "text": "The global object",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`undefined`",
        "correct": false,
        "why": "That was the strict one."
      },
      {
        "text": "The function itself",
        "correct": false,
        "why": "`this` is not the function."
      },
      {
        "text": "`null`",
        "correct": false,
        "why": "Neither mode gives `null` here."
      }
    ]
  },
  {
    "id": "ex-pqdtthd7",
    "version": 1,
    "section": "this-in-strict",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A sloppy method that lost its object runs `this.count = 0`. What happens?",
    "hint": "`this` is the global object.",
    "choices": [
      {
        "text": "A `TypeError`",
        "correct": false,
        "why": "In sloppy mode it does not throw."
      },
      {
        "text": "A global appears",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Nothing at all",
        "correct": false,
        "why": "It changes something, which is the problem."
      },
      {
        "text": "`count` is set on the method",
        "correct": false,
        "why": "`this` is not the method."
      }
    ]
  },
  {
