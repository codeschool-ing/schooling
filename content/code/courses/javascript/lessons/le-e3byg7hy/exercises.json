[
  {
    "id": "ex-pjgvd1gt",
    "version": 1,
    "section": "turning-it-on",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "In strict mode, what does assigning to an undeclared name such as `totl = 7` do?",
    "hint": "The typo is found where it is.",
    "choices": [
      {
        "text": "Throws a `ReferenceError`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Creates a global called `totl`",
        "correct": false,
        "why": "That is sloppy mode."
      },
      {
        "text": "Assigns to the nearest variable with a similar name",
        "correct": false,
        "why": "Nothing guesses names."
      },
      {
        "text": "Is ignored silently",
        "correct": false,
        "why": "Strict mode exists to stop exactly that."
      }
    ]
  },
  {
    "id": "ex-rj69fnjj",
    "version": 1,
    "section": "turning-it-on",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Where must `\"use strict\"` be written to cover a whole file?",
    "hint": "Before any other statement.",
    "choices": [
      {
        "text": "Anywhere in the file",
        "correct": false,
        "why": "After other code it is just a string."
      },
      {
        "text": "At the end, after all the code",
        "correct": false,
        "why": "It must come first."
      },
      {
        "text": "As the first statement",
        "correct": true,
        "why": "Right; comments may come before it."
      },
      {
        "text": "In `package.json`",
        "correct": false,
        "why": "That decides module type, not strictness directly."
      }
    ]
  },
