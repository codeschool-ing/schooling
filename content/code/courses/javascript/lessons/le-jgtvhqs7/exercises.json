        "correct": false,
        "why": "The data is still wrong."
      },
      {
        "text": "A 503 from a busy server",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A `SyntaxError` from bad JSON",
        "correct": false,
        "why": "The server will send the same thing."
      }
