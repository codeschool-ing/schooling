  {
    "id": "ex-4g514dpb",
    "version": 1,
    "section": "http-errors",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "A request for a book that does not exist got a 404. What did the `fetch` promise do?",
    "hint": "The `catch` never ran.",
    "choices": [
      {
        "text": "Rejected with a `NotFoundError`",
        "correct": false,
        "why": "No such error exists in `fetch`."
      },
      {
        "text": "Resolved, with `ok: false`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Never settled",
        "correct": false,
        "why": "It resolved at once."
      },
      {
        "text": "Rejected with a `TypeError`",
        "correct": false,
        "why": "That is for no response at all."
      }
    ]
  },
  {
    "id": "ex-pdvy6f88",
    "version": 1,
    "section": "http-errors",
    "type": "ordering",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Put `getJSON`'s steps in order.",
    "hint": "Type, body, status.",
    "items": [
      "Send the request with `fetch`",
      "Check the content type is JSON",
      "Read and parse the body",
      "Throw if `response.ok` is false",
      "Return the body"
    ],
    "trap": "The body is read before checking `ok`, so the error can carry the server's explanation."
  },
  {
    "id": "ex-2tm8c7n9",
    "version": 1,
    "section": "http-errors",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does `getJSON` read the body before checking `response.ok`?",
    "hint": "What did the 404's body say?",
    "choices": [
      {
        "text": "A body must be read or the request repeats",
        "correct": false,
        "why": "Nothing repeats."
      },
      {
        "text": "`ok` is only set after the body is read",
        "correct": false,
        "why": "It is known when the response arrives."
      },
      {
        "text": "So the error carries the server's reason",
        "correct": true,
        "why": "Right: `404 no book 9`."
      },
      {
        "text": "Reading it makes the status change",
        "correct": false,
        "why": "The status never changes."
      }
    ]
  },
  {
    "id": "ex-j0qyhngx",
    "version": 1,
    "section": "network-failures",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "In the browser, which request made `fetch` itself reject?",
    "hint": "No answer at all.",
    "choices": [
      {
        "text": "The 404",
        "correct": false,
        "why": "It resolved."
      },
      {
        "text": "The HTML error page",
        "correct": false,
        "why": "It resolved; `getJSON` threw."
      },
      {
        "text": "Port 8099",
        "correct": true,
        "why": "Right: `TypeError: Failed to fetch`."
      },
      {
        "text": "`/api/books/2`",
        "correct": false,
        "why": "That one worked."
      }
    ]
  },
  {
    "id": "ex-0z1wttfd",
    "version": 1,
    "section": "network-failures",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Without the content-type check, what would `/api/html` have produced?",
    "hint": "The body starts with `<`.",
    "choices": [
      {
        "text": "A `TypeError: Failed to fetch`",
        "correct": false,
