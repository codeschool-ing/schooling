        "correct": false,
        "why": "The server is not undone."
      },
      {
        "text": "Yes, always",
        "correct": false,
        "why": "It may not have reached the server."
      },
      {
        "text": "The client cannot tell",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Only if the status was 201",
        "correct": false,
        "why": "No status arrived."
      }
    ]
  },
