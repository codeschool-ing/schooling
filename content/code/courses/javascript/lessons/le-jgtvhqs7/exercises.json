      {
        "text": "A `SyntaxError` from `response.json()`",
        "correct": true,
        "why": "Right, about an unexpected `<`."
      },
      {
        "text": "An empty object",
        "correct": false,
        "why": "The parse would fail, not return `{}`."
      },
      {
        "text": "A 404",
        "correct": false,
        "why": "The status was 502."
      }
    ]
  },
  {
    "id": "ex-7wh6gwzw",
    "version": 1,
    "section": "network-failures",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Node's `fetch` failed with `fetch failed`. Where is the useful detail?",
    "hint": "A property of the error.",
    "choices": [
      {
        "text": "In `err.message`",
        "correct": false,
        "why": "The message says only `fetch failed`."
      },
      {
        "text": "In `err.cause`",
        "correct": true,
        "why": "Right: `ECONNREFUSED`."
      },
      {
        "text": "In the response's status",
        "correct": false,
        "why": "There was no response."
      },
      {
        "text": "In `err.name`",
        "correct": false,
        "why": "That is `TypeError`."
      }
    ]
  },
  {
    "id": "ex-rgmwjrfz",
    "version": 1,
    "section": "timeouts-and-abort",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "How long does `fetch` wait for a server that never answers?",
    "hint": "It has no timeout of its own.",
    "choices": [
      {
        "text": "30 seconds, the default",
        "correct": false,
        "why": "There is no default timeout."
      },
      {
        "text": "Until something aborts it",
        "correct": true,
        "why": "Right, or the connection dies."
      },
      {
        "text": "1000 ms",
        "correct": false,
        "why": "That was the timeout the program set."
      },
      {
        "text": "Until the next `fetch` call",
        "correct": false,
        "why": "Calls are independent."
      }
    ]
  },
  {
    "id": "ex-h2sa9fvf",
    "version": 1,
    "section": "timeouts-and-abort",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each way of giving up with the error it caused.",
    "hint": "Too long, or not wanted.",
    "pairs": [
      {
        "left": "`AbortSignal.timeout(1000)`",
        "right": "`TimeoutError`"
      },
      {
        "left": "`controller.abort()`",
