[
  {
    "id": "ex-d78asf4v",
    "version": 1,
    "section": "json",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "After `JSON.stringify` and `JSON.parse`, what is a `Date` property?",
    "hint": "`typeof back.added`.",
    "choices": [
      {
        "text": "A string",
        "correct": true,
        "why": "Right. A reviver can turn it back."
      },
      {
        "text": "A `Date`, unchanged",
        "correct": false,
        "why": "`typeof` printed `string`."
      },
      {
        "text": "A number of milliseconds since 1970",
        "correct": false,
        "why": "JSON wrote the ISO text, not a number."
      },
      {
        "text": "Removed, like functions",
        "correct": false,
        "why": "It was kept, as text."
      }
    ]
  },
  {
    "id": "ex-kbchf8t3",
    "version": 1,
    "section": "json",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which of these were lost or changed by `JSON.stringify`? Choose all that apply.",
    "hint": "Four were.",
    "choices": [
      {
        "text": "`isbn: undefined`",
        "correct": true,
        "why": "Left out."
      },
      {
        "text": "The `Map`",
        "correct": true,
        "why": "Became `{}`."
      },
      {
        "text": "The `tags` array",
        "correct": false,
        "why": "Arrays survive."
      },
      {
        "text": "`rating: NaN`",
        "correct": true,
        "why": "Became `null`."
      },
      {
        "text": "`year: 1865`",
        "correct": false,
        "why": "Numbers survive."
      }
    ]
  },
  {
    "id": "ex-bt3z0b5p",
    "version": 1,
    "section": "json",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did `JSON.parse(\"{title: 'Iracema'}\")` throw?",
    "hint": "Valid JavaScript, invalid JSON.",
    "choices": [
      {
        "text": "`title` is a reserved word",
        "correct": false,
        "why": "Any name works, in double quotes."
      },
      {
        "text": "JSON cannot hold strings",
        "correct": false,
        "why": "It holds strings in double quotes."
      },
      {
        "text": "JSON wants double quotes",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The reviver was missing",
        "correct": false,
        "why": "A reviver is optional."
      }
    ]
  },
