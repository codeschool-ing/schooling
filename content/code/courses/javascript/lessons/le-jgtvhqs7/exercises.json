  {
    "id": "ex-gqp82z7h",
    "version": 1,
    "section": "retries",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why is retrying a failed `POST` that creates a loan risky?",
    "hint": "\"It worked and I never heard.\"",
    "choices": [
      {
        "text": "`POST` requests cannot be sent twice",
        "correct": false,
        "why": "They can, which is the risk."
      },
      {
        "text": "The server rejects repeated bodies",
        "correct": false,
        "why": "Only if it uses an idempotency key."
      },
      {
        "text": "It might have worked: two loans",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Backoff makes `POST` slower",
        "correct": false,
        "why": "The risk is a duplicate, not speed."
      }
    ]
  },
