  {
    "id": "ex-1hkxtz0k",
    "version": 1,
    "section": "fetch-basics",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does `fetch(url)` return?",
    "hint": "Two promises in this section.",
    "choices": [
      {
        "text": "The parsed JSON",
        "correct": false,
        "why": "That is what `response.json()` gives."
      },
      {
        "text": "A promise of a `Response`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The body as text",
        "correct": false,
        "why": "The body is read separately."
      },
      {
        "text": "A status code",
        "correct": false,
        "why": "The status is a property of the response."
      }
    ]
  },
  {
    "id": "ex-xvc3qdbx",
    "version": 1,
    "section": "fetch-basics",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "For which statuses is `response.ok` true?",
    "hint": "A range.",
    "choices": [
      {
        "text": "Only 200",
        "correct": false,
        "why": "201 was ok too."
      },
      {
        "text": "200 to 299",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Anything below 500",
        "correct": false,
        "why": "A 404 had `ok: false`."
      },
      {
        "text": "Whenever the body is JSON",
        "correct": false,
        "why": "The 404's body was JSON and `ok` was false."
      }
    ]
  },
  {
