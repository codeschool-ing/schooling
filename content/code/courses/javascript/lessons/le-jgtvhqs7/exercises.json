      },
      {
        "left": "Nothing listening on the port",
        "right": "`TypeError`"
      }
    ],
    "right_distractors": [
      "`RangeError`"
    ]
  },
  {
    "id": "ex-h79kpe1m",
    "version": 1,
    "section": "timeouts-and-abort",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
