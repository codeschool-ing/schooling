[
  {
    "id": "ex-cej6yk1c",
    "version": 1,
    "section": "throw",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "In `throw.js`, why did `never reached` never print?",
    "hint": "What does `throw` do to the functions it leaves?",
    "choices": [
      {
        "text": "`console.log` is skipped after an error is created",
        "correct": false,
        "why": "Creating is not throwing; the throw left `checkout`."
      },
      {
        "text": "The throw left `checkout` before that line",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`lend` returned `undefined`",
        "correct": false,
        "why": "It did not return at all."
      },
      {
        "text": "RangeErrors are printed instead of logs",
        "correct": false,
        "why": "Nothing replaced anything; the line never ran."
      }
    ]
  },
  {
    "id": "ex-fdv2n5kt",
    "version": 1,
    "section": "throw",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why throw `new Error(\"no copies\")` rather than the string `\"no copies\"`?",
    "hint": "Look at `err.stack`.",
    "choices": [
      {
        "text": "Strings cannot be thrown",
        "correct": false,
        "why": "One was thrown and caught."
      },
      {
        "text": "It records its origin",
        "correct": true,
        "why": "Right: its `stack`."
      },
      {
        "text": "Errors are faster to throw",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "A string loses its text when thrown",
        "correct": false,
        "why": "It arrived intact."
      }
    ]
  },
  {
    "id": "ex-afppem9y",
    "version": 1,
    "section": "throw",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A function looks a book up and does not find it. When should it throw rather than return `null`?",
    "hint": "Can the caller carry on?",
    "choices": [
      {
        "text": "Always: not finding is an error",
        "correct": false,
        "why": "\"Not found\" is often an ordinary answer."
      },
      {
        "text": "Never: lookups return `null`",
        "correct": false,
        "why": "Sometimes carrying on would be wrong."
      },
      {
        "text": "When `null` would mislead",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Only in strict mode",
        "correct": false,
        "why": "The mode does not decide."
      }
    ]
  },
  {
