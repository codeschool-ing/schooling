  {
    "id": "ex-bm646xpb",
    "version": 1,
    "section": "local-storage",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `localStorage.getItem(\"nothing-here\")` give for a key never set?",
    "hint": "Not `undefined`.",
    "choices": [
      {
        "text": "`undefined`",
        "correct": false,
        "why": "It printed `null`."
      },
      {
        "text": "An empty string",
        "correct": false,
        "why": "A missing key is not an empty value."
      },
      {
        "text": "`null`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A `ReferenceError`",
        "correct": false,
        "why": "Nothing threw."
      }
    ]
  },
  {
    "id": "ex-79d5fq7h",
    "version": 1,
    "section": "local-storage",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does the section say `localStorage` is for?",
    "hint": "Things whose loss is an inconvenience.",
    "choices": [
      {
        "text": "The user's account and orders",
        "correct": false,
        "why": "Those must be kept, on a server."
      },
      {
        "text": "Large files the user uploads",
        "correct": false,
        "why": "It holds a few megabytes."
      },
      {
        "text": "Values the server must trust",
        "correct": false,
        "why": "The user can edit them."
      },
      {
        "text": "Small preferences and drafts",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-et2ebs9p",
    "version": 1,
    "section": "session-storage",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "The draft was saved, then the page was reloaded, then opened in a new tab. Where was the draft found?",
    "hint": "One tab, one session.",
    "choices": [
      {
        "text": "In both the reload and the new tab",
        "correct": false,
        "why": "The new tab found nothing."
      },
      {
        "text": "After the reload only",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "In the new tab only",
        "correct": false,
        "why": "It is the other way round."
      },
      {
        "text": "Nowhere; it is cleared on reload",
        "correct": false,
        "why": "The reload found it."
      }
    ]
  },
  {
    "id": "ex-m3df4pzk",
    "version": 1,
    "section": "session-storage",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each kind of data with the store the section suggests.",
    "hint": "One tab, or every visit?",
    "pairs": [
      {
        "left": "The step a form is on, in this tab",
        "right": "`sessionStorage`"
      },
      {
        "left": "The user's chosen theme",
        "right": "`localStorage`"
      },
      {
        "left": "The user's account balance",
        "right": "The server"
      }
    ],
    "right_distractors": [
      "A cookie read by every site"
    ]
  },
  {
    "id": "ex-6kst5hdz",
    "version": 1,
    "section": "session-storage",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Can a page on `http://127.0.0.1:8080` read what a page on `http://127.0.0.1:9000` stored?",
    "hint": "An origin includes the port.",
    "choices": [
      {
        "text": "Yes, same host",
        "correct": false,
        "why": "The port differs, so the origin differs."
      },
      {
        "text": "Only `sessionStorage`",
        "correct": false,
        "why": "Neither store crosses origins."
      },
      {
        "text": "No: different origins",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Only if both pages are open",
        "correct": false,
        "why": "Being open does not join origins."
      }
    ]
  },
  {
    "id": "ex-yk33rdrx",
    "version": 1,
    "section": "storage-limits",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What did Chromium throw when the page stored too much?",
