[
  {
    "id": "ex-cy27devt",
    "version": 1,
    "section": "local-storage",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What did `localStorage.setItem(\"lastBook\", { title: \"Iracema\" })` store?",
    "hint": "Everything becomes a string.",
    "choices": [
      {
        "text": "`[object Object]`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The object, unchanged",
        "correct": false,
        "why": "Web storage holds strings only."
      },
      {
        "text": "`{\"title\":\"Iracema\"}`",
        "correct": false,
        "why": "That needs `JSON.stringify`."
      },
      {
        "text": "Nothing; it threw a `TypeError`",
        "correct": false,
        "why": "It stored, and lost the title."
      }
    ]
  },
  {
