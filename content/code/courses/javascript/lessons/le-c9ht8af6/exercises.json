  {
    "id": "ex-h98ykgmt",
    "version": 1,
    "section": "notifications",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A permission is `denied`. What can the page do to get it?",
    "hint": "Only the user can change it.",
    "choices": [
      {
        "text": "Ask again with `requestPermission`",
        "correct": false,
        "why": "A denied permission is not asked again."
      },
      {
        "text": "Explain where the browser's settings are",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Reload the page, which resets it",
        "correct": false,
        "why": "The decision survives reloads."
      },
      {
        "text": "Store `granted` in `localStorage`",
        "correct": false,
        "why": "The browser does not read that."
      }
    ]
  },
  {
    "id": "ex-7agdzkpz",
    "version": 2,
    "section": "notifications",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why was showing a notification not captured in this lesson?",
    "hint": "The browser `page` drives.",
    "choices": [
      {
        "text": "Notifications were removed from browsers",
        "correct": false,
        "why": "They exist; a browser with no screen cannot display one."
      },
      {
        "text": "Node cannot run notification code",
        "correct": false,
        "why": "The page runs in the browser, not in Node."
      },
      {
        "text": "The headless browser cannot display one",
        "correct": true,
        "why": "Right; a transcript would show a failure a real browser does not have."
      },
      {
        "text": "Permissions cannot be granted to `page`",
        "correct": false,
        "why": "`--grant` granted them."
      }
    ]
  },
