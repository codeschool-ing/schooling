    "choices": [
      {
        "text": "From the server's IP address",
        "correct": false,
        "why": "Nothing looked up an address."
      },
      {
        "text": "From the computer's own location service",
        "correct": false,
        "why": "Nothing asked the system; the browser answered with what it was given."
      },
      {
        "text": "It was staged with `page --geo`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "From `localStorage`",
        "correct": false,
        "why": "Nothing stored a position."
      }
    ]
  },
