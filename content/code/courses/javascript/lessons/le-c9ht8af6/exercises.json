    "choices": [
      {
        "text": "`QuotaExceededError`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`RangeError`",
        "correct": false,
        "why": "The name was more specific."
      },
      {
        "text": "`TypeError`",
        "correct": false,
        "why": "The value's type was fine."
      },
      {
        "text": "Nothing; it silently dropped the item",
        "correct": false,
        "why": "It threw."
      }
    ]
  },
