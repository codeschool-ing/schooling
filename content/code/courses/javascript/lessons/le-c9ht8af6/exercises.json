  {
    "id": "ex-btn222kb",
    "version": 1,
    "section": "storage-limits",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why must a session token not live in `localStorage`, according to the section?",
    "hint": "Who can read it?",
    "choices": [
      {
        "text": "It is too long to fit",
        "correct": false,
        "why": "Tokens are small."
      },
      {
        "text": "Every script on the page reads it",
        "correct": true,
        "why": "Right; `front-quality` lesson 6 covers where tokens go."
      },
      {
        "text": "It would be lost on reload",
        "correct": false,
        "why": "`localStorage` survives reloads."
      },
      {
        "text": "The server cannot read it",
        "correct": false,
        "why": "That is not the danger."
      }
    ]
  },
  {
    "id": "ex-rn1tg38b",
    "version": 1,
    "section": "storage-limits",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A game keeps the player's score in `localStorage` and the server reads it to award prizes. What is wrong?",
    "hint": "Who can edit it?",
    "choices": [
      {
        "text": "Scores are numbers and are stored as strings",
        "correct": false,
        "why": "A conversion fixes that; the trust problem stays."
      },
      {
        "text": "`localStorage` is too small for a score",
        "correct": false,
        "why": "A score is a few bytes."
      },
      {
        "text": "The score is lost when the tab closes",
        "correct": false,
        "why": "That is `sessionStorage`."
      },
      {
        "text": "The user sets whatever score they like",
        "correct": true,
        "why": "Right; the server decides what must be true."
      }
    ]
  },
  {
    "id": "ex-f8px2y2x",
    "version": 1,
    "section": "geolocation",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "With no permission given, which callback ran, and with what code?",
    "hint": "A user who clicked Block.",
    "choices": [
      {
        "text": "The failure one, code 1",
        "correct": true,
        "why": "Right: `PERMISSION_DENIED`."
      },
      {
        "text": "The success callback, with no position",
        "correct": false,
        "why": "Success always has a position."
      },
      {
        "text": "The failure one, code 3",
        "correct": false,
        "why": "Code 3 is a timeout."
      },
      {
        "text": "Neither; the page waited forever",
        "correct": false,
        "why": "The failure callback ran at once."
      }
    ]
  },
  {
    "id": "ex-f1feej00",
    "version": 2,
    "section": "geolocation",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Where did the position in the second run come from?",
