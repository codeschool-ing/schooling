    "choices": [
      {
        "text": "`Promise.resolve(2)` loses its value after two steps",
        "correct": false,
        "why": "The first step got 2 and passed 20 on."
      },
      {
        "text": "`console.log` inside `.then` clears the value",
        "correct": false,
        "why": "It printed it; the missing `return` lost it."
      },
      {
        "text": "The second callback returned nothing",
        "correct": true,
        "why": "Right: forgetting `return` in a `.then`."
      },
      {
        "text": "Chains can only carry numbers",
        "correct": false,
        "why": "They carry any value."
      }
    ]
  },
