  {
    "id": "ex-v9xr0fyx",
    "version": 1,
    "section": "async-await",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "While an `async` function is paused at an `await`, what does the rest of the program do?",
    "hint": "It is not blocking.",
    "choices": [
      {
        "text": "Waits too, until the promise settles",
        "correct": false,
        "why": "Only that function is paused."
      },
      {
        "text": "Throws, since two things cannot run",
        "correct": false,
        "why": "Nothing is running in parallel; the function is parked."
      },
      {
        "text": "Carries on",
        "correct": true,
        "why": "Right; the function resumes later, as a microtask."
      },
      {
        "text": "Restarts from the top of the file",
        "correct": false,
        "why": "Nothing restarts."
      }
    ]
  },
