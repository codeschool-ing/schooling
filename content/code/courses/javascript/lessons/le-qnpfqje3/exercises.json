    "choices": [
      {
        "text": "`await fetchBook(7); await fetchBook(12);`",
        "correct": false,
        "why": "The second call waits for the first."
      },
      {
        "text": "`const a = fetchBook(7); const b = fetchBook(12); await a; await b;`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`for (const id of [7, 12]) await fetchBook(id);`",
        "correct": false,
        "why": "That is one after another."
      },
      {
        "text": "`await fetchBook(7).then(() => fetchBook(12));`",
        "correct": false,
        "why": "The second starts when the first ends."
      }
    ]
