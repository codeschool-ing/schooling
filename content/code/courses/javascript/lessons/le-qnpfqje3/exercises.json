  {
    "id": "ex-f4erz6kr",
    "version": 1,
    "section": "callbacks",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What does the section call worse than the rightward drift of nested callbacks?",
    "hint": "Errors.",
    "choices": [
      {
        "text": "That callbacks run more slowly than promises",
        "correct": false,
        "why": "Speed is not the complaint."
      },
      {
        "text": "Errors that vanish if unchecked",
        "correct": true,
        "why": "Right, and `try` cannot reach a throw inside them."
      },
      {
        "text": "That callbacks cannot be used for events",
        "correct": false,
        "why": "Events are where callbacks are still used."
      },
      {
        "text": "That each callback runs twice",
        "correct": false,
        "why": "Each ran once."
      }
    ]
  },
  {
    "id": "ex-ygwd7cm2",
    "version": 1,
    "section": "promises",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What did `console.log(p)` print straight after `readFile` returned a promise?",
    "hint": "The result has not arrived yet.",
    "choices": [
      {
        "text": "`Promise { <pending> }`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The file's text",
        "correct": false,
        "why": "The text arrives later, through `.then`."
      },
      {
        "text": "`undefined`",
        "correct": false,
        "why": "The promise exists at once."
      },
      {
        "text": "`Promise { <rejected> }`",
        "correct": false,
        "why": "Nothing had failed yet."
      }
    ]
  },
  {
