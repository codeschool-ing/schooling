  {
    "id": "ex-bq3k7e3q",
    "version": 1,
    "section": "promises",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "One `.catch` at the end of a chain of three `.then`s. An error is thrown in the first `.then`. What runs?",
    "hint": "An error skips steps.",
    "choices": [
      {
        "text": "All three `.then`s, then the `.catch`",
        "correct": false,
        "why": "The error skips the remaining `.then`s."
      },
      {
        "text": "Nothing: the error is lost",
        "correct": false,
        "why": "The `.catch` below it receives it."
      },
      {
        "text": "The `.catch`, and the other `.then`s are skipped",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The second `.then`, with the error as its value",
        "correct": false,
        "why": "A rejection does not pass through `.then` callbacks."
      }
    ]
