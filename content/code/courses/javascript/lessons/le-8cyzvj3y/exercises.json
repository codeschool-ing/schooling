[
  {
    "id": "ex-kvsty2ak",
    "version": 1,
    "section": "first-package",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "After `npm install shelf-slug@1`, what range did npm write into `package.json`?",
    "hint": "Look at the `dependencies` field.",
    "choices": [
      {
        "text": "`^1.2.0`",
        "correct": true,
        "why": "Right: a caret on the version it installed."
      },
      {
        "text": "`1`",
        "correct": false,
        "why": "That is what was asked, not what was written."
      },
      {
        "text": "`1.2.0`",
        "correct": false,
        "why": "It wrote a range, not an exact version."
      },
      {
        "text": "`latest`",
        "correct": false,
        "why": "That would be `2.0.0`."
      }
    ]
  },
  {
    "id": "ex-wcj8tgh0",
    "version": 1,
    "section": "first-package",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Where does Node look for `shelf-slug` when a file says `import { slug } from \"shelf-slug\"`?",
    "hint": "No `./` in front of the name.",
    "choices": [
      {
        "text": "In the registry, at run time",
        "correct": false,
        "why": "Node never talks to a registry."
      },
      {
        "text": "In the folder of the importing file",
        "correct": false,
        "why": "That would need `./`."
      },
      {
        "text": "In `node_modules`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "In `package.json`",
        "correct": false,
        "why": "It lists the dependency; the code is elsewhere."
      }
    ]
  },
  {
    "id": "ex-sd54nd6e",
    "version": 1,
    "section": "first-package",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `\"private\": true` in `package.json` do?",
    "hint": "It protects against one mistake.",
    "choices": [
      {
        "text": "Hides the package from `npm ls`",
        "correct": false,
        "why": "`npm ls` printed it."
      },
      {
        "text": "Encrypts `node_modules`",
        "correct": false,
        "why": "Nothing is encrypted."
      },
      {
        "text": "Stops other projects importing it",
        "correct": false,
        "why": "Imports are not checked against it."
      },
      {
        "text": "Makes npm refuse to publish it",
        "correct": true,
        "why": "Right."
      }
    ]
  },
