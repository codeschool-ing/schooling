    "section": "what-to-test",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Where should a small project spend its testing time?",
    "hint": "Wrong, not visible.",
    "choices": [
      {
        "text": "Where a failure would be wrong, not merely visible",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "On every getter and helper, so coverage reads 100%",
        "correct": false,
        "why": "Plumbing is not worth it."
      },
      {
        "text": "On the exact layout of the page, since reviewers look at it",
        "correct": false,
        "why": "Its failures show anyway."
      },
      {
        "text": "On the web framework, to be sure it works",
        "correct": false,
        "why": "It has its own tests."
      }
    ]
  },
