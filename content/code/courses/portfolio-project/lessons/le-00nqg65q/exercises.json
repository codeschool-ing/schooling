    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the blank line after the subject always there?",
    "hint": "Tools.",
    "choices": [
      {
        "text": "It makes the commit smaller",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Git refuses a message without it",
        "correct": false,
        "why": "It accepts it; tools misread it."
      },
      {
        "text": "Tools use it to tell the subject from the body",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It is where the hash goes",
        "correct": false,
        "why": "No."
      }
    ]
