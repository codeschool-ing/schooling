  {
    "id": "ex-pncgv7zm",
    "version": 1,
    "section": "the-message",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each part to its convention.",
    "hint": "The table.",
    "pairs": [
      {
        "left": "Subject",
        "right": "About 50 characters, imperative, no full stop"
      },
      {
        "left": "Body",
        "right": "Wrapped at about 72 columns"
      },
      {
        "left": "Last line",
        "right": "Closes #N or refs #N"
      }
    ],
    "right_distractors": [
      "All in capital letters"
    ]
  },
  {
