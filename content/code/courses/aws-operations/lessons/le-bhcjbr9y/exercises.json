[
  {
    "id": "ex-40ysnvqw",
    "version": 1,
    "section": "trails",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why is event history not an audit log?",
    "hint": "How long, and who controls it?",
    "choices": [
      {
        "text": "It costs too much to keep",
        "correct": false,
        "why": "It is free."
      },
      {
        "text": "It records only failed requests",
        "correct": false,
        "why": "It records management events, failed or not."
      },
      {
        "text": "Ninety days, then gone",
        "correct": true,
        "why": "Right. A trail to a bucket is the audit log."
      },
      {
        "text": "It is turned off by default",
        "correct": false,
        "why": "It is always on."
      }
    ]
  },
  {
    "id": "ex-6aratmbj",
    "version": 1,
    "section": "trails",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does log file validation add to a trail?",
    "hint": "Evidence that can be checked.",
    "choices": [
      {
        "text": "Encryption of every file with KMS",
        "correct": false,
        "why": "That is a separate setting."
      },
      {
        "text": "Signed digests that prove integrity",
        "correct": true,
        "why": "Right. validate-logs checks them."
      },
      {
        "text": "A check that each event's JSON is well-formed",
        "correct": false,
        "why": "It proves integrity, not syntax."
      },
      {
        "text": "Faster delivery to the bucket",
        "correct": false,
        "why": "Delivery speed is unchanged."
      }
    ]
  },
  {
    "id": "ex-5zmzg8q9",
    "version": 1,
    "section": "trails",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the shop's trail multi-region?",
    "hint": "Where would a stolen credential be used?",
    "choices": [
      {
        "text": "Multi-region trails are cheaper",
        "correct": false,
        "why": "Price is not the reason."
      },
      {
        "text": "São Paulo requires it by law",
        "correct": false,
        "why": "No such requirement."
      },
      {
        "text": "Data events exist only in multi-region trails",
        "correct": false,
        "why": "Data events are a selector, in any trail."
      },
      {
        "text": "Stolen keys get used in regions nobody watches",
        "correct": true,
        "why": "Right. A trail for one region records nothing of the others."
      }
    ]
  },
  {
