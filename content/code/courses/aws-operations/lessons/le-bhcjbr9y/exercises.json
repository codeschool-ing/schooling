  {
    "id": "ex-0bjnbfb6",
    "version": 1,
    "section": "records",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "An audit log shows assumed-role/admin/session for everybody. What does it fail to answer?",
    "hint": "Who, or somebody?",
    "choices": [
      {
        "text": "Which account was used",
        "correct": false,
        "why": "The account is in the ARN."
      },
      {
        "text": "Which person it was",
        "correct": true,
        "why": "Right. A fixed session name answers who with somebody."
      },
      {
        "text": "Which operation was called",
        "correct": false,
        "why": "eventName still says."
      },
      {
        "text": "Whether it failed",
        "correct": false,
        "why": "errorCode still says."
      }
    ]
  },
  {
    "id": "ex-xv54j9q9",
    "version": 1,
    "section": "who-did-this",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is the limit of lookup-events, the event history's search?",
    "hint": "Count the attributes.",
    "choices": [
      {
        "text": "It shows only data events",
        "correct": false,
        "why": "It shows management events."
      },
      {
        "text": "It covers the last seven days",
        "correct": false,
        "why": "It covers ninety."
      },
      {
        "text": "It needs a trail to exist before it shows anything",
        "correct": false,
        "why": "Event history needs nothing."
      },
      {
        "text": "One attribute at a time, over 90 days",
        "correct": true,
        "why": "Right. Every change one person made in an afternoon is not one question for it."
      }
    ]
  },
