  {
    "id": "ex-x4wasg6e",
    "version": 1,
    "section": "alarms",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does the lesson put StopLogging and DeleteTrail first on the list of events to page on?",
    "hint": "What happens to the evidence after them?",
    "choices": [
      {
        "text": "They are the most common events",
        "correct": false,
        "why": "They are rare, which is why each one matters."
      },
      {
        "text": "The record stops",
        "correct": true,
        "why": "Right. A trail stopped in silence ends the audit log; everything after it is unrecorded."
      },
      {
        "text": "They cost the most",
        "correct": false,
        "why": "Price is not the point."
      },
      {
        "text": "moto evaluates them",
        "correct": false,
        "why": "moto evaluates no rule."
      }
    ]
  },
  {
    "id": "ex-5pxy2wx4",
    "version": 1,
    "section": "alarms",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What did moto do with the kms-pending-use metric filter?",
    "hint": "Lesson 9 found it first.",
    "choices": [
      {
        "text": "Refused it as invalid syntax",
        "correct": false,
        "why": "It accepted and listed it."
      },
      {
        "text": "Applied it and published one data point",
        "correct": false,
        "why": "Nothing was published."
      },
      {
        "text": "Turned it into an EventBridge rule",
        "correct": false,
        "why": "They are separate services."
      },
      {
        "text": "Stored it and applies nothing",
        "correct": true,
        "why": "Right. Its filters ignore JSON patterns, and it evaluates no alarm."
      }
    ]
  },
