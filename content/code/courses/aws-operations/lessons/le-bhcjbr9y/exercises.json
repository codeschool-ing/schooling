      }
    ]
  },
  {
    "id": "ex-pcm2brcc",
    "version": 1,
    "section": "records",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "In arn:aws:sts::123456789012:assumed-role/shop-admin/bruno, which part says who it was?",
    "hint": "The last part.",
    "choices": [
      {
        "text": "bruno, the role session's name",
        "correct": true,
        "why": "Right. If sign-in sets it to the person's name."
      },
      {
        "text": "shop-admin, the role",
        "correct": false,
        "why": "The role says what the caller could do."
      },
      {
        "text": "123456789012, the account",
        "correct": false,
        "why": "Everybody in the account shares it."
      },
      {
        "text": "sts, the service",
        "correct": false,
        "why": "STS issued the session."
      }
    ]
  },
  {
    "id": "ex-b7j9x5md",
    "version": 1,
    "section": "records",
    "type": "cloze",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The record field that is false for a change and true for a Describe call is ____. (one word)",
