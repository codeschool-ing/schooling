  {
    "id": "ex-sxpe3fxt",
    "version": 1,
    "section": "routing",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Two providers serve a model at $1 and $2 per million. Under OpenRouter's default, how much more likely is the $1 one to be picked first?",
    "hint": "Inverse square.",
    "choices": [
      {
        "text": "Twice",
        "correct": false,
        "why": "That is inverse, not inverse square."
      },
      {
        "text": "Four times",
        "correct": true,
        "why": "Right: 1 against 1/4."
      },
      {
        "text": "It is always picked",
        "correct": false,
        "why": "The others get a share."
      },
      {
        "text": "Equally likely, since load is balanced",
        "correct": false,
        "why": "Balanced by price."
      }
    ]
  },
  {
    "id": "ex-dhy5web6",
    "version": 1,
    "section": "routing",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "ana evaluated a model as served by one provider and wants a failure rather than a different provider. What does she send?",
    "hint": "Order, and no backups.",
    "choices": [
      {
        "text": "models with the model listed twice",
        "correct": false,
        "why": "That is model fallback."
      },
      {
        "text": "provider.order with that provider, and allow_fallbacks false",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "data_collection deny",
        "correct": false,
        "why": "That filters by data policy."
      },
      {
        "text": "Nothing: OpenRouter never changes provider",
        "correct": false,
        "why": "It does, by default."
      }
    ]
  },
  {
    "id": "ex-nfpn6nxz",
    "version": 1,
    "section": "routing",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does section 03 ask ana to record the provider with every answer?",
    "hint": "Who served it can change per request.",
    "choices": [
      {
        "text": "Without it, nobody traces or repeats an answer",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "OpenRouter sends one bill per provider, to be matched by hand",
        "correct": false,
        "why": "The cost is in each response."
      },
      {
        "text": "Providers refuse requests that do not name them",
        "correct": false,
        "why": "No."
      },
      {
        "text": "It is required by the terms of use",
        "correct": false,
        "why": "Not the reason given."
      }
    ]
  },
  {
    "id": "ex-jnye7b56",
    "version": 1,
    "section": "fallbacks",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "ana sends models: [\"standin/small\", \"standin/large\"] and gets an answer. What must she check to know which model answered?",
    "hint": "A field of the response.",
    "choices": [
      {
        "text": "The HTTP status",
        "correct": false,
        "why": "It is 200 either way."
      },
      {
        "text": "Nothing: it is always the first",
        "correct": false,
        "why": "Not when the first fails."
      },
      {
        "text": "The model field",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The cost, since each model has its own",
        "correct": false,
        "why": "Two models can cost the same."
      }
    ]
  },
  {
    "id": "ex-wkwrmb8j",
    "version": 1,
    "section": "fallbacks",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What does putting a second model in the models list commit ana to?",
    "hint": "Lesson 5.",
    "choices": [
      {
        "text": "Paying both models for every request",
        "correct": false,
        "why": "Only the one that answers is paid."
      },
      {
        "text": "Evaluating the second like the first",
        "correct": true,
        "why": "Right: it will sort mail on the day the first cannot."
      },
      {
        "text": "A contract with its provider",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Nothing; fallbacks only run during outages that are rare enough to ignore",
        "correct": false,
        "why": "Outages are exactly when it matters."
      }
    ]
  },
  {
