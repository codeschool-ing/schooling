        "correct": false,
        "why": "They were not."
      },
      {
        "text": "Google's had no required field",
        "correct": false,
        "why": "It listed order as required."
      },
      {
        "text": "OpenAI's used capitals for types",
        "correct": false,
        "why": "Google's did."
      },
      {
        "text": "One said nullable, the other anyOf with null",
        "correct": true,
        "why": "Right: two dialects for one class."
      }
    ]
  },
