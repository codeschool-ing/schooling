  {
    "id": "ex-atre0mkf",
    "version": 1,
    "section": "deleted-files",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does icat do?",
    "hint": "Inode, content.",
    "choices": [
      {
        "text": "Shows the inode's times",
        "correct": false,
        "why": "istat does."
      },
      {
        "text": "Restores the file into its old folder on the disk image, as if it had never been deleted",
        "correct": false,
        "why": "It writes to standard output; the image is untouched."
      },
      {
        "text": "Writes out the content an inode points to",
        "correct": true,
        "why": "Right. Allocated or not."
      },
      {
        "text": "Lists the deleted names found in every folder",
        "correct": false,
        "why": "fls -d does."
      }
    ]
  },
  {
    "id": "ex-xbscmn4a",
    "version": 1,
    "section": "deleted-files",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "When the kernel clears a deleted inode's block list, what is recovery called?",
    "hint": "Searching free space.",
    "choices": [
      {
        "text": "Hashing",
        "correct": false,
        "why": "That proves identity."
      },
      {
        "text": "Journaling, which replays the file system's journal to bring back what was deleted",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Carving",
        "correct": true,
        "why": "Right. Content found by its shape, not by the inode."
      },
      {
        "text": "Imaging",
        "correct": false,
        "why": "Lesson 16."
      }
    ]
  },
