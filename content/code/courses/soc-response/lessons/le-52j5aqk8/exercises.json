  {
    "id": "ex-cf760vw4",
    "version": 1,
    "section": "the-working-copy",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does the working copy protect?",
    "hint": "The cost of a mistake.",
    "choices": [
      {
        "text": "Disk space on the machine",
        "correct": false,
        "why": "It uses more, not less."
      },
      {
        "text": "The server",
        "correct": false,
        "why": "The server is already imaged."
      },
      {
        "text": "The analyst's computer from whatever malicious software might be hidden in the image",
        "correct": false,
        "why": "Not its purpose here."
      },
      {
        "text": "The stored image",
        "correct": true,
        "why": "Right. A mistake costs one more cp."
      }
    ]
  },
  {
