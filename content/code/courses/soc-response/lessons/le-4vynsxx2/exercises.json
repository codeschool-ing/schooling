    "difficulty": "hard",
    "drillable": true,
    "prompt": "Under the RCIS, is meeting one criterion enough on its own?",
    "hint": "And, at the same time.",
    "choices": [
      {
        "text": "Only for sensitive data",
        "correct": false,
        "why": "Same rule for all."
      },
      {
        "text": "No; at least three criteria must be met before any incident has to be communicated",
        "correct": false,
        "why": "One is enough, with significance."
      },
      {
        "text": "No; it must also be able to affect rights significantly",
        "correct": true,
        "why": "Right. Both together."
      },
      {
        "text": "Yes, always",
        "correct": false,
        "why": "The criteria are cumulative with the significance test."
      }
    ]
  },
