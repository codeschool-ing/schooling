  {
    "id": "ex-0e3s2wyg",
    "version": 1,
    "section": "the-fields",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "When should a ticket be written?",
    "hint": "What is forgotten first?",
    "choices": [
      {
        "text": "At the end, once it is solved",
        "correct": false,
        "why": "Failures are forgotten."
      },
      {
        "text": "The next morning, with a fresh head",
        "correct": false,
        "why": "Even more is forgotten."
      },
      {
        "text": "Only if the user asks for it",
        "correct": false,
        "why": "Always."
      },
      {
        "text": "As you go",
        "correct": true,
        "why": "Right. What failed is forgotten first."
      }
    ]
  },
  {
