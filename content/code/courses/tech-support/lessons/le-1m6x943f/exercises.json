        "why": "They need the times too."
      }
    ]
  },
  {
    "id": "ex-2dmx3k38",
    "version": 1,
    "section": "why-record",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How do ten tickets become one problem with a cause?",
    "hint": "Words that can be found.",
    "choices": [
      {
        "text": "They are all closed on the same day",
        "correct": false,
        "why": "Dates are not causes."
      },
      {
        "text": "The same technician works them",
        "correct": false,
        "why": "Memory is not a record."
      },
      {
        "text": "They get merged by the system",
        "correct": false,
        "why": "Only if the words match."
      },
      {
        "text": "Each names the cause the same way",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
