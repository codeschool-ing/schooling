  {
    "id": "ex-3mq28fnq",
    "version": 1,
    "section": "why-record",
    "type": "multiple-choice",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Who reads a ticket after it is written? Choose all that apply.",
    "hint": "People who were not in it.",
    "choices": [
      {
        "text": "The next technician",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The user, and maybe their manager",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Whoever measures the service",
        "correct": true,
        "why": "Right. Lesson 6."
      },
      {
        "text": "Nobody; it is closed",
        "correct": false,
        "why": "Closed tickets are read."
      }
    ]
  },
  {
    "id": "ex-sbscgnae",
    "version": 1,
    "section": "why-record",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "A ticket says only \"fixed\". Whom does it serve?",
