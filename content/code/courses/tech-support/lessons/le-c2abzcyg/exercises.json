  {
    "id": "ex-f45ws23m",
    "version": 1,
    "section": "when-to-escalate",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which are reasons to escalate? Choose all that apply.",
    "hint": "Section 02's list.",
    "choices": [
      {
        "text": "It needs access you do not have",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Your time-box ran out",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It looks like a security incident",
        "correct": true,
        "why": "Right. Immediately."
      },
      {
        "text": "The user was rude on the phone",
        "correct": false,
        "why": "Not a technical reason."
      }
    ]
  },
  {
    "id": "ex-0b3j2mnz",
    "version": 1,
    "section": "when-to-escalate",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why set a time-box at the start of a ticket?",
    "hint": "An afternoon disappears.",
    "choices": [
      {
        "text": "Because the SLA requires one",
        "correct": false,
        "why": "The SLA sets targets, not this."
      },
      {
        "text": "To finish faster by rushing through the steps",
        "correct": false,
        "why": "It is about handing over."
      },
      {
        "text": "So one ticket doesn't eat the afternoon",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "So the user knows the price",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-8kzn9wz3",
    "version": 1,
    "section": "when-to-escalate",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Something looks like a security incident. When is it escalated?",
    "hint": "Before any time-box.",
    "choices": [
      {
        "text": "After the time-box runs out",
        "correct": false,
        "why": "Before it."
      },
      {
        "text": "At once",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Once you have proof it is an attack",
        "correct": false,
        "why": "Looks like is enough."
      },
      {
        "text": "At the end of the day, in the report",
        "correct": false,
        "why": "Too late."
      }
    ]
  },
  {
    "id": "ex-hkmwbs83",
    "version": 1,
    "section": "when-to-escalate",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A level 1 technician keeps a ticket for a day that level 2 would solve in ten minutes. What is that?",
    "hint": "Not escalating is a decision.",
    "choices": [
      {
        "text": "Good ownership of the ticket",
        "correct": false,
        "why": "Ownership includes handing over."
      },
      {
        "text": "A worse service than an early handover",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The normal way to learn",
        "correct": false,
        "why": "At the user's cost."
      },
      {
        "text": "A breach of the rules",
        "correct": false,
        "why": "A bad choice, not a rule."
      }
    ]
  },
  {
    "id": "ex-t23jzeb2",
    "version": 1,
    "section": "the-symptom",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does 502 from the web server say?",
    "hint": "I am here, and...",
    "choices": [
      {
        "text": "It is up; what is behind it did not answer",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The web server itself is down",
        "correct": false,
        "why": "It answered 502."
      },
      {
        "text": "The page does not exist",
        "correct": false,
        "why": "That is 404."
      },
      {
        "text": "The user needs to log in",
        "correct": false,
        "why": "That is 401."
      }
    ]
  },
  {
    "id": "ex-drhycs1k",
    "version": 1,
    "section": "what-you-can-see",
