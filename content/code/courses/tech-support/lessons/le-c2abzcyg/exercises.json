        ],
        "ignore_case": true,
        "ignore_accents": true
      }
    ]
  },
  {
    "id": "ex-bkjahv09",
    "version": 1,
    "section": "what-you-can-see",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "connect() failed (111: Connection refused). What does that say?",
    "hint": "Refused, not silent.",
    "choices": [
      {
        "text": "The network is down",
        "correct": false,
        "why": "It is 127.0.0.1, the same machine."
      },
      {
        "text": "The password was wrong",
        "correct": false,
        "why": "No login happened."
      },
      {
        "text": "The disk is full",
        "correct": false,
        "why": "No."
      },
      {
        "text": "No listener there",
        "correct": true,
        "why": "Right. ss agreed."
      }
    ]
  },
  {
    "id": "ex-k37rgry1",
    "version": 1,
    "section": "what-you-can-see",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why could sales-api not read /etc/sales/api.conf?",
    "hint": "Owner, mode, user.",
    "choices": [
      {
        "text": "It is root's with 600, and it runs as sales",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The file does not exist",
        "correct": false,
        "why": "ls listed it."
      },
      {
        "text": "The file is empty",
        "correct": false,
        "why": "9 bytes."
      },
      {
        "text": "sales-api runs as root",
        "correct": false,
        "why": "User=sales."
      }
    ]
  },
  {
    "id": "ex-yywrvsva",
    "version": 1,
    "section": "what-you-can-see",
