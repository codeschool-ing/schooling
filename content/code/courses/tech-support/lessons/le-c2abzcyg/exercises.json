  {
    "id": "ex-r18x9h34",
    "version": 1,
    "section": "why-not-fix-it",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The technician has sudo and could fix the permission in a second. Why not?",
    "hint": "Access is not authority.",
    "choices": [
      {
        "text": "sudo does not work on /etc",
        "correct": false,
        "why": "It does."
      },
      {
        "text": "It is another team's file",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "chmod needs a reboot to take effect",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Level 1 may never use sudo",
        "correct": false,
        "why": "She used it to read."
      }
    ]
  },
