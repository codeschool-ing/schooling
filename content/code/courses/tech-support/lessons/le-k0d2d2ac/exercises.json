    "section": "what-a-runbook-is",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is a runbook?",
    "hint": "Written to be followed.",
    "choices": [
      {
        "text": "An article that explains a subject in depth",
        "correct": false,
        "why": "That is a knowledge base article, lesson 9."
      },
      {
        "text": "The log of every ticket closed in a month",
        "correct": false,
        "why": "No."
      },
      {
        "text": "A contract with a service's supplier",
        "correct": false,
        "why": "No."
      },
      {
        "text": "A written procedure for a recurring problem",
        "correct": true,
        "why": "Right."
      }
    ]
  },
