        "why": "A change with no reason."
      },
      {
        "text": "Restart the print service",
        "correct": false,
        "why": "Not a step here."
      },
      {
        "text": "Stop; use the method",
        "correct": true,
        "why": "Right. Lesson 1."
      },
      {
        "text": "Skip to step 5",
        "correct": false,
        "why": "The runbook does not apply."
      }
    ]
  },
  {
    "id": "ex-mqa56x9v",
    "version": 1,
    "section": "a-runbook",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why tell the user not to send the document again?",
    "hint": "Already waiting.",
    "choices": [
      {
        "text": "Resending damages the printer",
        "correct": false,
        "why": "No."
      },
      {
        "text": "The queue refuses duplicates",
        "correct": false,
        "why": "It would print both."
      },
      {
        "text": "It is probably waiting",
        "correct": true,
        "why": "Right. Two copies otherwise."
      },
      {
        "text": "It would go to PDF",
        "correct": false,
        "why": "No."
      }
    ]
  },
