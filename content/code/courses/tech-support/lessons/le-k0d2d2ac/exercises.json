    "choices": [
      {
        "text": "The jobs were deleted by the jam",
        "correct": false,
        "why": "They were waiting."
      },
      {
        "text": "The queue stays stopped until enabled",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The printer needs new drivers",
        "correct": false,
        "why": "No."
      },
      {
        "text": "The user sent it to PDF",
        "correct": false,
        "why": "That was lesson 2."
      }
    ]
  },
  {
    "id": "ex-eh8jbgp5",
    "version": 1,
    "section": "a-runbook",
    "type": "quiz",
    "difficulty": "hard",
