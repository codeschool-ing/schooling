  {
    "id": "ex-nfvr3b58",
    "version": 1,
    "section": "the-printer",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Without sudo, lpstat showed the job's owner as unknown. Why?",
    "hint": "A default in cupsd.conf.",
    "choices": [
      {
        "text": "Elisa printed without logging in first",
        "correct": false,
        "why": "She was logged in."
      },
      {
        "text": "CUPS hides who printed from other users",
        "correct": true,
        "why": "Right. JobPrivateValues default."
      },
      {
        "text": "The print queue lost its history overnight",
        "correct": false,
        "why": "The history is there."
      },
      {
        "text": "The job failed and has no owner",
        "correct": false,
        "why": "sudo shows elisa."
      }
    ]
  },
  {
    "id": "ex-c83rp1n9",
    "version": 1,
    "section": "the-printer",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is d00001-001 in /var/spool/cups?",
    "hint": "cmp says.",
    "choices": [
      {
        "text": "A log of printer errors",
        "correct": false,
        "why": "No."
      },
      {
        "text": "The printed document",
        "correct": true,
        "why": "Right. Byte for byte."
      },
      {
        "text": "The printer's driver settings",
        "correct": false,
        "why": "No."
      },
      {
        "text": "An empty lock file",
        "correct": false,
        "why": "14 bytes, the letter."
      }
    ]
  },
  {
    "id": "ex-j8wyen7t",
    "version": 1,
    "section": "the-printer",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why use cmp rather than cat to check the copy?",
    "hint": "Nobody had to read it.",
    "choices": [
      {
        "text": "cat cannot read files in the print spool",
        "correct": false,
        "why": "It could, with sudo."
      },
      {
        "text": "cmp is faster on small files",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "It answers without showing the contents",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "cat would delete the spooled copy",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-3wvxw847",
    "version": 1,
    "section": "the-printer",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "cmp printed nothing, and then echo printed identical. What did cmp's silence mean?",
    "hint": "&& runs on success.",
    "choices": [
      {
        "text": "It could not open the file",
        "correct": false,
        "why": "Then echo would not run."
      },
      {
        "text": "It needs -v to print",
        "correct": false,
        "why": "No."
      },
      {
        "text": "They differ only in size",
        "correct": false,
        "why": "Then it would say so."
      },
      {
        "text": "The two files are the same",
        "correct": true,
        "why": "Right."
      }
    ]
  },
