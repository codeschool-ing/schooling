[
  {
    "id": "ex-hcpkxtvx",
    "version": 1,
    "section": "what-sudo-reaches",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Elisa's folder refuses other users. Who can still reach it?",
    "hint": "The capture's second command.",
    "choices": [
      {
        "text": "Anyone who has sudo",
        "correct": true,
        "why": "Right. Support included."
      },
      {
        "text": "Nobody but Elisa",
        "correct": false,
        "why": "sudo ls listed it."
      },
      {
        "text": "Her whole office",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Her manager, by law",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-12ggpf6m",
