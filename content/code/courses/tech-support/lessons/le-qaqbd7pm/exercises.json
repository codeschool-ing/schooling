  {
    "id": "ex-v97j7xvk",
    "version": 1,
    "section": "four-steps",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What carries from one unfamiliar fault to the next?",
    "hint": "Not the answer.",
    "choices": [
      {
        "text": "A list of known answers",
        "correct": false,
        "why": "New faults are not on it."
      },
      {
        "text": "The order you look in",
        "correct": true,
        "why": "Right. The method."
      },
      {
        "text": "Restarting first",
        "correct": false,
        "why": "That skips reproducing."
      },
      {
        "text": "The user's diagnosis",
        "correct": false,
        "why": "A guess, not an observation."
      }
    ]
  },
  {
    "id": "ex-b51ccx90",
    "version": 1,
    "section": "four-steps",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A test changes one thing and the fault stays. What was that result worth?",
    "hint": "The arrow back.",
    "choices": [
      {
        "text": "A suspect gone; back to isolate",
        "correct": true,
        "why": "Right. Undo the change, then look again."
      },
      {
        "text": "Nothing; start again from scratch",
        "correct": false,
        "why": "It ruled something out."
      },
      {
        "text": "It proves the user is wrong",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Make two more changes at once",
        "correct": false,
        "why": "That breaks the rule."
      }
    ]
  },
  {
    "id": "ex-hw5wn2w3",
    "version": 1,
    "section": "reproduce",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why reproduce a fault before anything else?",
    "hint": "A report is a memory.",
    "choices": [
      {
        "text": "To make the user wait",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Because tickets need a screenshot",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "To fix it faster by restarting",
        "correct": false,
        "why": "Nothing is changed yet."
      },
      {
        "text": "To see exactly what fails, not a memory of it",
        "correct": true,
        "why": "Right."
      }
    ]
  },
