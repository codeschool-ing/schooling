    "difficulty": "easy",
    "drillable": true,
    "prompt": "Put the four steps of the method in order.",
    "hint": "See it before you touch it.",
    "items": [
      "Reproduce",
      "Isolate",
      "Test",
      "Confirm"
    ],
    "trap": "Testing before isolating is guessing: the change has no single place to aim at, and a result says nothing about where the fault was."
