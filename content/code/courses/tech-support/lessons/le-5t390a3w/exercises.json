  {
    "id": "ex-k1p8p1cb",
    "version": 1,
    "section": "questions-that-work",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which question is best to ask first?",
    "hint": "Actions and times.",
    "choices": [
      {
        "text": "What were you doing just before it stopped?",
        "correct": true,
        "why": "Right. A timeline without blame."
      },
      {
        "text": "Did you change anything?",
        "correct": false,
        "why": "Sounds like an accusation."
      },
      {
        "text": "Is the printer switched on?",
        "correct": false,
        "why": "Closed questions come last."
      },
      {
        "text": "Have you tried restarting it yet?",
        "correct": false,
        "why": "A change, not a question about facts."
      }
    ]
  },
