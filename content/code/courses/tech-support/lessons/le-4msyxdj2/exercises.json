        "correct": false,
        "why": "No."
      },
      {
        "text": "It sends the rule to every other computer",
        "correct": false,
        "why": "No."
      },
      {
        "text": "sudo ignores files that were not checked",
        "correct": false,
        "why": "It reads them."
      }
    ]
  },
