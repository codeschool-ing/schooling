[
  {
    "id": "ex-061ypcap",
    "version": 1,
    "section": "two-kinds",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A support account with full sudo is asked to install an unapproved program. Which kind of limit applies?",
    "hint": "It could do it.",
    "choices": [
      {
        "text": "The account cannot; sudo refuses",
        "correct": false,
        "why": "Full sudo runs it."
      },
      {
        "text": "None; installing software is always fine",
        "correct": false,
        "why": "Approved list."
      },
      {
        "text": "The user's own limit, not support's",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Possible for the account, not for the role",
        "correct": true,
        "why": "Right. Only the technician is between."
      }
    ]
  },
