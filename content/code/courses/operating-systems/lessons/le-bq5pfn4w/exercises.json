  },
  {
    "id": "ex-43j3tjh0",
    "version": 1,
    "section": "recovery",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A Mac's disk was replaced with a new, empty one. How can macOS still be installed without a USB stick?",
    "hint": "Recovery can come from somewhere else.",
    "choices": [
      {
        "text": "It cannot; a stick is needed",
        "correct": false,
        "why": "Internet Recovery works on an empty disk."
      },
      {
        "text": "Copy the old disk with dd",
        "correct": false,
        "why": "There is no need to."
      },
      {
        "text": "Internet Recovery",
        "correct": true,
        "why": "Right. The Mac downloads it from Apple."
      },
      {
        "text": "From Time Machine only",
        "correct": false,
        "why": "Time Machine restores files, and needs Recovery first."
      }
    ]
  },
  {
    "id": "ex-27cae6xs",
    "version": 1,
    "section": "recovery",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does createinstallmedia do to the USB stick given after --volume?",
    "hint": "Like dd in lesson 3.",
    "choices": [
      {
        "text": "Copies the installer beside your files",
        "correct": false,
        "why": "The stick is erased first."
      },
      {
        "text": "Formats it for Windows",
        "correct": false,
        "why": "It makes a macOS installer."
      },
      {
        "text": "Erases it and makes it an installer",
        "correct": true,
        "why": "Right. It asks once, naming the volume."
      },
      {
        "text": "Checks it for errors",
        "correct": false,
        "why": "That is Disk Utility's First Aid."
      }
    ]
  },
  {
    "id": "ex-13wp076c",
    "version": 1,
    "section": "recovery",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "An Apple silicon Mac will not start, not even into Recovery. What is left?",
    "hint": "It needs a second Mac.",
    "choices": [
