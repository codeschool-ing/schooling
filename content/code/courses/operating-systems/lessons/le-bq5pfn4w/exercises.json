      {
        "text": "It is refused; the volume is read-only",
        "correct": true,
        "why": "Right. Updates replace it whole."
      },
      {
        "text": "The Mac erases itself",
        "correct": false,
        "why": "Nothing is erased."
      },
      {
        "text": "It works until the next restart",
        "correct": false,
        "why": "It never works."
      }
    ]
  },
