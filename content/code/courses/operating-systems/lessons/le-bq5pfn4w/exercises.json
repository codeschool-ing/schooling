  {
    "id": "ex-40g6y3ae",
    "version": 1,
    "section": "the-disk",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "An Apple silicon Mac's disk is always encrypted by the hardware. What does FileVault add?",
    "hint": "Who can unlock it?",
    "choices": [
      {
        "text": "A second, slower encryption",
        "correct": false,
        "why": "The encryption is the same."
      },
      {
        "text": "The key needs a user's password",
        "correct": true,
        "why": "Right. Until somebody signs in, the disk is unreadable."
      },
      {
        "text": "Nothing on Apple silicon",
        "correct": false,
        "why": "It changes who can read the disk."
      },
      {
        "text": "A backup of the key to a USB stick",
        "correct": false,
        "why": "The recovery key is written down or kept by the account."
      }
    ]
  },
  {
    "id": "ex-j9a83b26",
    "version": 1,
    "section": "the-disk",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does erasing a modern Mac take seconds?",
    "hint": "Nothing has to be overwritten.",
    "choices": [
      {
        "text": "Destroying the key does it",
        "correct": true,
        "why": "Right. Without the key, the bytes are unreadable."
      },
      {
        "text": "It skips the files it cannot see",
        "correct": false,
        "why": "Every file becomes unreadable."
      },
      {
        "text": "The disks are very fast",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "It only erases the desktop",
        "correct": false,
        "why": "It erases all the data."
      }
    ]
  },
  {
