  {
    "id": "ex-39a5r4rd",
    "version": 1,
    "section": "handing-over",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The office Mac goes from an employee who left to a new one. Which reset?",
    "hint": "It also signs out.",
    "choices": [
      {
        "text": "Reinstall macOS",
        "correct": false,
        "why": "The old files would still be there."
      },
      {
        "text": "Erase in Disk Utility",
        "correct": false,
        "why": "That leaves Activation Lock on."
      },
      {
        "text": "None; just create a new account",
        "correct": false,
        "why": "The old account and its files remain."
      },
      {
        "text": "Erase All Content and Settings",
        "correct": true,
        "why": "Right. It erases and turns Activation Lock off."
      }
    ]
  },
