[
  {
    "id": "ex-s6vayz57",
    "version": 1,
    "section": "which-mac",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "About This Mac shows a line called Chip. What kind of Mac is it?",
    "hint": "Intel Macs say something else there.",
    "choices": [
      {
        "text": "An Intel Mac from before 2020",
        "correct": false,
        "why": "Intel Macs show Processor."
      },
      {
        "text": "A Mac that cannot be updated",
        "correct": false,
        "why": "The line says nothing about updates."
      },
      {
        "text": "Apple silicon",
        "correct": true,
        "why": "Right. An Intel Mac says Processor."
      },
      {
        "text": "A Mac running Windows",
        "correct": false,
        "why": "It is macOS's own window."
      }
    ]
  },
  {
    "id": "ex-vwvzja1m",
    "version": 1,
    "section": "which-mac",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which macOS has Apple said is the last for Intel Macs?",
    "hint": "The first one numbered by the year.",
    "choices": [
      {
        "text": "Tahoe 26",
        "correct": true,
        "why": "Right. From 2025."
      },
      {
        "text": "Sequoia 15",
        "correct": false,
        "why": "Tahoe came after it and still supports Intel."
      },
      {
        "text": "Sonoma 14",
        "correct": false,
        "why": "Two releases followed it on Intel."
      },
      {
        "text": "None; Intel is supported forever",
        "correct": false,
        "why": "Apple has named the last one."
      }
    ]
  },
  {
    "id": "ex-926sfg97",
    "version": 1,
    "section": "which-mac",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "macOS Sequoia was version 15. Why is the release after it 26 and not 16?",
    "hint": "Look at the year.",
    "choices": [
      {
        "text": "Ten releases were skipped by mistake",
        "correct": false,
        "why": "It was a decision."
      },
      {
        "text": "The number follows the year now",
        "correct": true,
        "why": "Right. Released in 2025, named for the year after."
      },
      {
        "text": "26 is a build number",
        "correct": false,
        "why": "It is the version."
      },
      {
        "text": "Only Intel Macs call it 16",
        "correct": false,
        "why": "Every Mac calls it 26."
      }
    ]
  },
  {
    "id": "ex-e0bmswmp",
    "version": 1,
    "section": "which-mac",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "On a Mac, uname -m prints x86_64. What does that say?",
    "hint": "The other answer is arm64.",
    "choices": [
      {
        "text": "It is running Linux",
        "correct": false,
        "why": "uname exists on macOS too."
      },
      {
        "text": "macOS is 64 times faster",
        "correct": false,
        "why": "It names the architecture."
      },
      {
        "text": "The disk is formatted in x86",
        "correct": false,
        "why": "x86 is a processor family, not a format."
      },
      {
        "text": "It is an Intel Mac",
        "correct": true,
        "why": "Right. Apple silicon prints arm64."
      }
    ]
  },
  {
    "id": "ex-ajc96w4e",
    "version": 1,
    "section": "which-mac",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does reinstalling macOS on an office Mac cost?",
    "hint": "It came with the Mac.",
    "choices": [
      {
        "text": "Nothing",
        "correct": true,
        "why": "Right. Unlike Windows, there is no key."
      },
      {
        "text": "A new licence per Mac",
        "correct": false,
        "why": "macOS has no separate licence to buy."
      },
      {
        "text": "A 25-character product key",
        "correct": false,
        "why": "That is Windows."
      },
      {
        "text": "A yearly subscription",
        "correct": false,
        "why": "There is none for macOS."
      }
    ]
  },
  {
    "id": "ex-sxrvr6fr",
    "version": 1,
    "section": "which-mac",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": false,
    "prompt": "What should Ana find out before resetting the office Mac? Choose all that apply.",
    "hint": "Four questions, one of them not needed.",
    "choices": [
      {
        "text": "Whose Apple Account it is signed into",
        "correct": true,
        "why": "Yes. It decides how it is erased."
      },
      {
        "text": "Whether the data is copied somewhere",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "Whether the chip is Apple silicon or Intel",
        "correct": true,
        "why": "Yes. It changes how Recovery starts."
      },
      {
        "text": "Where the macOS product key is",
        "correct": false,
        "why": "There is no key."
      },
      {
        "text": "Whether the TPM is switched on",
        "correct": false,
        "why": "That is a Windows 11 check."
      }
    ]
  },
  {
