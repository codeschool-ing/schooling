  {
    "id": "ex-dx88nn4p",
    "version": 1,
    "section": "recovery",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is macOS Recovery?",
    "hint": "A small second system.",
    "choices": [
      {
        "text": "A backup of your files",
        "correct": false,
        "why": "That is Time Machine."
      },
      {
        "text": "A repair system built into the Mac",
        "correct": true,
        "why": "Right. Reinstall, Disk Utility, restore."
      },
      {
        "text": "An app from the App Store",
        "correct": false,
        "why": "It is on the disk before anything is installed."
      },
      {
        "text": "A USB stick sold by Apple",
        "correct": false,
        "why": "Nothing has to be plugged in."
      }
    ]
  },
  {
    "id": "ex-qxex4kd7",
    "version": 1,
    "section": "recovery",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How do you reach Recovery on a Mac with Apple silicon?",
    "hint": "One button, held.",
    "choices": [
      {
        "text": "Hold Command-R at start",
        "correct": false,
        "why": "That is for Intel Macs."
      },
      {
        "text": "Press F12 at the logo",
        "correct": false,
        "why": "That is a PC boot menu key."
      },
      {
        "text": "Hold the power button from off",
        "correct": true,
        "why": "Right. Until Loading startup options appears."
      },
      {
        "text": "Type recovery in Terminal",
        "correct": false,
        "why": "No command does it."
      }
    ]
  },
  {
    "id": "ex-52g13w8f",
    "version": 1,
    "section": "recovery",
    "type": "matching",
    "difficulty": "medium",
    "drillable": false,
    "prompt": "Match each Intel key combination to what Recovery installs.",
