  {
    "id": "ex-rm1efh81",
    "version": 1,
    "section": "choosing-the-download",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is a checksum?",
    "hint": "Computed from the exact contents.",
    "choices": [
      {
        "text": "The file's size, on the disk",
        "correct": false,
        "why": "Two different files can have the same size."
      },
      {
        "text": "A fingerprint of its bytes",
        "correct": true,
        "why": "Right. One byte different, a different number."
      },
      {
        "text": "A licence key for the image",
        "correct": false,
        "why": "Ubuntu needs no key."
      },
      {
        "text": "The speed the download ran at",
        "correct": false,
        "why": "It is about content."
      }
    ]
  },
  {
    "id": "ex-dsg844xs",
    "version": 1,
    "section": "choosing-the-download",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "sha256sum -c SHA256SUMS says download.img: FAILED. What should you do?",
    "hint": "Never assume.",
    "choices": [
      {
        "text": "Download it again",
        "correct": true,
        "why": "Right. And check again."
      },
      {
        "text": "Use it anyway if it opens",
        "correct": false,
        "why": "A damaged or altered image can open fine."
      },
      {
        "text": "Edit SHA256SUMS to match",
        "correct": false,
        "why": "That hides the problem."
      },
      {
        "text": "Rename the file",
        "correct": false,
        "why": "The name does not change the contents."
      }
    ]
  },
