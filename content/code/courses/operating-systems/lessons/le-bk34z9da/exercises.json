    "hint": "Look at of=.",
    "choices": [
      {
        "text": "It takes a long time to start",
        "correct": false,
        "why": "Speed is not the danger."
      },
      {
        "text": "It never asks before overwriting",
        "correct": true,
        "why": "Right. The wrong device means an erased disk."
      },
      {
        "text": "It needs an internet connection",
        "correct": false,
        "why": "It copies locally."
      },
      {
        "text": "It only runs on a Windows machine",
        "correct": false,
        "why": "It is a Linux and macOS command."
      }
    ]
  },
  {
    "id": "ex-m7x9erah",
    "version": 1,
    "section": "the-installer",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "When writing an ISO with dd, which target is right: /dev/sdX or /dev/sdX1?",
    "hint": "The image contains its own partitions.",
    "choices": [
      {
        "text": "/dev/sdX, the whole stick",
        "correct": true,
        "why": "Right. The ISO brings its own partitions."
      },
      {
        "text": "/dev/sdX1, the first partition",
        "correct": false,
        "why": "The image has its own partition table and goes on the whole stick."
      },
      {
        "text": "Either; dd adjusts",
        "correct": false,
        "why": "dd adjusts nothing."
      },
      {
        "text": "Neither; use /dev/null",
        "correct": false,
        "why": "That discards everything."
      }
    ]
  },
