    "version": 1,
    "section": "where-it-stops",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A PC works in safe mode and fails in a normal start. What does that point to?",
    "hint": "What did safe mode leave out?",
    "choices": [
      {
        "text": "A fault in the hardware itself",
        "correct": false,
        "why": "Safe mode uses the same hardware."
      },
      {
        "text": "The disk is empty now",
        "correct": false,
        "why": "It started."
      },
      {
        "text": "What safe mode skips",
        "correct": true,
        "why": "Right. A driver, a service, a startup program."
      },
      {
        "text": "The firmware",
        "correct": false,
        "why": "That runs in both."
      }
    ]
  },
