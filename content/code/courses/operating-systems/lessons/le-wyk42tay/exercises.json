  {
    "id": "ex-jbqg6r7a",
    "version": 1,
    "section": "reading-the-journal",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A server restarted unexpectedly overnight. Which journal lines matter most?",
    "hint": "The last ones it wrote.",
    "choices": [
      {
        "text": "The start of this boot",
        "correct": false,
        "why": "That is after the restart."
      },
      {
        "text": "The end of the previous boot",
        "correct": true,
        "why": "Right. journalctl -b -1."
      },
      {
        "text": "Only cron's",
        "correct": false,
        "why": "Filter by time, not one unit."
      },
      {
        "text": "None; restarts leave no trace",
        "correct": false,
        "why": "The journal keeps the previous boot."
      }
    ]
  },
