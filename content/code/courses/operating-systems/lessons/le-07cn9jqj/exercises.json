  },
  {
    "id": "ex-sp3tyady",
    "version": 1,
    "section": "what-a-distribution-is",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "VERSION_CODENAME=noble. Why does the first letter help?",
    "hint": "Ubuntu's names follow an order.",
    "choices": [
      {
        "text": "It is the edition",
        "correct": false,
        "why": "Ubuntu has no editions by letter."
      },
      {
        "text": "It sorts by the kernel version",
        "correct": false,
        "why": "It sorts by release."
      },
      {
        "text": "Names go alphabetically",
        "correct": true,
        "why": "Right. So the letter dates it roughly."
      },
      {
        "text": "N means network edition",
        "correct": false,
        "why": "It is just the letter of the name."
      }
    ]
  },
