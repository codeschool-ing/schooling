  {
    "id": "ex-g3dg3pgh",
    "version": 1,
    "section": "what-a-distribution-is",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is a Linux distribution?",
    "hint": "More than the kernel.",
    "choices": [
      {
        "text": "A different kernel from Linux",
        "correct": false,
        "why": "They share the Linux kernel."
      },
      {
        "text": "The kernel plus everything around it",
        "correct": true,
        "why": "Right. Chosen, built and supported by one group."
      },
      {
        "text": "A desktop theme",
        "correct": false,
        "why": "Appearance is a setting."
      },
      {
        "text": "A paid version of Linux",
        "correct": false,
        "why": "Most are free."
      }
    ]
  },
