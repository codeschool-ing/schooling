#!/usr/bin/env python3
# ranks DIR [exam]: per choice question, the correct option's length rank (1 = longest) in en and pt
import json, sys, pathlib
d = pathlib.Path(sys.argv[1]); n = sys.argv[2] if len(sys.argv) > 2 else "exercises"
en = json.load(open(d / f"{n}.json")); pt = json.load(open(d / f"{n}.pt.json"))
from collections import Counter
ce, cp = Counter(), Counter()
for e in en:
    if "choices" not in e or e["type"] != "quiz": continue
    def rank(texts):
        L = [len(t) for t in texts]; c = [i for i, x in enumerate(e["choices"]) if x["correct"]][0]
        return sorted(set(L), reverse=True).index(L[c]) + 1, len(texts)
    re_ = rank([c["text"] for c in e["choices"]]); rp = rank([c["text"] for c in pt[e["id"]]["choices"]])
    ce[re_[0]] += 1; cp[rp[0]] += 1
    print(f'{e["id"]} {e.get("section","")[:16]:16} en {re_[0]}/{re_[1]}  pt {rp[0]}/{rp[1]}')
print("en", dict(sorted(ce.items())), "pt", dict(sorted(cp.items())))
