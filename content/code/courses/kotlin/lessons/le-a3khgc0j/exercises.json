  {
    "id": "ex-7wj0hy5s",
    "version": 1,
    "section": "suspend",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Where may a `suspend` function be called from?",
    "hint": "`NotSuspend.kt` was refused.",
    "choices": [
      {
        "text": "Anywhere",
        "correct": false,
        "why": "A plain `main` was refused."
      },
      {
        "text": "Only from `main`",
        "correct": false,
        "why": "A plain `main` was exactly the refused case."
      },
      {
        "text": "Inside a coroutine, or a caller marked the same way",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Only from code running inside a `Thread` that the program started itself",
        "correct": false,
        "why": "Threads are not the requirement."
      }
    ]
  },
  {
    "id": "ex-m9vg90yx",
    "version": 1,
    "section": "suspend",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `delay(300)` do that `Thread.sleep(300)` does not?",
    "hint": "What happens to the thread meanwhile?",
    "choices": [
      {
        "text": "It is more precise about the 300 ms",
        "correct": false,
        "why": "Precision is not the difference."
      },
      {
        "text": "It frees the thread for other coroutines",
        "correct": true,
        "why": "Right: only the coroutine waits."
      },
      {
        "text": "It starts a new thread to do the waiting",
        "correct": false,
        "why": "No thread is created."
      },
      {
        "text": "It can be called from any function",
        "correct": false,
        "why": "It is `suspend`, so it cannot."
      }
    ]
  },
  {
    "id": "ex-8gmnzh2m",
    "version": 1,
    "section": "suspend",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why can a plain function not call a `suspend` one?",
    "hint": "What does the compiler add to every `suspend` function?",
    "choices": [
      {
        "text": "Plain functions run on a different JVM",
        "correct": false,
        "why": "There is one JVM."
      },
      {
        "text": "`suspend` functions are private by default",
        "correct": false,
        "why": "They are public by default."
      },
      {
        "text": "The library forbids it at run time",
        "correct": false,
        "why": "The compiler refuses it."
      },
      {
        "text": "It has no continuation to pass in",
        "correct": true,
        "why": "Right: the hidden parameter."
      }
    ]
  },
