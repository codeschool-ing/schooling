  {
    "id": "ex-5zjrvkg2",
    "version": 1,
    "section": "extension-properties",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "An extension needs the class's private list to work. What does the section say?",
    "hint": "What can an extension see?",
    "choices": [
      {
        "text": "Mark the extension `internal`",
        "correct": false,
        "why": "`internal` does not open `private` members."
      },
      {
        "text": "Use reflection",
        "correct": false,
        "why": "That is breaking the class's promise."
      },
      {
        "text": "It should be a member",
        "correct": true,
        "why": "Right: extensions see only the public API."
      },
      {
        "text": "Make the list public",
        "correct": false,
        "why": "That gives everybody what one function needed."
      }
    ]
  },
