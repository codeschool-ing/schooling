  {
    "id": "ex-p5a20xae",
    "version": 1,
    "section": "extension-functions",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A class has `fun label() = \"member\"` and a file declares `fun Session.label() = \"extension\"`. What does `Session().label()` return?",
    "hint": "Who wins?",
    "choices": [
      {
        "text": "`extension`, the most recent declaration",
        "correct": false,
        "why": "Order of declaration is not the rule."
      },
      {
        "text": "A compile error",
        "correct": false,
        "why": "It compiled, with a warning."
      },
      {
        "text": "`member`",
        "correct": true,
        "why": "Right: a member always wins."
      },
      {
        "text": "Whichever is in the same file as the call",
        "correct": false,
        "why": "A member beats every extension."
      }
