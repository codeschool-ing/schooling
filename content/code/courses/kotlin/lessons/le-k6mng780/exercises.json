    "section": "extension-functions",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "`val r: Reminder = ExamReminder()`, with extensions `Reminder.kind()` and `ExamReminder.kind()`. What does `r.kind()` return?",
    "hint": "Resolved at compile time.",
    "choices": [
