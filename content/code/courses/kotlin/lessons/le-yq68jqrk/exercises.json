  {
    "id": "ex-8h4tc95c",
    "version": 1,
    "section": "flow-on",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`flow { … }.map { … }.flowOn(Dispatchers.IO).collect { … }`. Where does the `collect` lambda run?",
    "hint": "`flowOn` affects what is above it.",
    "choices": [
      {
        "text": "On an IO worker",
        "correct": false,
        "why": "Only the `flow` block and `map` moved."
      },
      {
        "text": "On the collector's own dispatcher",
        "correct": true,
        "why": "Right: `main` in the example."
      },
      {
        "text": "On a new thread for each value",
        "correct": false,
        "why": "No thread is created per value."
      },
      {
        "text": "Where the last value came from",
        "correct": false,
        "why": "The collector does not move."
      }
    ]
  },
  {
    "id": "ex-vsjap17r",
    "version": 1,
    "section": "flow-on",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why is `withContext(Dispatchers.IO) { emit(45) }` inside `flow { … }` refused at run time?",
    "hint": "`Flow invariant is violated`.",
    "choices": [
      {
        "text": "`emit` cannot be called inside `withContext` because `emit` is not a suspending function",
        "correct": false,
        "why": "`emit` is suspending; the rule is about where."
      },
      {
        "text": "A flow must emit from the collector's coroutine",
        "correct": true,
        "why": "Right: use `flowOn`."
      },
      {
        "text": "IO threads cannot produce `Int` values",
        "correct": false,
        "why": "Not a rule."
      },
      {
        "text": "The compiler forgot to check it",
        "correct": false,
        "why": "It is a run-time rule by design."
      }
    ]
  },
