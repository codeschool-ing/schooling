[
  {
    "id": "ex-xgn2py4d",
    "version": 1,
    "section": "object-declaration",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`Planner.kt` printed `start` before `Planner created`. When is an `object` built?",
    "hint": "Look at the order of the lines.",
    "choices": [
      {
        "text": "When the program starts",
        "correct": false,
        "why": "`start` came first."
      },
      {
        "text": "The first time it is used",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Each time its name is written",
        "correct": false,
        "why": "It is built once: `Planner === Planner` was `true`."
      },
      {
        "text": "When the compiler finishes building the jar",
        "correct": false,
        "why": "Objects exist at run time only."
      }
    ]
  },
  {
    "id": "ex-4nnyp3fs",
    "version": 1,
    "section": "object-declaration",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why can an `object` not have constructor parameters?",
    "hint": "Who would pass them?",
    "choices": [
      {
        "text": "Nobody calls its constructor",
        "correct": true,
        "why": "Right: the name is the instance, built by the language."
      },
      {
        "text": "Objects cannot hold state",
        "correct": false,
        "why": "`Planner` held a list."
      },
      {
        "text": "Parameters would make it a data class",
        "correct": false,
        "why": "Unrelated."
      },
      {
        "text": "The JVM forbids constructors on singletons",
        "correct": false,
        "why": "The compiled class has a private constructor; the language just never takes arguments for it."
      }
    ]
  },
  {
    "id": "ex-1h41f1f5",
    "version": 1,
    "section": "companion",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Where does Kotlin put what Java would declare `static`?",
    "hint": "Kotlin has no `static` keyword.",
    "choices": [
      {
        "text": "In a `static` block at the end of the class",
        "correct": false,
        "why": "There is no such block."
      },
      {
        "text": "In a separate `object` with the same name",
        "correct": false,
        "why": "That is not how it is done."
      },
      {
        "text": "In a `companion object`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "In top-level functions only",
        "correct": false,
        "why": "Those are an option, but a companion is the one that sees the class's private members."
      }
    ]
  },
  {
