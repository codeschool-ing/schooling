    "drillable": true,
    "prompt": "`Session.of(\"Kotlin\", 45)`, `Session.of(\"Kotlin\", 900)` and `Session.parse(\"Android, 30\")` ran. What did `Session.count` print?",
    "hint": "One of them was refused.",
    "value": 2,
