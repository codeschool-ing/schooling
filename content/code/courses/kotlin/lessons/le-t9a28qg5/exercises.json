    "drillable": true,
    "prompt": "Why is `sessions` a `MutableStateFlow` changed with `update`?",
    "hint": "Several threads.",
    "choices": [
      {
        "text": "So the list survives a restart",
        "correct": false,
        "why": "It is lost on restart."
      },
      {
        "text": "Because Ktor can only serialize flows",
        "correct": false,
        "why": "It sent `.value`, a list."
      },
      {
        "text": "To make the responses arrive in the order the requests were sent by curl",
        "correct": false,
        "why": "Order is not its job."
      },
      {
        "text": "Two POSTs at once must both count",
        "correct": true,
        "why": "Right."
      }
    ]
