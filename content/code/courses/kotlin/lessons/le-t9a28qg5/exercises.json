      {
        "text": "The body could not become a `Session`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "curl added a default of 0 for the missing field before it sent the request",
        "correct": false,
        "why": "curl sent exactly that body."
      },
      {
        "text": "Netty refuses short bodies",
        "correct": false,
        "why": "Length is not checked."
      }
