  {
    "id": "ex-08zmt66h",
    "version": 1,
    "section": "toolchain",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The planner, built with `jvmToolchain(21)`, is started on a Java 17 runtime. What happens?",
    "hint": "A JVM refuses newer class files.",
    "choices": [
      {
        "text": "It runs, more slowly",
        "correct": false,
        "why": "It does not start."
      },
      {
        "text": "`UnsupportedClassVersionError`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Gradle recompiles it for 17 on the user's machine the first time it starts",
        "correct": false,
        "why": "The user has no Gradle."
      },
      {
        "text": "It runs normally",
        "correct": false,
        "why": "Class version 65 needs Java 21."
      }
    ]
  },
  {
    "id": "ex-6c56fqcq",
    "version": 1,
    "section": "toolchain",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "How should a project choose its `jvmToolchain` number?",
    "hint": "Where does the bytecode run?",
    "choices": [
      {
        "text": "The newest JDK released",
        "correct": false,
        "why": "Users may not have it."
      },
      {
        "text": "Whatever JDK the developer's laptop happens to have installed right now",
        "correct": false,
        "why": "That is an accident."
      },
      {
        "text": "By the oldest Java version the program will meet on the machines where it runs",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The same as the Kotlin version",
        "correct": false,
        "why": "They are unrelated numbers."
      }
    ]
  },
  {
    "id": "ex-3km2qyab",
    "version": 1,
    "section": "version-catalog",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What problem does `gradle/libs.versions.toml` solve?",
    "hint": "Several modules, one upgrade.",
    "choices": [
      {
        "text": "It downloads dependencies faster",
        "correct": false,
        "why": "Downloads are the same."
      },
      {
        "text": "Each version is written once",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It removes the need for a `repositories` block anywhere in the build",
        "correct": false,
        "why": "Repositories are still declared."
      },
      {
        "text": "It replaces `build.gradle.kts`",
        "correct": false,
        "why": "The script still exists."
      }
    ]
  },
