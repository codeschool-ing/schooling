  {
    "id": "ex-7wag1b0p",
    "version": 1,
    "section": "modules",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does the root `build.gradle.kts` say `alias(libs.plugins.kotlin.jvm) apply false`?",
    "hint": "The root has no code.",
    "choices": [
      {
        "text": "To turn the Kotlin plugin off for the whole build",
        "correct": false,
        "why": "The modules apply it."
      },
      {
        "text": "To load one version for every module",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Because the root project must be written in Java",
        "correct": false,
        "why": "No such rule."
      },
      {
        "text": "It makes the build faster by skipping the root module's tests",
        "correct": false,
        "why": "The root has none."
      }
    ]
  },
  {
