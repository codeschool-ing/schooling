  },
  {
    "id": "ex-1sq6qf0c",
    "version": 1,
    "section": "build-script",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The report shows `kotlin-stdlib:2.2.20 -> 2.4.21`. What happened?",
    "hint": "One classpath, one version.",
    "choices": [
      {
        "text": "Both versions are on the classpath, and the JVM picks the newer one each time",
        "correct": false,
        "why": "Only one can be."
      },
      {
        "text": "The download of 2.2.20 failed",
        "correct": false,
        "why": "Nothing failed."
      },
      {
        "text": "Gradle chose the highest version requested",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "2.2.20 is a typo in the build script",
        "correct": false,
        "why": "A library asked for it."
      }
    ]
  },
  {
    "id": "ex-618p1atv",
    "version": 1,
    "section": "build-script",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which file says what a build is made of, including its modules?",
    "hint": "Two kinds of script.",
    "choices": [
      {
        "text": "`settings.gradle.kts`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`build.gradle.kts`",
        "correct": false,
        "why": "That builds one project."
      },
      {
        "text": "`gradle-wrapper.properties`",
        "correct": false,
        "why": "That pins Gradle."
      },
      {
        "text": "`gradle/libs.versions.toml`, which lists the libraries",
        "correct": false,
        "why": "It names versions, not modules."
      }
    ]
  },
  {
