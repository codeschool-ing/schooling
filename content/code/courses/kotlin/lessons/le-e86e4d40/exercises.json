  {
    "id": "ex-5ydwrr0v",
    "version": 1,
    "section": "build-script",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each configuration to where the dependency is visible.",
    "hint": "The table in section 03.",
