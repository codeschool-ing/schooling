      {
        "left": "`implementation`",
        "right": "Compiling and running this project"
      },
      {
        "left": "`runtimeOnly`",
        "right": "Running only"
      },
      {
        "left": "`compileOnly`",
        "right": "Compiling only"
      },
      {
        "left": "`testImplementation`",
        "right": "The tests only"
      }
