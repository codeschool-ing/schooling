[
  {
    "id": "ex-hq7bem46",
    "version": 1,
    "section": "wrapper",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does `./gradlew` do that `gradle` does not?",
    "hint": "Look at `distributionUrl`.",
    "choices": [
      {
        "text": "It runs faster, because it skips the configuration phase of the build",
        "correct": false,
        "why": "Same phases."
      },
      {
        "text": "It runs the exact Gradle version the project names, downloading it the first time",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It works without Java",
        "correct": false,
        "why": "Gradle runs on a JVM."
      },
      {
        "text": "It builds only the tests",
        "correct": false,
        "why": "It runs any task."
      }
    ]
  },
  {
    "id": "ex-3c3dnyvg",
    "version": 1,
    "section": "wrapper",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`./gradlew --version` says `Kotlin: 2.4.10`, and the build script says `2.4.21`. Which compiles the planner?",
    "hint": "One of them runs the build scripts.",
    "choices": [
      {
        "text": "2.4.10, the one Gradle ships with",
        "correct": false,
        "why": "That one runs `.gradle.kts` files."
      },
      {
        "text": "2.4.21",
        "correct": true,
        "why": "Right: the plugin's."
      },
      {
        "text": "Whichever is newer, chosen when the build starts",
        "correct": false,
        "why": "Each has its own job."
      },
      {
        "text": "Neither; `kotlinc` from the PATH does",
        "correct": false,
        "why": "Gradle does not use it."
      }
    ]
  },
  {
    "id": "ex-0prx91m0",
    "version": 1,
    "section": "wrapper",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which of these belongs in version control?",
    "hint": "Everything needed to download the same Gradle.",
    "choices": [
      {
        "text": "`build/`",
        "correct": false,
        "why": "Produced by the build."
      },
      {
        "text": "`.gradle/`",
        "correct": false,
        "why": "A local cache."
      },
      {
        "text": "`gradle/wrapper/gradle-wrapper.properties`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`~/.gradle/wrapper/dists`",
        "correct": false,
        "why": "That is the download, outside the project."
      }
    ]
