      {
        "text": "When it returns `true`",
        "correct": false,
        "why": "It returns `Unit`."
      },
      {
        "text": "When it prints `PASSED`",
        "correct": false,
        "why": "Gradle prints that."
      },
      {
        "text": "When it returns without throwing",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "When at least one assertion inside it has been called",
        "correct": false,
        "why": "A test with none passes too."
      }
    ]
  },
