      {
        "text": "It keeps the test library off the classpath of what `./gradlew run` starts",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It makes the tests run in parallel, one class per thread",
        "correct": false,
        "why": "Nothing about parallelism."
      },
      {
        "text": "Nothing; the two are the same",
        "correct": false,
        "why": "Their classpaths differ."
      }
    ]
  },
  {
