[
  {
    "id": "ex-qecxh7q6",
    "version": 1,
    "section": "scopes",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "When does `coroutineScope { … }` return?",
    "hint": "Structured concurrency.",
    "choices": [
      {
        "text": "As soon as its block's last line has run",
        "correct": false,
        "why": "It also waits for every coroutine the block started."
      },
      {
        "text": "When every child has finished",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Immediately, leaving its children running in the background",
        "correct": false,
        "why": "That is the leak a scope exists to prevent."
      },
      {
        "text": "After a timeout of one second",
        "correct": false,
        "why": "There is no built-in timeout."
      }
    ]
  },
  {
    "id": "ex-hgvejzhk",
    "version": 1,
    "section": "scopes",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "In the tree of jobs, which way does each travel?",
    "hint": "The figure at the end of section 02.",
    "choices": [
      {
        "text": "Both up",
        "correct": false,
        "why": "Cancellation goes to the children."
      },
      {
        "text": "Both down",
        "correct": false,
        "why": "A failure goes to the parent."
      },
      {
        "text": "Failure up, cancellation down",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Failure down to every child, cancellation up to the root of the tree",
        "correct": false,
        "why": "The other way round."
      }
    ]
  },
  {
    "id": "ex-jj1hcjpj",
    "version": 1,
    "section": "cancellation",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did the busy loop run to the end after `cancelAndJoin()`?",
    "hint": "When does a coroutine check for cancellation?",
    "choices": [
      {
        "text": "It ran on `Dispatchers.Default`, which cannot be cancelled",
        "correct": false,
        "why": "The polite loop ran there too and stopped."
      },
      {
        "text": "It never suspended, so it never checked",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`cancelAndJoin` only cancels after joining",
        "correct": false,
        "why": "It cancels first."
      },
      {
        "text": "Its `println` was inside a `finally`",
        "correct": false,
        "why": "There was no `finally` in it."
      }
    ]
  },
  {
    "id": "ex-eh4g3kgp",
    "version": 1,
    "section": "cancellation",
    "type": "cloze",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A long loop that never suspends can call `___()` to stop at the next pass once cancelled.",
