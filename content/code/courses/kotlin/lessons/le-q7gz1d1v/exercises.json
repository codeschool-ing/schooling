  {
    "id": "ex-bxsrchdv",
    "version": 1,
    "section": "drill",
    "type": "multiple-choice",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Which of these let cancellation through? Choose all that apply.",
    "hint": "Catch only what the block really throws.",
    "choices": [
      {
        "text": "`try { delay(100) } catch (e: java.io.IOException) { }`",
        "correct": true,
        "why": "Yes: `CancellationException` is not an `IOException`."
      },
      {
        "text": "`runCatching { delay(100) }`",
        "correct": false,
        "why": "No: it catches everything."
      },
      {
        "text": "`try { delay(100) } catch (e: Exception) { }`",
        "correct": false,
        "why": "No: `CancellationException` is an `Exception`."
      },
      {
        "text": "`try { delay(100) } catch (e: Exception) { if (e is CancellationException) throw e }`",
        "correct": true,
        "why": "Yes: it rethrows the cancellation."
      }
    ]
  },
