    "section": "require-check",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`stop(at)` is called on a timer that was never started. Which guard fits?",
    "hint": "Whose mistake: the argument, or the state?",
    "choices": [
      {
        "text": "`require`, as `at` is wrong",
        "correct": false,
        "why": "`at` is fine; the timer's state is not."
      },
      {
        "text": "`check`",
        "correct": true,
        "why": "Right: the object is in the wrong state."
      },
      {
        "text": "`error`, since the line is unreachable",
        "correct": false,
        "why": "The line is reachable; the call is a misuse."
      },
      {
        "text": "No guard: return 0",
        "correct": false,
        "why": "That hides a misuse of the timer."
      }
    ]
  },
