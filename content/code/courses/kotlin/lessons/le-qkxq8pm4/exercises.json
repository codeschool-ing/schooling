  {
    "id": "ex-qpfxtb8m",
    "version": 1,
    "section": "try-catch",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`minutesOrZero(\"forty\")` has a `catch` returning `0` and a `finally` printing a line. What does it return?",
    "hint": "A `finally`'s value is ignored.",
    "choices": [
      {
        "text": "0",
        "correct": true,
        "why": "Right: the catch's last expression."
      },
      {
        "text": "`Unit`, the value of the `finally` block",
        "correct": false,
        "why": "Ignored."
      },
      {
        "text": "Nothing; it throws after `finally`",
        "correct": false,
        "why": "The `catch` handled it."
      },
      {
        "text": "`null`",
        "correct": false,
        "why": "The type is `Int`."
      }
    ]
  },
  {
    "id": "ex-y7qzshqg",
    "version": 1,
    "section": "try-catch",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "`minutesOrZero(null)` with `text!!` inside and `catch (e: Exception)` returned `0`. What is wrong with that?",
    "hint": "Was `null` expected input?",
    "choices": [
      {
        "text": "Nothing: 0 is a sensible default for missing minutes",
        "correct": false,
        "why": "The `null` was a bug elsewhere, now hidden."
      },
      {
        "text": "A bug was silenced as if it were bad input",
        "correct": true,
        "why": "Right: catch only the exception you expect."
      },
      {
        "text": "`!!` cannot be used inside `try`",
        "correct": false,
        "why": "It can."
      },
      {
        "text": "`Exception` does not include `NullPointerException`",
        "correct": false,
        "why": "It does, which is the problem."
      }
    ]
  },
  {
    "id": "ex-cfh7ses1",
    "version": 1,
    "section": "try-catch",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Two `catch` blocks: `catch (e: Exception)` first, `catch (e: NumberFormatException)` second. What happens to a `NumberFormatException`?",
    "hint": "Tried in order.",
    "choices": [
      {
        "text": "The specific one runs, as it matches best",
        "correct": false,
        "why": "Order decides, not fit."
      },
      {
        "text": "Both run",
        "correct": false,
        "why": "Only the first match runs."
      },
      {
        "text": "The `Exception` block takes it",
        "correct": true,
        "why": "Right: put specific ones first."
      },
      {
        "text": "Neither: the exception escapes",
        "correct": false,
        "why": "It is caught by the first."
      }
    ]
  },
  {
