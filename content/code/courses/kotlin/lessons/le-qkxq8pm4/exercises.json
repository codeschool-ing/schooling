      {
        "text": "Before the exception reaches the `catch`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "When the program ends",
        "correct": false,
        "why": "It closed immediately."
      },
      {
        "text": "After the `catch` block runs",
        "correct": false,
        "why": "`close` printed first."
      }
    ]
  },
