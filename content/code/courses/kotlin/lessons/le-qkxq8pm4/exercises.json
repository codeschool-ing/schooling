  {
    "id": "ex-q3c8fpfx",
    "version": 1,
    "section": "throwing",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What did Kotlin remove from Java's exceptions?",
    "hint": "Nothing is declared with `throws`.",
    "choices": [
      {
        "text": "The stack trace",
        "correct": false,
        "why": "`Throw.kt` printed one."
      },
      {
        "text": "Checked exceptions",
        "correct": true,
        "why": "Right: no caller is forced to catch."
      },
      {
        "text": "`try` and `catch`",
        "correct": false,
        "why": "Section 03 uses both."
      },
      {
        "text": "The ability to define new exception classes",
        "correct": false,
        "why": "That remains."
      }
    ]
  },
  {
