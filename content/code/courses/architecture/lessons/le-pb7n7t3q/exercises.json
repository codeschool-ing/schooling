      {
        "text": "Teams writing rewrites are less skilled",
        "correct": false,
        "why": "The lesson says it is not about skill."
      },
      {
        "text": "It is first tested on switch-over day",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Facades are too slow to put in front",
        "correct": false,
        "why": "There is no facade in a big bang."
      }
    ]
  },
  {
    "id": "ex-qmya3bzg",
    "version": 1,
    "section": "rewriting-is-the-risk",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "When is the old code for a moved piece deleted?",
