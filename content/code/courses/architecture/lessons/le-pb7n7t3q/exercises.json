    "drillable": true,
    "prompt": "What is the first step of a strangler fig migration?",
    "hint": "Before anything moves.",
    "choices": [
      {
        "text": "Rewrite the most important module",
        "correct": false,
        "why": "Nothing is rewritten yet."
      },
      {
        "text": "A facade in front of the old system",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Copy the whole database to a new server",
        "correct": false,
        "why": "Data moves later, piece by piece."
      },
      {
        "text": "Freeze all changes to the old system",
        "correct": false,
        "why": "The old system keeps changing."
      }
    ]
  },
  {
    "id": "ex-syx5ma9k",
    "version": 1,
    "section": "rewriting-is-the-risk",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does a big-bang rewrite tend to fail?",
    "hint": "When is it first tested for real?",
    "choices": [
      {
        "text": "The new language is always slower",
        "correct": false,
        "why": "Not the reason."
