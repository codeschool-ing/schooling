[
  {
    "id": "ex-gr7835vr",
    "version": 1,
    "section": "why-not-like",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why did `ILIKE '%cafe torrado%'` find nothing?",
    "hint": "Look at the letters.",
    "choices": [
      {
        "text": "The table was empty",
        "correct": false,
        "why": "It had 25 products."
      },
      {
        "text": "`e` is not `é`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`ILIKE` is case-sensitive",
        "correct": false,
        "why": "The `I` makes it insensitive."
      },
      {
        "text": "PostgreSQL needs an index for `ILIKE`",
        "correct": false,
        "why": "It scans without one."
      }
    ]
  },
  {
    "id": "ex-03p09n19",
    "version": 1,
    "section": "why-not-like",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why can `ILIKE '%café%'` not use an ordinary index?",
    "hint": "Where does the pattern start?",
    "choices": [
      {
        "text": "Indexes do not store accented letters",
        "correct": false,
        "why": "They do."
      },
      {
        "text": "`ILIKE` always locks the table",
        "correct": false,
        "why": "It does not lock."
      },
      {
        "text": "No prefix, nothing to look up",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The column is too long",
        "correct": false,
        "why": "Length is not the issue."
      }
    ]
  },
  {
    "id": "ex-akpgp5m3",
    "version": 1,
    "section": "why-not-like",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "For a catalogue of a few hundred products, what does the lesson suggest considering first?",
    "hint": "The database already running.",
    "choices": [
      {
        "text": "A three-node Elasticsearch cluster",
        "correct": false,
        "why": "More than the catalogue needs."
