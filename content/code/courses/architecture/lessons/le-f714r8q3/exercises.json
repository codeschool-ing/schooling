  {
    "id": "ex-wcc68r20",
    "version": 1,
    "section": "the-inverted-index",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does an inverted index map?",
    "hint": "The back of a book.",
    "choices": [
      {
        "text": "Each document to its words",
        "correct": false,
        "why": "That is the table."
      },
      {
        "text": "Each term to the documents containing it",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Each query to its results, cached",
        "correct": false,
        "why": "That is a cache."
      },
      {
        "text": "Each shard to its node",
        "correct": false,
        "why": "That is cluster state."
      }
    ]
  },
  {
    "id": "ex-zvwgycdv",
    "version": 1,
    "section": "the-inverted-index",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does changing the analyser mean reindexing everything?",
    "hint": "When is it applied?",
    "choices": [
      {
        "text": "The analyser is stored in each document",
        "correct": false,
        "why": "Its output is."
      },
      {
        "text": "OpenSearch forbids changing settings",
        "correct": false,
        "why": "Some settings change live."
      },
      {
        "text": "Queries cannot use a new analyser",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "It ran when documents were written",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-wsmxh93p",
    "version": 1,
    "section": "relevance",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did `Café torrado em grãos` rank first for \"café torrado\"?",
    "hint": "Name, both words, rarity.",
    "choices": [
      {
        "text": "It is the cheapest coffee",
        "correct": false,
        "why": "Price is not in the score."
      },
      {
        "text": "It was indexed first",
        "correct": false,
        "why": "Order of indexing does not rank."
      },
      {
        "text": "Both words are in its name",
        "correct": true,
        "why": "Right, and `torr` is rare among names."
      },
      {
        "text": "It has the longest description",
        "correct": false,
        "why": "A long field lowers a match's weight."
      }
    ]
  },
