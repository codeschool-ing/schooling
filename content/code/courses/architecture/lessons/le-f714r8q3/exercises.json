    "prompt": "Why is the number of primary shards fixed when the index is created?",
    "hint": "Lesson 10's modulo.",
    "choices": [
      {
        "text": "Shards cannot be copied",
        "correct": false,
        "why": "Replicas are copies."
      },
      {
        "text": "The shard is hash modulo that number",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Lucene allows one shard per node",
        "correct": false,
        "why": "A node holds many."
      },
      {
        "text": "Replicas depend on it",
        "correct": false,
        "why": "Replicas can change."
      }
    ]
  },
