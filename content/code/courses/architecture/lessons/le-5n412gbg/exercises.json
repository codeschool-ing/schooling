  {
    "id": "ex-j8eq56nf",
    "version": 1,
    "section": "compensations",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "How is a compensation different from a rollback?",
    "hint": "o-3's bank statement.",
    "choices": [
      {
        "text": "It is a new action; the original still happened",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It is faster",
        "correct": false,
        "why": "Speed is not the difference."
      },
      {
        "text": "It erases the original from the database",
        "correct": false,
        "why": "Nothing is erased."
      },
      {
        "text": "It runs only inside one service's transaction",
        "correct": false,
        "why": "It is a step of its own."
      }
    ]
  },
  {
    "id": "ex-0gzbxr4e",
    "version": 1,
    "section": "compensations",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why must `release` and `refund` be idempotent?",
    "hint": "They will be retried.",
    "choices": [
      {
        "text": "So that they can run in parallel",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "A retried compensation must not undo twice",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Because HTTP requires it for POST",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "To make them cheaper",
        "correct": false,
        "why": "Cost is not the point."
      }
    ]
  },
  {
    "id": "ex-fjvhhdkn",
    "version": 1,
    "section": "compensations",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Where should a step that cannot be undone, like sending an e-mail, go?",
    "hint": "After the pivot.",
    "choices": [
      {
        "text": "First, so it is done early",
        "correct": false,
        "why": "Then a later failure cannot unsend it."
      },
      {
        "text": "Before the payment",
        "correct": false,
        "why": "A declined card would leave the e-mail sent."
      },
      {
        "text": "After the step that decides the outcome",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "In a separate saga with no compensations",
        "correct": false,
        "why": "The order still matters."
      }
    ]
  },
