  {
    "id": "ex-rnd6acy0",
    "version": 1,
    "section": "orchestration",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why must a real orchestrator write each step to a database?",
    "hint": "Think about a crash between charge and schedule.",
    "choices": [
      {
        "text": "So the services can read the plan",
        "correct": false,
        "why": "The services never read it."
      },
      {
        "text": "Because HTTP calls are not logged",
        "correct": false,
        "why": "Logging is not the point."
      },
      {
        "text": "To make the steps run faster",
        "correct": false,
        "why": "It makes them a little slower."
      },
      {
        "text": "So it can resume after a crash",
        "correct": true,
        "why": "Right."
      }
    ]
  },
