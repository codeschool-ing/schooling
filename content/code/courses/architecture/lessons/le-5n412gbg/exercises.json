[
  {
    "id": "ex-v1whmrkn",
    "version": 1,
    "section": "no-distributed-commit",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why can the checkout not be one transaction once it spans three services?",
    "hint": "Who owns each database?",
    "choices": [
      {
        "text": "Transactions are slower than sagas",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "Each service owns its database",
        "correct": true,
        "why": "Right: none can roll back another's."
      },
      {
        "text": "HTTP does not allow transactions",
        "correct": false,
        "why": "The protocol is not the reason."
      },
      {
        "text": "PostgreSQL limits transactions to one table",
        "correct": false,
        "why": "It does not."
      }
    ]
  },
  {
    "id": "ex-yevdr0vk",
    "version": 1,
    "section": "no-distributed-commit",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is two-phase commit rarely used between services?",
    "hint": "What do participants hold while they wait?",
    "choices": [
      {
        "text": "It cannot guarantee atomicity",
        "correct": false,
        "why": "That is what it guarantees."
      },
      {
        "text": "It was removed from PostgreSQL",
        "correct": false,
        "why": "`PREPARE TRANSACTION` exists."
      },
      {
        "text": "Locks held while waiting",
        "correct": true,
        "why": "Right, and many systems do not speak it."
      },
      {
        "text": "It needs a message broker",
        "correct": false,
        "why": "It does not."
      }
    ]
  },
  {
    "id": "ex-dny9p0ed",
    "version": 1,
    "section": "no-distributed-commit",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is a saga?",
    "hint": "Garcia-Molina and Salem, 1987.",
    "choices": [
      {
        "text": "A transaction that spans several databases at once",
        "correct": false,
        "why": "That is two-phase commit."
      },
      {
        "text": "Local transactions, each with a compensation",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A long log of every event in a system",
        "correct": false,
        "why": "That is closer to event sourcing."
      },
      {
        "text": "A queue that retries until every step succeeds",
        "correct": false,
        "why": "Not what it is."
      }
    ]
  },
