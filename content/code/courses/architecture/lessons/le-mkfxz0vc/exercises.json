  {
    "id": "ex-7g4dp5z2",
    "version": 1,
    "section": "more-than-one-server",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Without a backplane, why did the client on instance b miss the event?",
    "hint": "Where was it published?",
    "choices": [
      {
        "text": "b was down",
        "correct": false,
        "why": "It answered hello."
      },
      {
        "text": "The WebSocket closed",
        "correct": false,
        "why": "It stayed open for three seconds."
      },
      {
        "text": "Only a heard it",
        "correct": true,
        "why": "Right: a told only its own clients."
      },
      {
        "text": "Redis lost it",
        "correct": false,
        "why": "There was no Redis in the path."
      }
    ]
  },
  {
    "id": "ex-s6j3g3s0",
    "version": 1,
    "section": "more-than-one-server",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "With the backplane on, what does an instance do with an event it receives by `POST`?",
    "hint": "Read `publish`.",
    "choices": [
      {
        "text": "Adds it and forwards it to the other instance",
        "correct": false,
        "why": "It does not add it directly."
      },
      {
        "text": "Publishes it to Redis, which delivers it to all",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Stores it in Redis for clients to poll",
        "correct": false,
        "why": "Clients do not read Redis."
      },
      {
        "text": "Drops it if no client is connected",
        "correct": false,
        "why": "It is still delivered."
      }
    ]
  },
  {
