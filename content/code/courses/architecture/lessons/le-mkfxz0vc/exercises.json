  {
    "id": "ex-5zwyp0vt",
    "version": 1,
    "section": "server-sent-events",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `Last-Event-ID` let an SSE stream do after a dropped connection?",
    "hint": "Resume.",
    "choices": [
      {
        "text": "Send every event again from the first",
        "correct": false,
        "why": "It starts after the last one seen."
      },
      {
        "text": "Start after the last event received",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Skip events that arrived while disconnected",
        "correct": false,
        "why": "Those are the ones it sends."
      },
      {
        "text": "Switch to a WebSocket",
        "correct": false,
        "why": "It stays SSE."
      }
    ]
  },
  {
    "id": "ex-7qzpkfsz",
    "version": 1,
    "section": "server-sent-events",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which of these is a limit of Server-Sent Events?",
    "hint": "Direction.",
    "choices": [
      {
        "text": "It cannot pass through HTTP proxies",
        "correct": false,
        "why": "It is plain HTTP."
      },
      {
        "text": "The browser does not reconnect",
        "correct": false,
        "why": "`EventSource` reconnects."
      },
      {
        "text": "It needs a special port",
        "correct": false,
        "why": "It uses the site's port."
      },
      {
        "text": "It carries text from the server only",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-7787cb7g",
    "version": 1,
    "section": "server-sent-events",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why can several tabs with SSE streams run out of connections on HTTP/1.1, and not on HTTP/2?",
    "hint": "Six per host.",
    "choices": [
      {
        "text": "HTTP/2 compresses events",
        "correct": false,
        "why": "Compression is not the reason."
      },
      {
        "text": "One connection, many streams",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "HTTP/1.1 closes streams after a minute",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "HTTP/2 does not support SSE",
        "correct": false,
        "why": "It does."
      }
    ]
  },
  {
    "id": "ex-hv2a4zb8",
    "version": 1,
    "section": "websockets",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does a WebSocket give that SSE does not?",
    "hint": "Direction.",
    "choices": [
      {
        "text": "Automatic reconnection",
        "correct": false,
        "why": "SSE has it; WebSocket does not."
      },
      {
        "text": "Passing through every proxy",
        "correct": false,
        "why": "The upgrade is sometimes blocked."
      },
      {
        "text": "Messages from the client too",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "HTTP caching",
        "correct": false,
        "why": "It leaves HTTP behind."
      }
    ]
  },
