[
  {
    "id": "ex-9hqn5jg5",
    "version": 1,
    "section": "the-server-cannot-speak-first",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why can a plain HTTP server not tell a page that an order has shipped?",
    "hint": "Who starts every exchange?",
    "choices": [
      {
        "text": "HTTP responses cannot carry JSON",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "Only the client starts an exchange",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Browsers block messages from servers",
        "correct": false,
        "why": "They accept responses."
      },
      {
        "text": "TLS forbids it",
        "correct": false,
        "why": "TLS has nothing to do with it."
      }
    ]
  },
  {
    "id": "ex-bjx03zy6",
    "version": 1,
    "section": "the-server-cannot-speak-first",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each technique to how the browser learns of an event.",
    "hint": "Ask, wait, stream, channel.",
    "pairs": [
      {
        "left": "polling",
        "right": "asks every few seconds"
      },
      {
        "left": "long polling",
        "right": "asks, and the answer is held until there is news"
      },
      {
        "left": "Server-Sent Events",
        "right": "one response that never ends"
      },
      {
        "left": "WebSocket",
        "right": "an upgraded channel both sides send on"
      }
    ]
  },
  {
    "id": "ex-7xs8dvyx",
    "version": 1,
    "section": "the-server-cannot-speak-first",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How does a payment gateway usually tell the shop that a payment settled?",
    "hint": "Server to server.",
    "choices": [
      {
        "text": "A WebSocket from the shop's browser",
        "correct": false,
        "why": "Neither side is a browser."
      },
      {
        "text": "Server-Sent Events to the customer",
        "correct": false,
        "why": "The customer is not involved."
      },
      {
        "text": "A webhook to the shop's URL",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Long polling by the gateway",
        "correct": false,
        "why": "The gateway does not poll the shop."
      }
    ]
  },
  {
