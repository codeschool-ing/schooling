    "section": "antipatterns",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why are these antipatterns invisible on a developer's laptop?",
    "hint": "Where is the database?",
    "choices": [
      {
        "text": "Laptops have faster disks than servers",
        "correct": false,
        "why": "Disks were not the cost."
      },
      {
        "text": "The database is on the same machine",
        "correct": true,
        "why": "Right: round trips cost almost nothing."
      },
      {
        "text": "ORMs behave differently in development",
        "correct": false,
        "why": "The same code runs."
      },
      {
        "text": "Laptops do not run PostgreSQL",
        "correct": false,
        "why": "They do."
      }
    ]
  },
