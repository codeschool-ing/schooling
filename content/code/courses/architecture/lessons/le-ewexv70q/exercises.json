  {
    "id": "ex-k9vg6z1n",
    "version": 1,
    "section": "chatty-io",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How does an ORM usually produce an N+1 query?",
    "hint": "When is a relation loaded?",
    "choices": [
      {
        "text": "By joining every table on every query",
        "correct": false,
        "why": "That is the opposite."
      },
      {
        "text": "By caching too aggressively",
        "correct": false,
        "why": "A cache reduces queries."
      },
      {
        "text": "Lazy loading",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "By retrying failed queries",
        "correct": false,
        "why": "Not the cause."
      }
    ]
  },
  {
    "id": "ex-1a3z61zy",
    "version": 1,
    "section": "chatty-io",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which fix keeps two queries but removes the N?",
    "hint": "`ANY`.",
    "choices": [
      {
        "text": "A join",
        "correct": false,
        "why": "That makes it one query."
      },
      {
        "text": "`WHERE order_id = ANY(...)` with all the ids",
        "correct": true,
        "why": "Right: eager loading."
      },
      {
        "text": "A bigger connection pool",
        "correct": false,
        "why": "The queries stay sequential."
      },
      {
        "text": "An index on `orders.customer`",
        "correct": false,
        "why": "Speeds the first query, not the count."
      }
    ]
  },
