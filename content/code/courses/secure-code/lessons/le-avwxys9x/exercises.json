        "correct": false,
        "why": "That was the intention, not the effect."
      },
      {
        "text": "The whole value",
        "correct": true,
        "why": "Right. Everything lucia typed passed as HTML."
      },
      {
        "text": "Only to line breaks",
        "correct": false,
        "why": "Same as the first answer."
      },
      {
        "text": "Nothing: Jinja ignores safe after replace",
        "correct": false,
        "why": "It honours it."
      }
    ]
  },
