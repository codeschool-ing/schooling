  {
    "id": "ex-gqh46xjy",
    "version": 1,
    "section": "three-kinds",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is stored XSS called the most damaging of the three?",
    "choices": [
      {
        "text": "It needs the victim to follow a link written by somebody else",
        "correct": false,
        "why": "That is reflected."
      },
      {
        "text": "One message reaches everyone who opens the page",
        "correct": true,
        "why": "Right. Nobody has to click anything unusual."
      },
      {
        "text": "It bypasses HTTPS",
        "correct": false,
        "why": "HTTPS is not the subject."
      },
      {
        "text": "It runs on the server",
        "correct": false,
        "why": "It runs in the readers' browsers."
      }
    ]
  },
  {
    "id": "ex-jzk5ehzw",
    "version": 1,
    "section": "three-kinds",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "How does the lesson prove that text became markup?",
    "choices": [
      {
        "text": "With a script that sends cookies to another server",
        "correct": false,
        "why": "No script is used anywhere."
      },
      {
        "text": "By reading the server's log",
        "correct": false,
        "why": "The DOM kind never reaches it."
      },
      {
        "text": "A word in <b> comes out bold",
        "correct": true,
        "why": "Right. The page built an element from the text."
      },
      {
        "text": "By disabling the browser",
        "correct": false,
        "why": "Nothing is disabled."
      }
    ]
  },
  {
