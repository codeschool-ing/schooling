    "section": "dom",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is the difference between `innerHTML` and `textContent`?",
    "choices": [
      {
        "text": "textContent is slower but works in more browsers",
        "correct": false,
        "why": "Not the difference that matters."
      },
      {
        "text": "innerHTML only works on headings",
        "correct": false,
        "why": "It works on any element."
      },
      {
        "text": "The first builds elements; the second never does",
        "correct": true,
        "why": "Right. The DOM's own escaping."
      },
      {
        "text": "None: both escape",
        "correct": false,
        "why": "innerHTML builds elements."
      }
    ]
  },
