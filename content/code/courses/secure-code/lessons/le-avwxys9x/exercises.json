    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does one test read static/inbox.js instead of a response?",
    "choices": [
      {
        "text": "The fragment after # never reaches the server",
        "correct": true,
        "why": "Right. No response could show the DOM flaw."
      },
      {
        "text": "Flask cannot serve JavaScript files",
        "correct": false,
        "why": "It serves static/ by default."
      },
      {
        "text": "Reading files is faster",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "pytest cannot send GET requests",
        "correct": false,
        "why": "The other tests do."
      }
    ]
  },
  {
    "id": "ex-3c8n27b9",
    "version": 1,
    "section": "the-inbox",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does `&lt;b&gt;` in a page show the reader?",
    "choices": [
      {
        "text": "Nothing: the browser hides it as an unknown tag",
        "correct": false,
        "why": "It shows characters."
      },
      {
        "text": "Bold text",
        "correct": false,
        "why": "That is what <b> does as markup."
      },
      {
        "text": "The characters <b>",
        "correct": true,
        "why": "Right. Text, not an element."
      },
      {
        "text": "An error",
        "correct": false,
        "why": "It is valid HTML."
      }
    ]
  },
  {
    "id": "ex-hsk0bpv8",
