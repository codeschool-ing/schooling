    "version": 1,
    "section": "reflected",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What rule from lesson 4 does the reflected fix apply?",
    "choices": [
      {
        "text": "Escape only the characters < and >",
        "correct": false,
        "why": "Context decides, and the template does it."
      },
      {
        "text": "Never echo what the user typed",
        "correct": false,
        "why": "Echoing is fine, as text."
      },
      {
        "text": "Use JSON for every page",
        "correct": false,
        "why": "JSON is for responses that are not pages."
      },
      {
        "text": "HTML comes from the template engine",
        "correct": true,
        "why": "Right. Never by joining strings."
      }
