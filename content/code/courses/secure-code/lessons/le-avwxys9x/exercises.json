  {
    "id": "ex-a44xvjq6",
    "version": 1,
    "section": "stored",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A message editor really needs bold and lists. What does the lesson recommend?",
    "choices": [
      {
        "text": "Mark every message safe",
        "correct": false,
        "why": "That is the flaw."
      },
      {
        "text": "Remove < and > from messages before saving them",
        "correct": false,
        "why": "A list of characters again, and it breaks real text."
      },
      {
        "text": "A sanitiser with an allowlist of tags",
        "correct": true,
        "why": "Right. nh3 on the server, DOMPurify in the browser."
      },
      {
        "text": "Switch off the Content Security Policy for that page",
        "correct": false,
        "why": "The opposite of defence in depth."
      }
    ]
  },
  {
    "id": "ex-9782ebrf",
    "version": 1,
    "section": "reflected",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why are error pages and 'no results' messages common places for reflected XSS?",
    "choices": [
      {
        "text": "Browsers cache them",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Written in a hurry, by hand, quoting the request",
        "correct": true,
        "why": "Right. Like the f-string in search()."
      },
      {
        "text": "They are always served without a template engine",
        "correct": false,
        "why": "Not always; this one was."
      },
      {
        "text": "They return 404",
        "correct": false,
        "why": "Status is not the issue."
      }
    ]
  },
