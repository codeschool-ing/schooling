  {
    "id": "ex-85wh4mwj",
    "version": 1,
    "section": "file-names",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does the fixed upload store the file under an id it draws?",
    "choices": [
      {
        "text": "Ids are shorter than names",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Names are the server's",
        "correct": true,
        "why": "Right. Nothing to clean: no ../, no clashes."
      },
      {
        "text": "Flask refuses names with dots",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "To hide the file from its owner",
        "correct": false,
        "why": "The owner gets the id."
      }
    ]
  },
