    "section": "drill",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A job queue stores tasks as pickles in Redis, written and read only by the portal's own servers. Is that the lesson's flaw?",
    "choices": [
      {
        "text": "Yes: pickle is forbidden everywhere",
        "correct": false,
        "why": "The rule is about the trust boundary."
      },
      {
        "text": "Not if only the servers write",
        "correct": true,
        "why": "Right. The boundary decides; protect Redis accordingly."
      },
      {
        "text": "No: Redis escapes what it stores",
        "correct": false,
        "why": "It stores bytes."
      },
      {
        "text": "Yes, unless the pickles are base64",
        "correct": false,
        "why": "Encoding changes nothing."
      }
    ]
  },
