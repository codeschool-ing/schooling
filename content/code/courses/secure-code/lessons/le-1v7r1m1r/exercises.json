  {
    "id": "ex-4d2ydhfq",
    "version": 1,
    "section": "file-contents",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How does the fix tell whether an upload is a PDF?",
    "choices": [
      {
        "text": "By its .pdf extension",
        "correct": false,
        "why": "The sender chooses that."
      },
      {
        "text": "By the Content-Type the browser declared",
        "correct": false,
        "why": "Also chosen by the sender."
      },
      {
        "text": "Its first five bytes are %PDF-",
        "correct": true,
        "why": "Right. A minimum, not a proof."
      },
      {
        "text": "By opening it with a PDF reader",
        "correct": false,
        "why": "A further step, not this fix."
      }
