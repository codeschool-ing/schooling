  {
    "id": "ex-96cn82xn",
    "version": 1,
    "section": "the-uploads",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "The pickled-cookie test holds nothing but the text size. Why is that enough to show the flaw?",
    "choices": [
      {
        "text": "Because pickle always fails on small cookies",
        "correct": false,
        "why": "It loaded it fine."
      },
      {
        "text": "Because a text size can damage the portal",
        "correct": false,
        "why": "The value is harmless."
      },
      {
        "text": "The portal ran pickle on them",
        "correct": true,
        "why": "Right. That is the flaw, whatever the bytes say."
      },
      {
        "text": "Because the test also checks the logs",
        "correct": false,
        "why": "It checks the status only."
      }
    ]
  },
  {
    "id": "ex-vz2z353a",
    "version": 1,
    "section": "pickle",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does the fixed portal answer to a cookie that is not base64 JSON of the right shape?",
    "choices": [
      {
        "text": "It falls back to pickle",
        "correct": false,
        "why": "Pickle is gone."
      },
      {
        "text": "400 Bad Request",
        "correct": true,
        "why": "Right. Validated, as lesson 2 asks."
      },
      {
        "text": "The default size, silently",
        "correct": false,
        "why": "It refuses rather than guesses."
      },
      {
        "text": "500, from json.loads",
        "correct": false,
        "why": "The error is caught and answered."
      }
    ]
  },
  {
    "id": "ex-q33p3nym",
    "version": 1,
    "section": "pickle",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the JSON cookie base64-encoded?",
    "choices": [
      {
        "text": "To encrypt the preferences",
        "correct": false,
        "why": "base64 encodes; it does not encrypt."
      },
      {
        "text": "To make it shorter",
        "correct": false,
        "why": "It makes it longer."
      },
      {
        "text": "Because JSON is not allowed in cookies by the law",
        "correct": false,
        "why": "No such law."
      },
      {
        "text": "So quotes travel safely in a cookie",
        "correct": true,
        "why": "Right. It protects nothing else."
      }
    ]
  },
  {
    "id": "ex-wecz7brp",
    "version": 1,
    "section": "pickle",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A value must not be changed by the client, such as a role. What does the lesson suggest first?",
    "choices": [
      {
        "text": "Keep it on the server",
        "correct": true,
        "why": "Right. Signing is the second answer."
      },
      {
        "text": "Sign a pickle of it",
        "correct": false,
        "why": "Signed pickle is only as safe as the key."
      },
      {
        "text": "Encode it twice in base64",
        "correct": false,
        "why": "Encoding protects nothing."
      },
      {
        "text": "Put it in a hidden form field",
        "correct": false,
        "why": "The client edits those, as lesson 12 showed."
      }
    ]
  },
