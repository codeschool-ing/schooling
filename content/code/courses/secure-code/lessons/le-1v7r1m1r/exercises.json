  {
    "id": "ex-k2d4zcvd",
    "version": 1,
    "section": "file-names",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why should uploads not be stored inside `static/`?",
    "choices": [
      {
        "text": "Static files are deleted at each restart",
        "correct": false,
        "why": "They are not."
      },
      {
        "text": "The folder has a size limit",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Anybody gets them, with a type the browser guesses",
        "correct": true,
        "why": "Right. No owner check, no declared type, no attachment."
      },
      {
        "text": "Git cannot track binary files",
        "correct": false,
        "why": "Unrelated."
      }
    ]
  },
  {
    "id": "ex-dynkpn43",
    "version": 1,
    "section": "file-names",
    "type": "quiz",
