[
  {
    "id": "ex-619fmh0h",
    "version": 1,
    "section": "whole-objects",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is the difference between a data format and an object format?",
    "choices": [
      {
        "text": "Object formats are smaller",
        "correct": false,
        "why": "Size is not the difference."
      },
      {
        "text": "It runs what the bytes describe",
        "correct": true,
        "why": "Right. JSON builds data and nothing else."
      },
      {
        "text": "Data formats cannot hold lists",
        "correct": false,
        "why": "JSON holds lists."
      },
      {
        "text": "Only object formats work in cookies",
        "correct": false,
        "why": "This lesson's fix puts JSON in one."
      }
    ]
  },
  {
    "id": "ex-yj9cddm9",
    "version": 1,
    "section": "whole-objects",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which of these are object formats, unsafe to read from outside? Choose all that apply.",
    "choices": [
      {
        "text": "Python's pickle",
        "correct": true,
        "why": "Rebuilds objects."
      },
      {
        "text": "Java's native serialisation",
        "correct": true,
        "why": "Same family."
      },
      {
        "text": "PHP's unserialize",
        "correct": true,
        "why": "Same family."
      },
      {
        "text": "JSON",
        "why": "A data format."
      }
    ]
  },
  {
    "id": "ex-3wawng9k",
    "version": 1,
    "section": "whole-objects",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which three values of an upload does the sender choose?",
    "choices": [
      {
        "text": "Only the bytes; the server sets the rest",
        "correct": false,
        "why": "The name and type come from the sender too."
      },
      {
        "text": "The name, the declared type and the bytes",
        "correct": true,
        "why": "Right. All three are values to check."
      },
      {
        "text": "The folder, the owner and the size limit",
        "correct": false,
        "why": "Those are the server's."
      },
      {
        "text": "Nothing: browsers fix the name",
        "correct": false,
        "why": "Clients send what they like."
      }
    ]
  },
