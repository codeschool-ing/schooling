  {
    "id": "ex-cje58114",
    "version": 1,
    "section": "the-uploads",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Where did the upload named `../escape.pdf` land?",
    "choices": [
      {
        "text": "In static/uploads, renamed",
        "correct": false,
        "why": "It was not renamed."
      },
      {
        "text": "In static, outside the upload folder",
        "correct": true,
        "why": "Right. The name decided the path."
      },
      {
        "text": "Nowhere: Flask refused it with 400",
        "correct": false,
        "why": "It was accepted."
      },
      {
        "text": "In the system's temporary folder",
        "correct": false,
        "why": "It was saved where the path pointed."
      }
    ]
  },
