  {
    "id": "ex-426rrzjj",
    "version": 1,
    "section": "persistence",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "When is it reasonable to run a cache Redis with no snapshots and no AOF?",
    "hint": "What does a cold start cost?",
    "choices": [
      {
        "text": "Never; a cache must survive restarts",
        "correct": false,
        "why": "A cache can be rebuilt; the question is the cost."
      },
      {
        "text": "When the refill is cheap",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "When the server has more than 8 GB",
        "correct": false,
        "why": "Memory size is not the question."
      },
      {
        "text": "When using allkeys-lru",
        "correct": false,
        "why": "Eviction and persistence are separate choices."
      }
    ]
  },
