  {
    "id": "ex-v02az4a9",
    "version": 1,
    "section": "securing-redis",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "An application's Redis password leaks. Which setup limits the damage most?",
    "hint": "Least privilege, as in lesson 4.",
    "choices": [
      {
        "text": "A long password on the default user",
        "correct": false,
        "why": "With it, the attacker has everything."
      },
      {
        "text": "A user limited to its own keys",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A different port from the usual 6379",
        "correct": false,
        "why": "Hiding the port protects nothing once it is known."
      },
      {
        "text": "Turning on AOF",
        "correct": false,
        "why": "Persistence is not access control."
      }
    ]
