  {
    "id": "ex-g02qax49",
    "version": 1,
    "section": "memory-and-eviction",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "With `maxmemory 2mb` and Ubuntu's default policy, what happened after 401 keys?",
    "hint": "noeviction.",
    "choices": [
      {
        "text": "Old keys were evicted to make room",
        "correct": false,
        "why": "That needs an eviction policy."
      },
      {
        "text": "Redis crashed",
        "correct": false,
        "why": "Reads kept working."
      },
      {
        "text": "Every write failed with OOM",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Memory grew past the limit",
        "correct": false,
        "why": "The limit held."
      }
    ]
  },
