  {
    "id": "ex-tdw7tdpw",
    "version": 1,
    "section": "structures",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Five views were pushed (3, 7, 2, 9, 3) and the list trimmed to 0..2. What did LRANGE return?",
    "hint": "LPUSH adds to the left.",
    "choices": [
      {
        "text": "book:3, book:7, book:2",
        "correct": false,
        "why": "That is the order they were pushed."
      },
      {
        "text": "book:3, book:9, book:2",
        "correct": true,
        "why": "Right. Most recent first."
      },
      {
        "text": "book:9, book:2, book:7",
        "correct": false,
        "why": "The last push, book:3, is at the head."
      },
      {
        "text": "book:2, book:9, book:3",
        "correct": false,
        "why": "Reversed."
      }
    ]
  },
  {
    "id": "ex-rhs09pkw",
    "version": 1,
    "section": "structures",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why update a book's stock with `HINCRBY` on a hash rather than rewriting a JSON string?",
    "hint": "Count the round trips and the gaps.",
    "choices": [
      {
        "text": "JSON is not allowed in Redis",
        "correct": false,
        "why": "The previous section stored JSON."
      },
      {
        "text": "Hashes never expire",
        "correct": false,
        "why": "Any key can have a lifetime."
      },
      {
        "text": "One atomic command, no race",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Hashes are encrypted on disk by Redis",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
