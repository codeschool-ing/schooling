[
  {
    "id": "ex-5jd6n2rn",
    "version": 1,
    "section": "what-redis-is",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why can two copies of the shop share a cache in Redis but not in a Python dictionary?",
    "hint": "Where does each one live?",
    "choices": [
      {
        "text": "Redis is a separate process both connect to",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Dictionaries cannot hold JSON",
        "correct": false,
        "why": "They can; they live in one process."
      },
      {
        "text": "Python forbids sharing between threads",
        "correct": false,
        "why": "The copies are processes, and the issue is memory."
      },
      {
        "text": "Redis copies itself into each process when it starts up",
        "correct": false,
        "why": "It is one server that every process reaches over a socket."
      }
    ]
  },
  {
    "id": "ex-p9aca3sb",
    "version": 1,
    "section": "what-redis-is",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is `INCR` on a shared counter correct even with a thousand clients?",
    "hint": "How many commands run at once?",
    "choices": [
      {
        "text": "Each client gets its own copy of the counter",
        "correct": false,
        "why": "There is one counter."
      },
      {
        "text": "Commands run one at a time",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Redis takes a lock on every key it changes",
        "correct": false,
        "why": "No locks are needed with one thread."
      },
      {
        "text": "The client retries until it works",
        "correct": false,
        "why": "Nothing is retried."
      }
    ]
  },
  {
    "id": "ex-8xf4ttt4",
    "version": 1,
    "section": "what-redis-is",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is `KEYS *` a bad habit on a production Redis?",
    "hint": "One thread, every key.",
    "choices": [
      {
        "text": "It deletes the keys it lists",
        "correct": false,
        "why": "It only lists them."
      },
      {
        "text": "It blocks all other clients",
        "correct": true,
        "why": "Right. Use --scan."
      },
      {
        "text": "It returns keys in random order",
        "correct": false,
        "why": "Order is not the problem."
      },
      {
        "text": "It needs a password",
        "correct": false,
        "why": "Not by default."
      }
    ]
  },
  {
    "id": "ex-00n6mg04",
    "version": 1,
    "section": "strings-and-counters",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`SET lock:report bruno NX` answered with nothing. What happened?",
    "hint": "NX: only if absent.",
    "choices": [
      {
        "text": "Nothing was written",
        "correct": true,
        "why": "Right. ana kept the lock."
      },
      {
        "text": "The command failed with an error",
        "correct": false,
        "why": "No error; an empty answer."
      },
      {
        "text": "bruno took the lock from ana",
        "correct": false,
        "why": "GET still said ana."
      },
      {
        "text": "The key was deleted by it",
        "correct": false,
        "why": "It was still there."
      }
    ]
  },
  {
    "id": "ex-f7wz6mxv",
    "version": 1,
    "section": "strings-and-counters",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "An application counts views with `GET`, adds one in Python and `SET`s the result. Two copies run. What goes wrong?",
    "hint": "Two reads before either write.",
    "choices": [
      {
        "text": "Nothing; Redis is single-threaded",
        "correct": false,
        "why": "One thread per command; the read and the write are two commands."
      },
      {
        "text": "Views are lost when both read the same value",
        "correct": true,
        "why": "Right. INCR is one step."
      },
      {
        "text": "The counter becomes a string",
        "correct": false,
        "why": "It always was a string with a number in it."
      },
      {
        "text": "Redis refuses the second SET",
        "correct": false,
        "why": "SET without NX always writes."
      }
    ]
  },
  {
    "id": "ex-6j8ht25x",
    "version": 1,
    "section": "expiry",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each TTL answer to what it means.",
    "hint": "Two special values.",
    "pairs": [
      {
        "left": "30",
        "right": "expires in thirty seconds"
      },
      {
        "left": "-1",
        "right": "exists and never expires"
      },
      {
        "left": "-2",
        "right": "no such key"
      }
    ],
    "right_distractors": [
      "expired a second ago"
    ]
  },
  {
    "id": "ex-q31wpgq1",
    "version": 1,
    "section": "expiry",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "An expired key nobody asks for again: how does Redis free its memory?",
    "hint": "Lazy deletion needs a request.",
    "choices": [
      {
        "text": "It never does; only a read removes it",
        "correct": false,
        "why": "Active expiry finds it."
      },
      {
        "text": "On the next restart",
        "correct": false,
        "why": "Sooner than that."
      },
      {
        "text": "By sampling keys with a lifetime",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "When maxmemory is reached",
        "correct": false,
        "why": "Expiry does not wait for that."
      }
    ]
  },
  {
    "id": "ex-dmy01hnj",
    "version": 1,
    "section": "expiry",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A cache Redis slowly fills up and `TTL` on many keys answers `-1`. What is the likeliest cause?",
    "hint": "What does -1 mean?",
    "choices": [
      {
        "text": "Keys were written without a lifetime",
        "correct": true,
        "why": "Right. They can never expire."
      },
      {
        "text": "The clock is wrong",
        "correct": false,
        "why": "-1 does not depend on the clock."
      },
      {
        "text": "Active expiry is turned off",
        "correct": false,
        "why": "-1 means no lifetime at all."
      },
      {
        "text": "Redis lost its snapshot",
        "correct": false,
        "why": "Unrelated."
      }
    ]
  },
