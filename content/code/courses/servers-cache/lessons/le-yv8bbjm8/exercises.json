  {
    "id": "ex-cwngme34",
    "version": 1,
    "section": "memory-and-eviction",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "One Redis holds both cached pages and the shop's sessions, with `volatile-lru`. A developer caches a value without `ex=`. What follows?",
    "hint": "volatile evicts only keys with a lifetime.",
    "choices": [
      {
        "text": "It is evicted first",
        "correct": false,
        "why": "It has no lifetime, so it can never be evicted."
      },
      {
        "text": "Redis refuses to store it",
        "correct": false,
        "why": "It stores it."
      },
      {
        "text": "Sessions get a lifetime automatically",
        "correct": false,
        "why": "No."
      },
      {
        "text": "It is never evicted, and they pile up",
        "correct": true,
        "why": "Right. Two Redis instances avoid the question."
      }
    ]
  },
  {
