  {
    "id": "ex-5qnbhjhj",
    "version": 1,
    "section": "what-changed",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Ana edits `stg_books.sql`. Which steps does `make` run?",
    "hint": "Which stamp is now older than an input?",
    "choices": [
      {
        "text": "All three",
        "correct": false,
        "why": "Raw's inputs did not change."
      },
      {
        "text": "The models and the report",
        "correct": true,
        "why": "Right. Everything after the edited file."
      },
      {
        "text": "Only the report, since raw and the models are current",
        "correct": false,
        "why": "The models stamp is older than the edit."
      },
      {
        "text": "None, because comments do not count",
        "correct": false,
        "why": "make compares times, not contents."
      }
    ]
  },
  {
    "id": "ex-ke8kmyf3",
    "version": 1,
    "section": "what-changed",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A refund changes the 14th in the shop's database. What does `make` do on the next run, with no day played?",
    "hint": "Which file did the refund touch?",
    "choices": [
      {
        "text": "Reloads raw",
        "correct": false,
        "why": "No input file changed."
      },
      {
        "text": "Rebuilds the 14th's report",
        "correct": false,
        "why": "Nothing tells it to."
      },
      {
        "text": "Nothing: no file it watches changed",
        "correct": true,
        "why": "Right. Times cannot see data."
      },
      {
        "text": "Fails",
        "correct": false,
        "why": "It finds nothing to do."
      }
    ]
  },
  {
