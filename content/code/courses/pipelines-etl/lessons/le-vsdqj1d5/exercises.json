[
  {
    "id": "ex-0f29z779",
    "version": 1,
    "section": "two-ways",
    "type": "matching",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Match each tool to how it describes the work.",
    "hint": "Steps, things, or both.",
    "pairs": [
      {
        "left": "A shell script",
        "right": "Steps in order"
      },
      {
        "left": "A dbt model",
        "right": "What a table should contain"
      },
      {
        "left": "An Airflow DAG",
        "right": "A declared graph of imperative tasks"
      }
    ],
    "right_distractors": [
      "A list of files to delete"
    ]
  },
  {
    "id": "ex-94g90ybg",
    "version": 1,
    "section": "two-ways",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why can't an imperative script skip a step whose work is already done?",
    "hint": "What was it never told?",
    "choices": [
      {
        "text": "It was never told what any step's work is",
        "correct": true,
        "why": "Right. Only what to do."
      },
      {
        "text": "Shell scripts cannot test whether a file or a table exists",
        "correct": false,
        "why": "They can; nobody told it what to test."
      },
      {
        "text": "set -e stops it from skipping",
        "correct": false,
        "why": "set -e only stops on failure."
      },
      {
        "text": "Skipping would make it declarative, which the shell forbids",
        "correct": false,
        "why": "Nothing forbids it."
      }
    ]
  },
  {
    "id": "ex-ehxaw77d",
    "version": 1,
    "section": "the-script",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`nightly.sh` fails at the fact load. What does the next run do?",
    "hint": "Does it know what finished?",
    "choices": [
      {
        "text": "Starts from the fact load",
        "correct": false,
        "why": "It has no record of what finished."
      },
      {
        "text": "Refuses to run until cleared",
        "correct": false,
        "why": "Nothing stops it."
      },
      {
        "text": "Starts from the top",
        "correct": true,
        "why": "Right. Every step again."
      },
      {
        "text": "Skips the steps that succeeded, using the exit codes of the night before",
        "correct": false,
        "why": "Exit codes are not kept."
      }
    ]
  },
  {
    "id": "ex-pbjn0na2",
    "version": 1,
    "section": "the-script",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Running `nightly.sh` twice for the same day did no harm. Why?",
    "hint": "A property of each step.",
    "choices": [
      {
        "text": "The script detects the second run",
        "correct": false,
        "why": "It detects nothing."
      },
      {
        "text": "Each step was written to be safe to repeat",
        "correct": true,
        "why": "Right. That is lesson 15's subject."
      },
      {
        "text": "PostgreSQL ignores repeated inserts",
        "correct": false,
        "why": "It inserts them."
      },
      {
        "text": "set -e",
        "correct": false,
        "why": "That only stops on failure."
      }
    ]
  },
  {
    "id": "ex-k2ennb41",
    "version": 1,
    "section": "a-makefile",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "When does `make` rebuild a file?",
    "hint": "Existence, and something else.",
    "choices": [
      {
        "text": "Every time it is run",
        "correct": false,
        "why": "Then the second make would not say nothing to be done."
      },
      {
        "text": "When a table it reads in the database has changed",
        "correct": false,
        "why": "make cannot see the database."
      },
      {
        "text": "Only when it is missing",
        "correct": false,
        "why": "That is Luigi."
      },
      {
        "text": "When missing, or older than one of its inputs",
        "correct": true,
        "why": "Right. Modification times."
      }
    ]
  },
  {
    "id": "ex-06ma7qyf",
    "version": 1,
    "section": "a-makefile",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does the raw rule list the lab's clock file among its inputs?",
    "hint": "What changes when the shop lives a day?",
    "choices": [
      {
        "text": "make needs the date",
        "correct": false,
        "why": "DAY is read separately."
      },
      {
        "text": "load_raw.py reads it",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "It stops two loads from running at the same moment on one machine",
        "correct": false,
        "why": "It locks nothing."
      },
      {
        "text": "A new day rewrites it, so raw becomes out of date",
        "correct": true,
        "why": "Right. It stands for new data has arrived."
      }
    ]
  },
