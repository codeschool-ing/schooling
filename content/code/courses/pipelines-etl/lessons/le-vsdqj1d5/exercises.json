  {
    "id": "ex-p6jrvv1w",
    "version": 1,
    "section": "failing-and-resuming",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "After the dbt step failed, why was `.made/models` out of date?",
    "hint": "Which touch never ran?",
    "choices": [
      {
        "text": "It was the 15th's, older than the new raw stamp",
        "correct": true,
        "why": "Right. The touch after dbt build never ran."
      },
      {
        "text": "make deleted it",
        "correct": false,
        "why": "It was still there."
      },
      {
        "text": "dbt wrote a newer one, after the tests had failed and stopped the run",
        "correct": false,
        "why": "dbt knows nothing of the stamps."
      },
      {
        "text": "Its contents were wrong",
        "correct": false,
        "why": "make never reads contents."
      }
    ]
