  {
    "id": "ex-c1ytg90g",
    "version": 1,
    "section": "state-in-dbt",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `state:modified` compare?",
    "hint": "Two manifests.",
    "choices": [
      {
        "text": "The project with a saved manifest",
        "correct": true,
        "why": "Right. Each model's definition."
      },
      {
        "text": "File modification times, as make compares them",
        "correct": false,
        "why": "That is make."
      },
      {
        "text": "The data in the warehouse with the data in the shop on the evening before",
        "correct": false,
        "why": "It compares code, not data."
      },
      {
        "text": "Git commits",
        "correct": false,
        "why": "It reads the manifest."
      }
    ]
  },
  {
    "id": "ex-gx8vb2z4",
    "version": 1,
    "section": "state-in-dbt",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "After changing `stg_books`, why was `fact_sales` not rebuilt?",
    "hint": "What does fact_sales read?",
    "choices": [
      {
        "text": "It is incremental, and so it is never rebuilt by a selection",
        "correct": false,
        "why": "Materialisation does not matter here."
      },
      {
        "text": "The drift test failed and stopped it before it could start",
        "correct": false,
        "why": "Nothing failed in that build."
      },
      {
        "text": "Exposures block it",
        "correct": false,
        "why": "Exposures build nothing."
      },
      {
        "text": "Nothing it reads was modified",
        "correct": true,
        "why": "Right. It reads int_sales, not the books."
      }
    ]
  },
  {
    "id": "ex-97ebrs4r",
    "version": 1,
    "section": "where-each-fits",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is sending the managers an e-mail an imperative step by nature?",
    "hint": "What output could be compared?",
    "choices": [
      {
        "text": "E-mail servers are slow",
        "correct": false,
        "why": "Speed is not the issue."
      },
      {
        "text": "make cannot run mail commands",
        "correct": false,
        "why": "It can run anything."
      },
      {
        "text": "No output to check; a rerun sends it again",
        "correct": true,
        "why": "Right. Guard it so it runs once."
      },
      {
        "text": "E-mails are always the first step of a pipeline, before any load",
        "correct": false,
        "why": "They belong at the end."
      }
    ]
  },
