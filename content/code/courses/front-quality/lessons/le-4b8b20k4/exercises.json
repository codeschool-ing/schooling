[
  {
    "id": "ex-hp0wdap9",
    "version": 1,
    "section": "same-origin",
    "type": "multiple-choice",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which parts of an address make up its origin? Choose all that apply.",
    "choices": [
      {
        "text": "the scheme",
        "correct": true,
        "why": "http or https."
      },
      {
        "text": "the host",
        "correct": true,
        "why": "As written."
      },
      {
        "text": "the port",
        "correct": true,
        "why": "5173 and 3000 differ."
      },
      {
        "text": "the path",
        "why": "/api/plan does not change the origin."
      }
    ]
  },
  {
    "id": "ex-2cacvtjc",
    "version": 1,
    "section": "same-origin",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Is `http://127.0.0.1:5173/` the same origin as `http://localhost:5173/`?",
    "choices": [
      {
        "text": "Yes, because both name the same machine",
        "correct": false,
        "why": "The browser compares the words, not the machine."
      },
      {
        "text": "No",
        "correct": true,
        "why": "Right. The host is written differently."
      },
      {
        "text": "Only for GET requests",
        "correct": false,
        "why": "Origins do not depend on the method."
      },
      {
        "text": "Yes, on Linux and not on Windows",
        "correct": false,
        "why": "The rule is the browser's, everywhere."
      }
    ]
  },
  {
    "id": "ex-5z5p8ps9",
    "version": 1,
    "section": "same-origin",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does the same-origin policy forbid a page's scripts to do?",
    "choices": [
      {
        "text": "Send any request to another origin",
        "correct": false,
        "why": "Pages send requests anywhere."
      },
      {
        "text": "Read another origin's responses",
        "correct": true,
        "why": "Right, unless that origin says yes."
      },
      {
        "text": "Load images from another origin",
        "correct": false,
        "why": "`<img>` loads from anywhere."
      },
      {
        "text": "Use cookies at all",
        "correct": false,
        "why": "Cookies are a separate matter."
      }
    ]
  },
  {
    "id": "ex-m958m5t7",
    "version": 1,
    "section": "same-origin",
    "type": "cloze",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "CORS never makes anything more ___ than the same-origin policy already did.",
    "blanks": [
      {
        "accept": [
          "secure",
          "safe"
        ],
        "ignore_case": true,
        "ignore_accents": true
      }
    ]
  },
  {
    "id": "ex-02d03mx3",
    "version": 1,
    "section": "the-error",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "When the CORS check failed for the GET, what did the page's code receive?",
    "choices": [
      {
        "text": "A 401 and the error body",
        "correct": false,
        "why": "That came back only once the wildcard was added."
      },
      {
        "text": "A response with status 0 and the body",
        "correct": false,
        "why": "No response at all."
      },
      {
        "text": "The CORS message as a string",
        "correct": false,
        "why": "The page cannot see it."
      },
      {
        "text": "TypeError: Failed to fetch",
        "correct": true,
        "why": "Right. The reason is only in the console."
      }
    ]
  },
  {
    "id": "ex-s10wnca2",
    "version": 1,
    "section": "the-error",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "The browser blocked the page from reading the plan. Did the request reach the server?",
    "choices": [
      {
        "text": "Yes, and it answered 401",
        "correct": true,
        "why": "Right. CORS stops the reading, not the request."
      },
      {
        "text": "No, the browser stopped it before it left",
        "correct": false,
        "why": "That happens only to a preflighted request."
      },
      {
        "text": "No, the server refuses other origins by default",
        "correct": false,
        "why": "The server knew nothing of origins then."
      },
      {
        "text": "Only half of it",
        "correct": false,
        "why": "A request is sent whole or not at all."
      }
    ]
  },
  {
    "id": "ex-1waqyy02",
    "version": 1,
    "section": "the-error",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `curl` read the API's answer when the browser would not let the page read it?",
    "choices": [
      {
        "text": "curl sends a secret header",
        "correct": false,
        "why": "It sends ordinary headers."
      },
      {
        "text": "The API trusts the terminal",
        "correct": false,
        "why": "It cannot tell."
      },
      {
        "text": "curl runs on port 3000",
        "correct": false,
        "why": "curl has no origin at all."
      },
      {
        "text": "Only browsers enforce the policy",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-bc7kpgh7",
    "version": 1,
    "section": "the-error",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does `server/look.mjs` print?",
    "choices": [
      {
        "text": "The server's own log",
        "correct": false,
        "why": "It runs in the browser's side."
      },
      {
        "text": "Other-origin requests, console, result",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A screenshot of the page",
        "correct": false,
        "why": "It prints text only."
      },
      {
        "text": "Every request the page made, Vite's included",
        "correct": false,
        "why": "It filters to other origins."
      }
    ]
  },
  {
    "id": "ex-hgjrk4rf",
    "version": 1,
    "section": "preflight",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which of these requests from the planner's page to port 3000 are preflighted? Choose all that apply.",
    "choices": [
      {
        "text": "POST with Content-Type: application/json",
        "correct": true,
        "why": "Not a type a form can send."
      },
      {
        "text": "DELETE",
        "correct": true,
        "why": "Not GET, HEAD or POST."
      },
      {
        "text": "GET with an Authorization header",
        "correct": true,
        "why": "A header a form cannot set."
      },
      {
        "text": "a plain GET",
        "why": "Simple: sent as it is."
      }
    ]
  },
  {
    "id": "ex-v218vszz",
    "version": 1,
    "section": "preflight",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why do simple requests skip the preflight?",
    "choices": [
      {
        "text": "They are always safe",
        "correct": false,
        "why": "A POST form can still change things."
      },
      {
        "text": "Forms could already send them",
        "correct": true,
        "why": "Right. Servers had to cope with them anyway."
      },
      {
        "text": "Browsers cache their answers",
        "correct": false,
        "why": "Caching is not the reason."
      },
      {
        "text": "Servers ask for that",
        "correct": false,
        "why": "The rule is the browser's."
      }
    ]
  },
  {
    "id": "ex-r4njye3t",
    "version": 1,
    "section": "preflight",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each preflight header to what it says.",
    "pairs": [
      {
        "left": "Access-Control-Request-Method",
        "right": "the method the real request will use"
      },
      {
        "left": "Access-Control-Request-Headers",
        "right": "the headers it will carry"
      },
      {
        "left": "Access-Control-Max-Age",
        "right": "how long the browser may remember the answer"
      }
    ],
    "right_distractors": [
      "which cookie to send"
    ]
  },
  {
    "id": "ex-jhzy3tmm",
    "version": 1,
    "section": "preflight",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "The preflight was refused. What happened to the POST?",
    "choices": [
      {
        "text": "It was sent, and its answer hidden from the page",
        "correct": false,
        "why": "That is the simple-request case."
      },
      {
        "text": "It never left the browser",
        "correct": true,
        "why": "Right. That is the preflight's job."
      },
      {
        "text": "It was sent without its body",
        "correct": false,
        "why": "Nothing is half sent."
      },
      {
        "text": "It was turned into a GET",
        "correct": false,
        "why": "Browsers never change the method."
      }
    ]
  },
  {
    "id": "ex-8dz4rzxb",
    "version": 1,
    "section": "credentials",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "With `Access-Control-Allow-Origin: *`, what does a `fetch` with `credentials: \"include\"` get?",
    "choices": [
      {
        "text": "The plan, with the cookie sent",
        "correct": false,
        "why": "The browser refuses the wildcard here."
      },
      {
        "text": "A 401, readable",
        "correct": false,
        "why": "That was the request without credentials."
      },
      {
        "text": "A refusal: no wildcard with credentials",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A preflight error",
        "correct": false,
        "why": "A plain GET is not preflighted."
      }
    ]
  },
  {
    "id": "ex-8m0gmkkd",
    "version": 1,
    "section": "credentials",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why is echoing back whatever `Origin` the request carries, with credentials allowed, worse than the wildcard?",
    "choices": [
      {
        "text": "Every site reads with the cookies",
        "correct": true,
        "why": "Right, and the browser cannot tell."
      },
      {
        "text": "It is slower",
        "correct": false,
        "why": "Speed is not the issue."
      },
      {
        "text": "It breaks the planner's own page",
        "correct": false,
        "why": "It works for it, and for everybody else."
      },
      {
        "text": "Browsers refuse an echoed origin",
        "correct": false,
        "why": "They cannot tell it was echoed."
      }
    ]
  },
  {
    "id": "ex-538p20f6",
    "version": 1,
    "section": "credentials",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the wildcard \"merely untidy rather than dangerous\" for a response without credentials?",
    "choices": [
      {
        "text": "Browsers ignore it",
        "correct": false,
        "why": "They honour it."
      },
      {
        "text": "It holds nothing personal",
        "correct": true,
        "why": "Right. It was read without their cookies."
      },
      {
        "text": "The server encrypts the body",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "It is never sent",
        "correct": false,
        "why": "It is sent and read."
      }
    ]
  },
  {
    "id": "ex-p7g8a7vz",
    "version": 1,
    "section": "the-fix",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is `Vary: Origin` for?",
    "choices": [
      {
        "text": "It makes the browser send the Origin header",
        "correct": false,
        "why": "Browsers send it anyway."
      },
      {
        "text": "It allows several origins at once",
        "correct": false,
        "why": "Each answer names one."
      },
      {
        "text": "It replaces Allow-Credentials",
        "correct": false,
        "why": "Both are sent."
      },
      {
        "text": "Caches keep the answer apart per origin",
        "correct": true,
        "why": "Right. A permission for one origin is never served to another."
      }
    ]
  },
  {
    "id": "ex-60k7rk0p",
    "version": 1,
    "section": "the-fix",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The test \"any other origin is given no permission\" passed before the fix. Why keep it?",
    "choices": [
      {
        "text": "Vitest needs two tests per file",
        "correct": false,
        "why": "No such rule."
      },
      {
        "text": "It tests the browser",
        "correct": false,
        "why": "It tests the server."
      },
      {
        "text": "So a wildcard turns it red",
        "correct": true,
        "why": "Right. It keeps the refusal in place."
      },
      {
        "text": "It was a mistake to write it",
        "correct": false,
        "why": "It guards the most likely regression."
      }
    ]
  },
