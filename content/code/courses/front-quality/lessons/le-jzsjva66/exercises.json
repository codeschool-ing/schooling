  {
    "id": "ex-pab735fy",
    "version": 1,
    "section": "axe",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why does `server/axe.mjs` wait for the heading before running axe?",
    "choices": [
      {
        "text": "axe only reads headings",
        "correct": false,
        "why": "It reads the whole page."
      },
      {
        "text": "Because the heading has no contrast",
        "correct": false,
        "why": "It has."
      },
      {
        "text": "To slow the test down",
        "correct": false,
        "why": "No."
      },
      {
        "text": "So axe sees the page drawn",
        "correct": true,
        "why": "Right. Before the data, there is nothing to check."
      }
