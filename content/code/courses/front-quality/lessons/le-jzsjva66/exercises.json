  {
    "id": "ex-mw881vns",
    "version": 1,
    "section": "levels",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A page meets every AA criterion but one. At what level does it conform?",
    "choices": [
      {
        "text": "A at most",
        "correct": true,
        "why": "Right, if it meets every A criterion."
      },
      {
        "text": "AA, \"mostly\"",
        "correct": false,
        "why": "Mostly AA is not a level."
      },
      {
        "text": "AAA, since it met so many",
        "correct": false,
        "why": "AAA needs all of AA first."
      },
      {
        "text": "It depends on which one",
        "correct": false,
        "why": "One failing AA criterion is enough."
      }
    ]
  },
