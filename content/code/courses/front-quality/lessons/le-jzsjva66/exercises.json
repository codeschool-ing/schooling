  {
    "id": "ex-twhnj3e9",
    "version": 1,
    "section": "who-it-is-for",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is accessibility the developer's job rather than the person's?",
    "choices": [
      {
        "text": "Because assistive technology fixes any page",
        "correct": false,
        "why": "It cannot fix how a page is built."
      },
      {
        "text": "Because the law names developers",
        "correct": false,
        "why": "Laws name organisations."
      },
      {
        "text": "Because designers cannot write HTML",
        "correct": false,
        "why": "Not the argument."
      },
      {
        "text": "The barriers are in how the page is built",
        "correct": true,
        "why": "Right."
      }
    ]
  },
