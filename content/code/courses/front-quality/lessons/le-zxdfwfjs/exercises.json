[
  {
    "id": "ex-at1vfpdj",
    "version": 1,
    "section": "https",
    "type": "multiple-choice",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does TLS give a connection? Choose all that apply.",
    "choices": [
      {
        "text": "nobody on the way can read it",
        "correct": true,
        "why": "Confidentiality."
      },
      {
        "text": "nobody on the way can change it",
        "correct": true,
        "why": "Integrity."
      },
      {
        "text": "the server is the one the address names",
        "correct": true,
        "why": "Authentication, by the certificate."
      },
      {
        "text": "the page's scripts are safe",
        "why": "A padlock says nothing about the content."
      }
    ]
  },
  {
    "id": "ex-y5q67sh1",
    "version": 1,
    "section": "https",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `Strict-Transport-Security` protect that a redirect to HTTPS cannot?",
    "choices": [
      {
        "text": "The content of the page",
        "correct": false,
        "why": "It says nothing about content."
      },
      {
        "text": "The server's private key",
        "correct": false,
        "why": "That never leaves the server anyway."
      },
      {
        "text": "Cookies without the Secure attribute",
        "correct": false,
        "why": "Mark them Secure."
      },
      {
        "text": "Later visits",
        "correct": true,
        "why": "Right. The redirect itself can be intercepted."
      }
    ]
  },
