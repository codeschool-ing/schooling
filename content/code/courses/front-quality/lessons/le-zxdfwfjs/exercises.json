  {
    "id": "ex-sgnq15ht",
    "version": 1,
    "section": "https",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why do the planner's development servers not send HSTS?",
    "choices": [
      {
        "text": "Vite forbids it",
        "correct": false,
        "why": "It allows any header."
      },
      {
        "text": "Browsers ignore it over plain HTTP",
        "correct": true,
        "why": "Right. It belongs where the site is published over HTTPS."
      },
      {
        "text": "localhost does not support TLS at all",
        "correct": false,
        "why": "It can; it does not need to."
      },
      {
        "text": "HSTS only works with Secure cookies",
        "correct": false,
        "why": "They are unrelated rules."
      }
    ]
  },
  {
    "id": "ex-2ahkh38a",
    "version": 1,
    "section": "the-build",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why does every file in `dist/assets/` carry a hash in its name?",
    "choices": [
      {
        "text": "To stop people reading it",
        "correct": false,
        "why": "It is public."
      },
      {
        "text": "Because CSP requires hashed names",
        "correct": false,
        "why": "CSP hashes are a different thing."
      },
      {
        "text": "New build, new names",
        "correct": true,
        "why": "Right, and browsers may keep old ones for ever."
      },
      {
        "text": "Vite numbers the builds",
        "correct": false,
        "why": "The hash is of the contents."
      }
    ]
  },
