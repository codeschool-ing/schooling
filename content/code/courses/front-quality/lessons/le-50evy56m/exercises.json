  {
    "id": "ex-37jbcmhc",
    "version": 1,
    "section": "where-it-can-live",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is the weakness of an HttpOnly cookie, according to the lesson?",
    "choices": [
      {
        "text": "Scripts on the page read it",
        "correct": false,
        "why": "That is what HttpOnly prevents."
      },
      {
        "text": "The browser sends it on its own",
        "correct": true,
        "why": "Right, including on requests another site starts: CSRF."
      },
      {
        "text": "It is lost when the tab closes, whatever Max-Age says",
        "correct": false,
        "why": "Max-Age keeps it."
      },
      {
        "text": "It cannot hold more than eight characters",
        "correct": false,
        "why": "It held 43."
      }
    ]
  },
  {
    "id": "ex-b2kxfzmz",
    "version": 1,
    "section": "what-a-script-sees",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "After signing in through the page, what did `document.cookie` return?",
