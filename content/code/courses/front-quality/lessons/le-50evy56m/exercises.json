[
  {
    "id": "ex-bcncjf79",
    "version": 1,
    "section": "where-it-can-live",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which of these keeps a secret from the page's own scripts?",
    "choices": [
      {
        "text": "`localStorage`, since it belongs to the origin",
        "correct": false,
        "why": "Every script on the origin reads it."
      },
      {
        "text": "`sessionStorage`, since it ends with the tab",
        "correct": false,
        "why": "It ends sooner and is just as readable."
      },
      {
        "text": "An HttpOnly cookie",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A cookie without HttpOnly, read with care",
        "correct": false,
        "why": "`document.cookie` shows it to any script."
      }
    ]
  },
  {
