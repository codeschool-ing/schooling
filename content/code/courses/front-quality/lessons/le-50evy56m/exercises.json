  {
    "id": "ex-z2an4gpq",
    "version": 1,
    "section": "cookie-attributes",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does the browser require before it accepts a cookie named `__Host-sid`?",
    "choices": [
      {
        "text": "That it is HttpOnly",
        "correct": false,
        "why": "Not part of the prefix's rule."
      },
      {
        "text": "Secure, Path=/ and no Domain",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "That the server signs it",
        "correct": false,
        "why": "Cookies are not signed by the browser's rules."
      },
      {
        "text": "That it expires within a day",
        "correct": false,
        "why": "No lifetime is required."
      }
    ]
  },
  {
    "id": "ex-wznpg6mb",
    "version": 1,
    "section": "cookie-attributes",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A session cookie has `Max-Age=28800`, and its value is copied before it expires. Is the copy still good after eight hours?",
    "choices": [
      {
        "text": "No, the browser deletes every copy",
        "correct": false,
        "why": "The browser deletes its own."
      },
      {
        "text": "Only if the server still accepts it",
        "correct": true,
        "why": "Right. Max-Age is an instruction to the browser."
      },
      {
        "text": "Yes, cookies never expire on the server",
        "correct": false,
        "why": "The server decides."
      },
      {
        "text": "No, because Secure stops copying",
        "correct": false,
        "why": "Secure is about HTTPS."
      }
    ]
  },
