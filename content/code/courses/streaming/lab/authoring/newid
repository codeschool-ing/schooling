#!/usr/bin/env python3
# newid PREFIX [N]: fresh ids, unique across the repository and across earlier calls.
import secrets, subprocess, sys, os
A = "0123456789abcdefghjkmnpqrstvwxyz"
pre = sys.argv[1]; n = int(sys.argv[2]) if len(sys.argv) > 2 else 1
used_f = "/var/tmp/lab/used-ids"
used = set(open(used_f).read().split()) if os.path.exists(used_f) else set()
out = []
while len(out) < n:
    i = pre + "-" + "".join(secrets.choice(A) for _ in range(8))
    if i in used: continue
    r = subprocess.run(["git", "-C", "/home/user/schooling", "grep", "-q", i], capture_output=True)
    if r.returncode == 0: continue
    used.add(i); out.append(i)
open(used_f, "a").write("\n".join(out) + "\n")
print("\n".join(out))
