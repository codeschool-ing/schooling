  {
    "id": "ex-eyqpjz9q",
    "version": 1,
    "section": "instructions-and-data",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why can any text that reaches the prompt act as an instruction?",
    "hint": "One sequence of tokens.",
    "choices": [
      {
        "text": "Embeddings carry instructions",
        "correct": false,
        "why": "The model reads text, not vectors."
      },
      {
        "text": "Nothing marks it as data",
        "correct": true,
        "why": "Right: a system message is a hint, not a wall."
      },
      {
        "text": "Providers execute text as code",
        "correct": false,
        "why": "Nothing is executed."
      },
      {
        "text": "Documents are sent before the instructions",
        "correct": false,
        "why": "Order does not make text inert."
      }
    ]
  },
