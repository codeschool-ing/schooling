  {
    "id": "ex-sbafxbdh",
    "version": 2,
    "section": "a-canary-in-the-listings",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why is the injected instruction a request for the word PINEAPPLE?",
    "hint": "A canary.",
    "choices": [
      {
        "text": "The model only understands fruit",
        "correct": false,
        "why": "A model reads any word; the word was chosen for the test."
      },
      {
        "text": "It is harmless and easy to detect",
        "correct": true,
        "why": "Right: a test sees at once if it was obeyed."
      },
      {
        "text": "It is a real attack used against Marginalia",
        "correct": false,
        "why": "Marginalia does not exist; the listing was written for the course."
      },
      {
        "text": "Models refuse other words",
        "correct": false,
        "why": "Not why."
      }
    ]
  },
  {
    "id": "ex-wdf1d6je",
    "version": 2,
    "section": "a-canary-in-the-listings",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "llama3.2:3b ignored the canary on both questions. What does the lesson draw from that?",
    "hint": "One model, one wording, two questions.",
    "choices": [
      {
        "text": "The feature is safe with this model",
        "correct": false,
        "why": "Another wording, question or version can be obeyed."
      },
      {
        "text": "The canary was badly written",
        "correct": false,
        "why": "It is a plain instruction; being ignored once proves nothing about the next one."
      },
      {
        "text": "That the test runs, not that the feature is safe",
        "correct": true,
        "why": "Right: the layers that follow do not rely on the model refusing."
      },
      {
        "text": "Delimiters are no longer needed",
        "correct": false,
        "why": "Delimiting stays as one layer."
      }
    ]
  },
