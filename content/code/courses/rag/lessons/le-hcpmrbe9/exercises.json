  },
  {
    "id": "ex-mfv95dwk",
    "version": 1,
    "section": "filter-inside-the-search",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Besides losing places, what is wrong with dropping forbidden rows after the search?",
    "hint": "Where is the text in between?",
    "choices": [
      {
        "text": "It is slower than the WHERE",
        "correct": false,
        "why": "Speed is not the second problem."
      },
      {
        "text": "The model sees the dropped rows anyway",
        "correct": false,
        "why": "They are dropped before the prompt."
      },
      {
        "text": "Logs and caches leak the text",
        "correct": true,
        "why": "Right: with the WHERE it is never read out."
      },
      {
        "text": "PostgreSQL refuses to return forbidden rows",
        "correct": false,
        "why": "Without a policy it returns them."
      }
    ]
  },
  {
    "id": "ex-hf72prww",
    "version": 1,
    "section": "the-database-enforces-it",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "With rag.audiences not set, how many rows does the assistant role see?",
    "hint": "Null matches nothing.",
    "choices": [
      {
        "text": "All of them",
        "correct": false,
        "why": "The policy hides every row."
      },
      {
        "text": "Only the ones the last request saw",
        "correct": false,
        "why": "The setting ends with each transaction."
      },
      {
        "text": "Only public ones",
        "correct": false,
        "why": "Public needs to be set too."
      },
      {
        "text": "None",
        "correct": true,
        "why": "Right: it fails closed."
      }
    ]
  },
  {
    "id": "ex-kb5rp8cs",
    "version": 1,
    "section": "the-database-enforces-it",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is rag.audiences set with set_config(..., true)?",
    "hint": "Pooled connections.",
    "choices": [
      {
        "text": "Because the policy only reads booleans",
        "correct": false,
        "why": "It reads a comma-separated list."
      },
      {
        "text": "To make the search use the index",
        "correct": false,
        "why": "Unrelated to indexes."
      },
      {
        "text": "The true makes it permanent",
        "correct": false,
        "why": "It makes it end with the transaction."
      },
      {
        "text": "So it ends with the transaction",
        "correct": true,
        "why": "Right: no inherited permissions."
      }
    ]
  },
  {
    "id": "ex-k0mvk9dp",
    "version": 1,
    "section": "the-database-enforces-it",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does access.search keep its WHERE now that the database has a policy?",
    "hint": "Two layers, two jobs.",
    "choices": [
      {
        "text": "The policy only works on writes",
        "correct": false,
        "why": "It is FOR SELECT."
      },
      {
        "text": "pgvector ignores policies",
        "correct": false,
        "why": "Policies apply to every query."
      },
      {
        "text": "Correctness and speed",
        "correct": true,
        "why": "Right: the policy makes a forgotten WHERE safe."
      },
      {
        "text": "The policy cannot read arrays",
        "correct": false,
        "why": "It compares with ANY."
      }
    ]
  },
