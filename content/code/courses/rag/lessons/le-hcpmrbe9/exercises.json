[
  {
    "id": "ex-r3trtjd5",
    "version": 1,
    "section": "who-is-asking",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Where does a reader's role come from?",
    "hint": "Never from the question.",
    "choices": [
      {
        "text": "The words of the question",
        "correct": false,
        "why": "Then a question could choose its permissions."
      },
      {
        "text": "A field the client sends with the request",
        "correct": false,
        "why": "The client could send anything."
      },
      {
        "text": "The session",
        "correct": true,
        "why": "Right: the signed-in account and its permissions."
      },
      {
        "text": "The document the search finds first",
        "correct": false,
        "why": "That would decide access after reading."
      }
    ]
  },
  {
    "id": "ex-a0zqkeya",
    "version": 1,
    "section": "who-is-asking",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does audiences() return for a role nobody wrote into ROLES?",
