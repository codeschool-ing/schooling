        "why": "It returns quietly; the search finds nothing."
      },
      {
        "text": "Every audience, so nothing breaks",
        "correct": false,
        "why": "That opens the door on a typo."
      },
      {
        "text": "Only public",
        "correct": false,
        "why": "The code returns an empty list."
      }
    ]
  },
