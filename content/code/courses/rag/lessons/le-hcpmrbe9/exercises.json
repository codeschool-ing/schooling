    "id": "ex-s3npsvfv",
    "version": 1,
    "section": "filters-and-the-index",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why can an HNSW index return fewer rows than the LIMIT under a strict filter?",
    "hint": "What does the index know?",
    "choices": [
      {
        "text": "Indexes store only public rows",
        "correct": false,
        "why": "It indexes every row."
      },
      {
        "text": "The filter runs after the index",
        "correct": true,
        "why": "Right: ef_search is 40 by default."
      },
      {
        "text": "It refuses queries with a WHERE",
        "correct": false,
        "why": "It runs them."
      },
      {
        "text": "The LIMIT applies before the ORDER BY",
        "correct": false,
        "why": "Not in SQL."
      }
    ]
  },
  {
    "id": "ex-z2msw9af",
    "version": 1,
    "section": "filters-and-the-index",
    "type": "matching",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Match each remedy to how it gets enough rows past a strict filter.",
    "hint": "Three remedies.",
    "pairs": [
      {
        "left": "exact search on the subset",
        "right": "compares every row that passes the filter"
      },
      {
        "left": "a partial index per audience",
        "right": "walks a graph holding only that audience"
      },
      {
        "left": "iterative index scans",
        "right": "keeps walking until enough rows pass"
      }
    ]
  },
