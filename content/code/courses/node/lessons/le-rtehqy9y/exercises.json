    "difficulty": "easy",
    "drillable": true,
    "prompt": "Where is the `router.param(\"code\", …)` check run?",
    "choices": [
      {
        "text": "Only in the first route that names `:code`",
        "correct": false,
        "why": "Every route under that router that names it."
      },
      {
        "text": "On every request to the application",
        "correct": false,
        "why": "Only routes with the parameter."
      },
      {
        "text": "After the route has answered",
        "correct": false,
        "why": "Before, so it can refuse."
      },
      {
        "text": "Before each `:code` route",
        "correct": true,
        "why": "Right."
      }
    ]
  },
