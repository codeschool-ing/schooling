    "difficulty": "easy",
    "drillable": true,
    "prompt": "With `strict: true`, what happens to a body that is the JSON string `\"https://example.com/\"`?",
    "choices": [
      {
        "text": "A parse error goes to the error handler",
        "correct": true,
        "why": "Right: entity.parse.failed."
      },
      {
        "text": "req.body becomes that string",
        "correct": false,
        "why": "strict refuses anything but objects and arrays."
      },
      {
        "text": "It is wrapped in an object",
        "correct": false,
        "why": "Nothing is wrapped."
      },
      {
        "text": "It is ignored and req.body is undefined",
        "correct": false,
        "why": "Ignored is what happens to a non-JSON type."
      }
    ]
  },
  {
    "id": "ex-cbt1at4q",
    "version": 1,
    "section": "body",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does the demo's error handler send `err.type` rather than `err.message`?",
    "choices": [
      {
        "text": "The message is always empty",
        "correct": false,
        "why": "It holds text, which is the problem."
      },
      {
        "text": "Express forbids sending messages",
        "correct": false,
        "why": "Nothing forbids it."
      },
      {
        "text": "It quotes the body back",
        "correct": true,
        "why": "Right; the type is a word a program can test."
      },
      {
        "text": "type is shorter",
        "correct": false,
        "why": "Length is not the point."
      }
    ]
  },
  {
    "id": "ex-ptvzpphf",
    "version": 1,
    "section": "body",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A route reads `req.body.url`, and a request arrives with no body. What happens in Express 5, and why not in Express 4?",
    "choices": [
      {
        "text": "A TypeError, from an undefined body",
        "correct": true,
        "why": "Right. Hence `req.body?.url`."
      },
      {
        "text": "Nothing in either: req.body is `{}`",
        "correct": false,
        "why": "That was Express 4 only."
      },
      {
        "text": "A 400 from express.json in both",
        "correct": false,
        "why": "No body is not a parse error."
      },
      {
        "text": "A 413, because zero is under no limit",
        "correct": false,
        "why": "Zero bytes is under any limit."
      }
    ]
  },
  {
