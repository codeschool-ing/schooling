  {
    "id": "ex-81254hmz",
    "version": 1,
    "section": "validation",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why check `typeof body.url !== \"string\"` before its length or its protocol?",
