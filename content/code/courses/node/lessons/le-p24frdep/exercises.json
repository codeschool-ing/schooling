  {
    "id": "ex-h2v3q5cf",
    "version": 1,
    "section": "why-a-framework",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does Express answer, by default, for `DELETE /links` when only GET and POST were written?",
    "choices": [
      {
        "text": "404",
        "correct": true,
        "why": "Right. The 405 has to be added by hand."
      },
      {
        "text": "405 with an Allow header",
        "correct": false,
        "why": "That is what lesson 5 wrote and Express does not."
      },
      {
        "text": "501 Not Implemented",
        "correct": false,
        "why": "Express does not use 501 for this."
      },
      {
        "text": "It runs the GET handler instead",
        "correct": false,
        "why": "A method that does not match does not run."
      }
    ]
  },
  {
