  {
    "id": "ex-p9byw0t3",
    "version": 1,
    "section": "routes",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`/links/:code` was added before `/links/new`. What does `GET /links/new` reach?",
    "choices": [
      {
        "text": "`/links/:code`, with `new` as the code",
        "correct": true,
        "why": "Right. The broad pattern above hides the narrow one."
      },
      {
        "text": "`/links/new`, because fixed paths win",
        "correct": false,
        "why": "Express tries routes in order; nothing is ranked."
      },
      {
        "text": "Neither: Express refuses two matches",
        "correct": false,
        "why": "The first match runs."
      },
      {
        "text": "Both, one after the other",
        "correct": false,
        "why": "Only if the first called next()."
      }
    ]
  },
  {
    "id": "ex-62zrmws3",
    "version": 1,
    "section": "routes",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A router mounted with `app.use(\"/admin\", admin)` has `admin.get(\"/stats\", …)`. Which path reaches it?",
    "choices": [
      {
        "text": "`/stats`",
        "correct": false,
        "why": "Routes in a router are relative to its mount."
      },
      {
        "text": "`/admin/stats`",
        "correct": true,
        "why": "Right, and `/ADMIN/stats` too."
      },
      {
        "text": "`/admin`",
        "correct": false,
        "why": "That reaches admin's `/` route."
      },
      {
        "text": "`/stats/admin`",
        "correct": false,
        "why": "The mount path comes first."
      }
    ]
  },
  {
