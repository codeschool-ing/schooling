  {
    "id": "ex-z59frgvg",
    "version": 1,
    "section": "middleware",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What are the two things a middleware may do with a request it receives?",
    "choices": [
      {
        "text": "Retry it, or drop it",
        "correct": false,
        "why": "Neither is in the contract."
      },
      {
        "text": "Answer it, or call `next()`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Copy it, or queue it",
        "correct": false,
        "why": "Middleware does neither."
      },
      {
        "text": "Log it, or encrypt it",
        "correct": false,
        "why": "Logging is one use; the rule is answer or next."
      }
    ]
  },
