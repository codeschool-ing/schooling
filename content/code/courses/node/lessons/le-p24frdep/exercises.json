        "why": "Right. Lesson 5 compared whole strings."
      }
    ]
  },
  {
    "id": "ex-nnjkfdhk",
    "version": 1,
    "section": "path-syntax",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`app.get(\"/files/*path\", …)` receives `/files/2026/october/report.txt`. What is `req.params.path`?",
    "choices": [
      {
        "text": "`\"2026/october/report.txt\"`",
        "correct": false,
        "why": "A wildcard arrives as an array, not one string."
      },
      {
        "text": "`\"report.txt\"`",
        "correct": false,
        "why": "It holds every segment."
      },
      {
        "text": "`undefined`, because wildcards are unnamed",
        "correct": false,
        "why": "In Express 5 a wildcard must have a name."
      },
      {
        "text": "`[\"2026\", \"october\", \"report.txt\"]`",
        "correct": true,
        "why": "Right."
      }
    ]
  },
