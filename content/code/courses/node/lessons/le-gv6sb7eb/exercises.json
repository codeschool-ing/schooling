  {
    "id": "ex-6cn0gjtb",
    "version": 1,
    "section": "process-env",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "`PORT=4000 node -p process.env.PORT` printed 4000. What did `echo $PORT` print afterwards?",
    "choices": [
      {
        "text": "4000",
        "correct": false,
        "why": "That set it for one command only."
      },
      {
        "text": "An error",
        "correct": false,
        "why": "An unset name expands to nothing."
      },
      {
        "text": "Nothing",
        "correct": true,
        "why": "Right: the shell's own was never set."
      },
      {
        "text": "3000, the default",
        "correct": false,
        "why": "The shell has no default."
      }
    ]
  },
  {
    "id": "ex-xx1xm4yn",
    "version": 1,
    "section": "process-env",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A child process changes its `process.env.REGION`. What does the shell that started its parent see?",
    "choices": [
      {
        "text": "Nothing changes",
        "correct": true,
        "why": "Right: copied downwards, never back up."
      },
      {
        "text": "The new value",
        "correct": false,
        "why": "The environment is never sent back up."
      },
      {
        "text": "The variable is deleted",
        "correct": false,
        "why": "Nothing reaches the shell."
      },
      {
        "text": "It depends on `export`",
        "correct": false,
        "why": "export affects children, not parents."
      }
    ]
  },
