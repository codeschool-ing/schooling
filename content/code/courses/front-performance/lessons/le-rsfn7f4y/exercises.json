  {
    "id": "ex-eg4g3bx3",
    "version": 1,
    "section": "an-install-button",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does the install button use position: fixed?",
    "choices": [
      {
        "text": "Appearing late moves nothing",
        "correct": true,
        "why": "Right: no layout shift."
      },
      {
        "text": "Chromium requires it",
        "correct": false,
        "why": "Any button works."
      },
      {
        "text": "So it stays hidden in Safari",
        "correct": false,
        "why": "hidden does that."
      },
      {
        "text": "Fixed elements load first",
        "correct": false,
        "why": "Position is not priority."
      }
    ]
  },
  {
    "id": "ex-cknft4g2",
    "version": 1,
    "section": "an-install-button",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What happens to the button in Safari?",
    "choices": [
      {
        "text": "It shows and does nothing",
        "correct": false,
        "why": "It is only shown when the event fires."
      },
      {
        "text": "It opens Add to Home Screen",
        "correct": false,
        "why": "A page cannot open that menu."
      },
      {
        "text": "It stays hidden",
        "correct": true,
        "why": "Yes: Safari fires no beforeinstallprompt."
      },
      {
        "text": "The page throws an error",
        "correct": false,
        "why": "Nothing runs until the event."
      }
    ]
  },
  {
    "id": "ex-qazvz221",
    "version": 1,
    "section": "an-install-button",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why is InstallOffer written out in main.ts?",
    "choices": [
      {
        "text": "prompt() is private",
        "correct": false,
        "why": "It is public on the event."
      },
      {
        "text": "TypeScript does not know it",
        "correct": true,
        "why": "Right: it is Chromium's, not a standard."
      },
      {
        "text": "To make it work in Safari",
        "correct": false,
        "why": "Safari never fires it."
      },
      {
        "text": "Vite cannot import types",
        "correct": false,
        "why": "It strips them."
      }
    ]
  },
  {
    "id": "ex-ysaxa1tc",
    "version": 1,
    "section": "once-installed",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How does a page know it is running as the installed app?",
    "choices": [
      {
        "text": "navigator.installed",
        "correct": false,
        "why": "No such property."
      },
      {
        "text": "The manifest's id",
        "correct": false,
        "why": "The id is the app's identity, not a test."
      },
      {
        "text": "A cookie the browser sets",
        "correct": false,
        "why": "It sets none."
      },
      {
        "text": "A media query",
        "correct": true,
        "why": "Yes, in CSS or matchMedia."
      }
    ]
  },
  {
