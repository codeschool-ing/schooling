[
  {
    "id": "ex-pham5hm0",
    "version": 1,
    "section": "what-makes-an-app",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which of these does installing a PWA give it? Choose all that apply.",
    "choices": [
      {
        "text": "An icon on the home screen or in the app list",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "A window of its own",
        "correct": true,
        "why": "Yes, with display standalone."
      },
      {
        "text": "A place in an app store",
        "correct": false,
        "why": "Installing puts it in none."
      },
      {
        "text": "More access to the device than the site had",
        "correct": false,
        "why": "It has the site's permissions."
      },
      {
        "text": "A faster load",
        "correct": false,
        "why": "The speed is the previous lessons'."
      }
    ]
  },
  {
    "id": "ex-nrgrrevy",
    "version": 1,
    "section": "what-makes-an-app",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is it called progressive?",
    "choices": [
      {
        "text": "It works as a site where it cannot install",
        "correct": true,
        "why": "Right: every browser gets the site; some also install it."
      },
      {
        "text": "It loads in stages",
        "correct": false,
        "why": "That is streaming."
      },
      {
        "text": "It updates itself gradually",
        "correct": false,
        "why": "Updates are the worker's, all at once."
      },
      {
        "text": "It was made by a company called Progressive",
        "correct": false,
        "why": "The word describes the idea."
      }
    ]
  },
  {
