  {
    "id": "ex-bzkv9gq8",
    "version": 1,
    "section": "the-manifest",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "The first installability check said no-acceptable-icon. Why?",
    "choices": [
      {
        "text": "The manifest had no name",
        "correct": false,
        "why": "It had both names."
      },
      {
        "text": "PNG is not allowed",
        "correct": false,
        "why": "PNG is what was named."
      },
      {
        "text": "The icon files did not exist yet",
        "correct": true,
        "why": "Yes: named in the manifest, not drawn."
      },
      {
        "text": "localhost cannot install",
        "correct": false,
        "why": "It installed once the icons existed."
      }
    ]
  },
  {
    "id": "ex-f9wc8ccg",
    "version": 1,
    "section": "the-manifest",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does installable.ts launch the full browser with a profile on disk?",
    "choices": [
      {
        "text": "A profile on disk makes the check faster than one in memory",
        "correct": false,
        "why": "Speed is not the reason."
      },
      {
        "text": "The shell and private windows do not install",
        "correct": true,
        "why": "Right: in-incognito was one of the reasons given."
      },
      {
        "text": "The manifest is read from the profile",
        "correct": false,
        "why": "It is read from the page."
      },
      {
        "text": "Notifications need it",
        "correct": false,
        "why": "This tool shows none."
      }
    ]
  },
  {
    "id": "ex-jajz3sv3",
    "version": 1,
    "section": "icons",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the maskable icon's drawing smaller, with no rounded corners?",
    "choices": [
      {
        "text": "Maskable icons have to be transparent around the edges",
        "correct": false,
        "why": "It fills the square with its background."
      },
      {
        "text": "It is shown at 192 pixels",
        "correct": false,
        "why": "It is 512."
      },
      {
        "text": "Chromium ignores rounded corners",
        "correct": false,
        "why": "It draws what it is given."
      },
      {
        "text": "The mask keeps the middle circle",
        "correct": true,
        "why": "Yes, 80% of the width; the mask makes the corners."
      }
    ]
  },
