  {
    "id": "ex-rksex3kg",
    "version": 1,
    "section": "notifications",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why should a page never ask for notification permission on arrival?",
    "choices": [
      {
        "text": "The service worker is not ready",
        "correct": false,
        "why": "Readiness is not the reason."
      },
      {
        "text": "Most say no, and a no is permanent",
        "correct": true,
        "why": "Yes; only the person can change it, in settings."
      },
      {
        "text": "It slows the LCP",
        "correct": false,
        "why": "A dialog is not content."
      },
      {
        "text": "Notification.permission is unset until load",
        "correct": false,
        "why": "It reads default from the start."
      }
    ]
