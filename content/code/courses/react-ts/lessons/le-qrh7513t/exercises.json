  {
    "id": "ex-zetk7dxk",
    "version": 1,
    "section": "retries-and-errors",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why are mutations not retried by default?",
    "hint": "What if the request arrived and only the answer was lost?",
    "choices": [
      {
        "text": "Mutations cannot fail",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "Servers refuse a second identical request",
        "correct": false,
        "why": "This one would accept it."
      },
      {
        "text": "Retries are only allowed for GET by HTTP",
        "correct": false,
        "why": "HTTP has no such rule."
      },
      {
        "text": "A POST twice adds two sessions",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-kyhx8rvc",
    "version": 1,
    "section": "retries-and-errors",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "In tests, why set `retry: 0`?",
    "hint": "How long does a failure take with the default?",
    "choices": [
      {
        "text": "So failures are reported fast",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Tests cannot make requests",
        "correct": false,
        "why": "They can, or mock them."
      },
      {
        "text": "Retries change the data",
        "correct": false,
        "why": "A GET changes nothing."
      },
      {
        "text": "React Query refuses to run in tests otherwise",
        "correct": false,
        "why": "It runs."
      }
    ]
  },
