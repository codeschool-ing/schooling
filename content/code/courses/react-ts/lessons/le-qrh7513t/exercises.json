[
  {
    "id": "ex-0trpf39m",
    "version": 1,
    "section": "a-server-to-talk-to",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why does the API check every session it receives, when the form already checks?",
    "hint": "What can send a request?",
    "choices": [
      {
        "text": "Any client reaches the server",
        "correct": true,
        "why": "Right: developer tools send any request."
      },
      {
        "text": "The form's checks are skipped in production builds",
        "correct": false,
        "why": "They run in every build; they just do not bind other clients."
      },
      {
        "text": "Node requires validation on every route",
        "correct": false,
        "why": "Node requires nothing."
      },
      {
        "text": "To slow the server down",
        "correct": false,
        "why": "That is `DELAY`."
      }
    ]
  },
  {
    "id": "ex-eq3tmf8g",
    "version": 1,
    "section": "a-server-to-talk-to",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What did the API answer to `{\"done\":\"yes\"}`?",
    "hint": "`done` must be a boolean.",
    "choices": [
      {
        "text": "200, with `done` set to true",
        "correct": false,
        "why": "It refused."
      },
      {
        "text": "404, because the session did not exist",
        "correct": false,
        "why": "`s2` exists."
      },
      {
        "text": "400, with a reason",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "500, because the server crashed",
        "correct": false,
        "why": "It answered calmly."
      }
    ]
  },
  {
    "id": "ex-hf5kmgr2",
    "version": 1,
    "section": "a-server-to-talk-to",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does Vite's `proxy` setting do with a request for `/api/planner`?",
    "hint": "Two servers, one address.",
    "choices": [
      {
        "text": "Serves `public/courses.json` instead",
        "correct": false,
        "why": "The API answers."
      },
      {
        "text": "Redirects the browser to `localhost:3001`",
        "correct": false,
        "why": "The page never sees port 3001."
      },
      {
        "text": "Forwards it to port 3001 and returns the answer",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Caches the answer for the next request",
        "correct": false,
        "why": "It forwards; it keeps nothing."
      }
    ]
  },
  {
    "id": "ex-eyyyfq8f",
    "version": 1,
    "section": "a-server-to-talk-to",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `data/` go in `.gitignore`?",
    "hint": "Is it code?",
    "choices": [
      {
        "text": "Git cannot store JSON",
        "correct": false,
        "why": "It can."
      },
      {
        "text": "It is state, not code",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It holds the server's passwords",
        "correct": false,
        "why": "There are none."
      },
      {
        "text": "Vite deletes it on every start",
        "correct": false,
        "why": "Nothing deletes it."
      }
    ]
  },
  {
    "id": "ex-59pxz9vp",
    "version": 1,
    "section": "why-a-library",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which of these did lesson 5's effect not do? Choose every one.",
    "hint": "It did drop a late answer.",
    "choices": [
      {
        "text": "Share one request between components",
        "correct": true,
        "why": "Not done."
      },
      {
        "text": "Retry a failed request",
        "correct": true,
        "why": "Not done."
      },
      {
        "text": "Refetch after a change was saved",
        "correct": true,
        "why": "Not done."
      },
      {
        "text": "Ignore an answer that arrived after cleanup",
        "correct": false,
        "why": "That one it did, with `ignore`."
      }
    ]
  },
  {
    "id": "ex-3w095q9a",
    "version": 1,
    "section": "why-a-library",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the planner's data from the server not state in lesson 4's sense?",
    "hint": "Who owns it?",
    "choices": [
      {
        "text": "It is a copy of something the server owns",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "It is too large for `useState`",
        "correct": false,
        "why": "Size is not the argument."
      },
      {
        "text": "It contains arrays",
        "correct": false,
        "why": "State can be an array."
      },
      {
        "text": "React refuses to store fetched values",
        "correct": false,
        "why": "Lesson 5 stored them."
      }
    ]
  },
  {
    "id": "ex-es6mjf4f",
    "version": 1,
    "section": "queries",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Under strict mode, how many `GET /api/planner` did the page send on load?",
    "hint": "A second ask for the same key joins the first.",
    "choices": [
      {
        "text": "Two, as in lesson 5",
        "correct": false,
        "why": "That was the effect."
      },
      {
        "text": "None until a button is pressed",
        "correct": false,
        "why": "It loads on mount."
      },
      {
        "text": "One",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Four, because of retries",
        "correct": false,
        "why": "Retries only follow failures."
      }
    ]
  },
  {
    "id": "ex-pbp9tge1",
    "version": 1,
    "section": "queries",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is `['planner']` in `useQuery`?",
    "hint": "It names a piece of data.",
    "choices": [
      {
        "text": "The URL to fetch",
        "correct": false,
        "why": "The function holds the URL."
      },
      {
        "text": "The key the cache stores the data under",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The component allowed to read it",
        "correct": false,
        "why": "Any component may."
      },
      {
        "text": "A list of dependencies, as in `useEffect`",
        "correct": false,
        "why": "It looks similar and names data instead."
      }
    ]
  },
