    "choices": [
      {
        "text": "Reloads the browser tab once the PATCH is done",
        "correct": false,
        "why": "No reload happened."
      },
      {
        "text": "Retries the PATCH if it failed",
        "correct": false,
        "why": "It retries nothing."
      },
      {
        "text": "Renders the page again for the answer",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Clears the API's data file",
        "correct": false,
        "why": "It touches no file."
      }
    ]
  },
