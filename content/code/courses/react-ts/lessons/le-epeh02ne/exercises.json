  {
    "id": "ex-2b2b38aw",
    "version": 1,
    "section": "server-functions",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What makes `setDone` a Server Function?",
    "hint": "The first line of its file.",
    "choices": [
      {
        "text": "Being `async`",
        "correct": false,
        "why": "Many functions are async and run anywhere."
      },
      {
        "text": "Its name, which Next.js reads to decide where it runs",
        "correct": false,
        "why": "Names decide nothing."
      },
      {
        "text": "Living inside the `app/` folder",
        "correct": false,
        "why": "Server Components live there too."
      },
      {
        "text": "`'use server'` at the top of its file",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
