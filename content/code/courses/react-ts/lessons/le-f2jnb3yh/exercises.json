        "correct": true,
        "why": "It suspends."
      },
      {
        "text": "`useSuspenseQuery` before its first answer",
        "correct": true,
        "why": "It suspends."
      },
      {
        "text": "A `fetch` inside a `useEffect`",
        "correct": false,
        "why": "The component renders and shows its own loading state."
      }
    ]
  },
