        "why": "It does not."
      },
      {
        "text": "It decides the dialog's title",
        "correct": false,
        "why": "The prop does."
      },
      {
        "text": "The second run finds it open",
        "correct": true,
        "why": "Right: it leaves it alone."
      }
    ]
  },
