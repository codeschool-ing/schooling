  {
    "id": "ex-x5bgygsh",
    "version": 1,
    "section": "a-native-dialog",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Escape closed the dialog. How did `planning` become `false`?",
