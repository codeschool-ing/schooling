[
  {
    "id": "ex-409x8bw1",
    "version": 1,
    "section": "reaching-the-dom",
    "type": "multiple-choice",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which of these need a ref to the element? Choose every one.",
    "hint": "Things the browser only does when asked.",
    "choices": [
      {
        "text": "Moving the focus to a heading",
        "correct": true,
        "why": "`focus()`."
      },
      {
        "text": "Opening a dialog as modal",
        "correct": true,
        "why": "`showModal()`."
      },
      {
        "text": "Measuring how wide a card came out",
        "correct": true,
        "why": "`getBoundingClientRect()`."
      },
      {
        "text": "Showing a different text when a value changes",
        "correct": false,
        "why": "That is a description."
      }
    ]
  },
  {
    "id": "ex-9xjnv509",
    "version": 1,
    "section": "reaching-the-dom",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why must `ref.current.focus()` not be called while the component renders?",
    "hint": "What is in `ref.current` on the first render?",
    "choices": [
      {
        "text": "Focus is forbidden in strict mode",
        "correct": false,
        "why": "It is not."
      },
      {
        "text": "`focus` is not a method of a heading",
        "correct": false,
        "why": "It is, with `tabIndex`."
      },
      {
        "text": "The element does not exist yet",
        "correct": true,
        "why": "Right, and a render must be pure."
      },
      {
        "text": "Refs can only be read in class components",
        "correct": false,
        "why": "Any component reads them."
      }
    ]
  },
  {
    "id": "ex-dpg2psy2",
    "version": 1,
    "section": "reaching-the-dom",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What can go wrong if code removes children of an element React rendered?",
    "hint": "Who believes they own that node?",
    "choices": [
      {
        "text": "Nothing: React rereads the DOM each time",
        "correct": false,
        "why": "It does not reread it."
      },
      {
        "text": "The browser refuses to remove a node React made",
        "correct": false,
        "why": "It obeys."
      },
      {
        "text": "TypeScript reports an error",
        "correct": false,
        "why": "It cannot see it."
      },
      {
        "text": "React's next update breaks or undoes it",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
