  {
    "id": "ex-zgbver2x",
    "version": 1,
    "section": "a-field-that-takes-a-ref",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "In React 19, what does a function component need to pass a `ref` on to an `<input>`?",
    "hint": "It is a prop now.",
    "choices": [
      {
        "text": "Wrapping it in `forwardRef`",
        "correct": false,
        "why": "That was before React 19."
      },
      {
        "text": "Rewriting it as a class component",
        "correct": false,
        "why": "Classes are not needed."
      },
      {
        "text": "Calling `useImperativeHandle` inside the component",
        "correct": false,
        "why": "That customises what a ref receives."
      },
      {
        "text": "Nothing: `ref` arrives as a prop",
        "correct": true,
        "why": "Right."
      }
    ]
  },
