    "choices": [
      {
        "text": "A keydown handler that `Dialog` adds to the window",
        "correct": false,
        "why": "There is none."
      },
      {
        "text": "The effect noticed and set it",
        "correct": false,
        "why": "Effects do not set the parent's state here."
      },
      {
        "text": "React resets state on Escape",
        "correct": false,
        "why": "React does not."
      },
      {
        "text": "The `close` event called `onClose`",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-5gq0gf3v",
    "version": 1,
    "section": "a-native-dialog",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does the effect check `dialog.open` before calling `showModal()`?",
    "hint": "Strict mode runs effects twice on mount.",
    "choices": [
      {
        "text": "`dialog.open` starts the animation",
        "correct": false,
