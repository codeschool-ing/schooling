  {
    "id": "ex-bn2nz4zb",
    "version": 1,
    "section": "the-dev-server",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does Vite's development server do with `/src/Root.tsx` when the browser asks for it?",
    "hint": "One request per module.",
    "choices": [
      {
        "text": "Builds the whole project first, then sends the part that holds Root",
        "correct": false,
        "why": "It builds nothing."
      },
      {
        "text": "Sends the TypeScript for the browser to compile",
        "correct": false,
        "why": "Browsers do not run TypeScript."
      },
      {
        "text": "Translates it to JavaScript and sends it",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Reads it from `dist/`",
        "correct": false,
        "why": "That is the build."
      }
    ]
  },
