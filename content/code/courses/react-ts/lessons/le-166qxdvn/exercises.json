  {
    "id": "ex-5ah8dfqx",
    "version": 1,
    "section": "exhaustive-checks",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is `never`?",
    "hint": "A type.",
    "choices": [
      {
        "text": "A value that is `null` or `undefined`",
        "correct": false,
        "why": "Those are values."
      },
      {
        "text": "The type with no values",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A function that returns at once",
        "correct": false,
        "why": "Not a function."
      },
      {
        "text": "Any type, unchecked",
        "correct": false,
        "why": "That is `any`."
      }
    ]
  },
  {
    "id": "ex-msa5thwm",
    "version": 1,
    "section": "exhaustive-checks",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why build the state in `stateOf`, with a declared return type?",
    "hint": "A variable is narrowed to what was assigned.",
    "choices": [
      {
        "text": "Functions run faster than conditional expressions",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "So callers see the whole union",
        "correct": true,
        "why": "Right: a new shape reaches `Root`."
      },
      {
        "text": "Hooks cannot contain ternaries",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "To avoid importing `PlannerState`",
        "correct": false,
        "why": "It is used there."
      }
    ]
  },
