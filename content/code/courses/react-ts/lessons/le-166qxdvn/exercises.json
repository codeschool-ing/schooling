[
  {
    "id": "ex-9eb3332b",
    "version": 1,
    "section": "types-for-props",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "`<WeekNav monday={19} />` with `monday: string` gives which error?",
    "hint": "A number where a string was promised.",
    "choices": [
      {
        "text": "TS2741: a prop is missing",
        "correct": false,
        "why": "That was the second mistake."
      },
      {
        "text": "None until the page runs",
        "correct": false,
        "why": "The compiler caught it."
      },
      {
        "text": "A warning from oxlint",
        "correct": false,
        "why": "It was `tsc`."
      },
      {
        "text": "TS2322: `number` is not assignable to `string`",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
