  {
    "id": "ex-db5zfqdg",
    "version": 1,
    "section": "types-for-props",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each type to what it describes.",
    "hint": "The table.",
    "pairs": [
      {
        "left": "`ReactNode`",
        "right": "Anything React can draw"
      },
      {
        "left": "`ComponentProps<'input'>`",
        "right": "Every prop an input accepts"
      },
      {
        "left": "`ChangeEvent<HTMLInputElement>`",
        "right": "What an input's onChange receives"
      },
      {
        "left": "`Dispatch<SetStateAction<T>>`",
        "right": "The setter `useState` returns"
      }
    ],
    "right_distractors": [
      "A promise of a component"
    ]
  },
  {
    "id": "ex-khzaqmgc",
    "version": 1,
    "section": "types-for-props",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Which mistake can `monday: string` not catch?",
    "hint": "A string is a string.",
    "choices": [
      {
        "text": "`monday={19}`",
        "correct": false,
        "why": "TS2322 caught it."
      },
      {
        "text": "Leaving `monday` out of the element",
        "correct": false,
        "why": "TS2741 would catch it."
      },
      {
        "text": "`monday={null}`",
        "correct": false,
        "why": "Null is not a string."
      },
      {
        "text": "`monday=\"banana\"`",
        "correct": true,
        "why": "Right: it is a string."
      }
    ]
  },
  {
    "id": "ex-w9m9tt78",
    "version": 1,
    "section": "a-status-that-cannot-lie",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What could the old `usePlanner` say while loading?",
    "hint": "`courses` had a default.",
    "choices": [
      {
        "text": "That there were no courses",
        "correct": true,
        "why": "Right: an empty array."
      },
      {
        "text": "That the planner had failed and should be loaded again",
        "correct": false,
        "why": "Loading is not failing."
      },
      {
        "text": "Last week's courses",
        "correct": false,
        "why": "It kept none."
      },
      {
        "text": "An error",
        "correct": false,
        "why": "It returned a value."
      }
    ]
  },
  {
    "id": "ex-qx1bxt0a",
    "version": 1,
    "section": "a-status-that-cannot-lie",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "In `PlannerState`, which shape has `retry`?",
    "hint": "Only where it means something.",
    "choices": [
      {
        "text": "All three, as in lesson 12's version of the planner",
        "correct": false,
        "why": "That was the problem."
      },
      {
        "text": "`'ready'`",
        "correct": false,
        "why": "Nothing to retry."
      },
      {
        "text": "`'loading'`",
        "correct": false,
        "why": "Still waiting."
      },
      {
        "text": "`'failed'`",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-xp7rwnc6",
    "version": 1,
    "section": "a-status-that-cannot-lie",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What makes a union *discriminated*?",
    "hint": "The field each shape has.",
    "choices": [
      {
        "text": "Its shapes have no fields in common",
        "correct": false,
        "why": "They share `status`."
      },
      {
        "text": "It is declared with `enum`",
        "correct": false,
        "why": "It is a type alias."
      },
      {
        "text": "A shared field with a different literal in each shape",
        "correct": true,
        "why": "Right: `status`."
      },
      {
        "text": "It has exactly three shapes",
        "correct": false,
        "why": "Any number."
      }
    ]
  },
  {
    "id": "ex-9ahsd4t1",
    "version": 1,
    "section": "a-status-that-cannot-lie",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why did the union produce TS7006 errors as well as TS2339?",
    "hint": "What type did `s` get?",
    "choices": [
      {
        "text": "Arrow functions need their parameter types written out",
        "correct": false,
        "why": "They are usually inferred."
      },
      {
        "text": "`sessions` lost its type, so `s` had none",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`filter` is not allowed on a union",
        "correct": false,
        "why": "It is on arrays."
      },
      {
        "text": "The linter adds them",
        "correct": false,
        "why": "`tsc` reported them."
      }
    ]
  },
  {
    "id": "ex-rcx9rdpc",
    "version": 1,
    "section": "narrowing",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Inside `if (planner.status === 'ready')`, what is `planner.courses`?",
    "hint": "The check narrows.",
    "choices": [
      {
        "text": "Possibly `undefined`, until it is checked once more",
        "correct": false,
        "why": "The check was enough."
      },
      {
        "text": "An error: no shape has it",
        "correct": false,
        "why": "`'ready'` has it."
      },
      {
        "text": "`any`",
        "correct": false,
        "why": "It is typed."
      },
      {
        "text": "A `Course[]`",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-q6ns0trz",
    "version": 1,
    "section": "narrowing",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How does `useReadyPlanner` narrow the type?",
    "hint": "After the `if`, one shape is left.",
    "choices": [
      {
        "text": "By casting with `as`, which tells the compiler to trust it",
        "correct": false,
        "why": "It checks instead."
      },
      {
        "text": "By throwing when the planner is not ready",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "By waiting until the planner is ready",
        "correct": false,
        "why": "It does not wait."
      },
      {
        "text": "By returning an empty planner",
        "correct": false,
        "why": "That would be the old lie."
      }
    ]
  },
  {
    "id": "ex-ay9e3rk8",
    "version": 1,
    "section": "narrowing",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `LoadFailed` now take `retry` and `retrying` as props?",
    "hint": "Who already knows the status?",
    "choices": [
      {
        "text": "Contexts cannot hold functions",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "Props render faster than a context read",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "`Root` has narrowed them; the context has not",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "React Router requires it",
        "correct": false,
        "why": "Unrelated."
      }
    ]
  },
  {
