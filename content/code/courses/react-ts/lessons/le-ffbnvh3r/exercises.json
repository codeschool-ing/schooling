  {
    "id": "ex-pex1cg9q",
    "version": 1,
    "section": "params-and-loaders",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did `queryClient` move to a module of its own?",
    "hint": "Who else needs it?",
    "choices": [
      {
        "text": "The loader runs outside React and needs it",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`main.tsx` may not create objects",
        "correct": false,
        "why": "It may."
      },
      {
        "text": "React Router requires one client per route",
        "correct": false,
        "why": "There is one client."
      },
      {
        "text": "To reset the cache on every navigation between screens",
        "correct": false,
        "why": "The cache stays."
      }
    ]
  },
  {
    "id": "ex-0y16s6as",
    "version": 1,
    "section": "params-and-loaders",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does `ensureQueryData(plannerQuery)` do when the planner is already cached?",
    "hint": "Coming from the week.",
    "choices": [
      {
        "text": "Fetches again, always, so the screen is never stale",
        "correct": false,
        "why": "Only when nothing is cached."
      },
      {
        "text": "Throws, because the data exists",
        "correct": false,
        "why": "It returns them."
      },
      {
        "text": "Returns the cached data with no request",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Waits for the next render",
        "correct": false,
        "why": "It does not wait for renders."
      }
    ]
  },
