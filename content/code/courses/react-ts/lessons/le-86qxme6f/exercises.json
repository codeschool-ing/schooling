        "correct": false,
        "why": "Strict mode hides nothing."
      },
      {
        "text": "It is a bug in React's dev build",
        "correct": false,
        "why": "It is how React logs."
      }
    ]
  },
  {
    "id": "ex-kdm34vwy",
    "version": 1,
    "section": "an-error-boundary",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "How is an error boundary written in React 19?",
    "hint": "There is no hook for it.",
    "choices": [
      {
        "text": "A function component with `useErrorBoundary`",
        "correct": false,
        "why": "React has no such hook."
      },
      {
        "text": "An option of `createRoot`",
        "correct": false,
        "why": "Those options report errors; they draw no fallback."
      },
      {
        "text": "A class component",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "A `try`/`catch` around the JSX",
        "correct": false,
        "why": "The JSX only describes; the render happens later."
      }
    ]
  },
  {
    "id": "ex-f2bdv3jn",
    "version": 1,
    "section": "an-error-boundary",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each method of the boundary to when React calls it.",
    "hint": "One runs during the render, one after.",
