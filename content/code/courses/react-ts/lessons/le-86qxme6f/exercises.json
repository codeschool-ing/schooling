  {
    "id": "ex-0apm89hr",
    "version": 1,
    "section": "one-card-takes-the-page",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What did the `!` after `sessions.find(...)` do?",
    "hint": "It is TypeScript syntax and disappears from the JavaScript.",
    "choices": [
      {
        "text": "Threw an error when nothing was found",
        "correct": false,
        "why": "It does nothing at run time."
      },
      {
        "text": "Negated the session that was found",
        "correct": false,
        "why": "That would be `!` before the value."
      },
      {
        "text": "Made `find` return the first session",
        "correct": false,
        "why": "It changes no result."
      },
      {
        "text": "Told the compiler the value is never undefined",
        "correct": true,
        "why": "Right, and the compiler believed it."
      }
    ]
  },
  {
    "id": "ex-peekpvrn",
    "version": 1,
    "section": "one-card-takes-the-page",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does React remove the whole page after an uncaught render error?",
    "hint": "What could a half-drawn page show?",
    "choices": [
      {
        "text": "The rest of the tree is no longer trustworthy",
        "correct": true,
        "why": "Right: an empty page over one that may be lying."
      },
      {
        "text": "To free memory for a reload",
        "correct": false,
        "why": "Memory is not the reason."
      },
      {
        "text": "Only development builds do that",
        "correct": false,
        "why": "Production does it too."
      },
      {
        "text": "The browser forces it",
        "correct": false,
        "why": "It is React's choice."
      }
    ]
  },
  {
    "id": "ex-z72bhddx",
    "version": 1,
    "section": "one-card-takes-the-page",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
