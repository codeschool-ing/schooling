      }
    ]
  },
  {
    "id": "ex-fn9d5aae",
    "version": 1,
    "section": "controlled-inputs",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "How does each new session get its id?",
    "hint": "Lesson 8 asked for a stable key.",
    "choices": [
      {
        "text": "Its position in the array",
        "correct": false,
        "why": "Positions move."
      },
      {
        "text": "The date and the minutes joined together",
        "correct": false,
        "why": "Two sessions could share them."
      },
      {
        "text": "`crypto.randomUUID()`, once",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`Math.random()` on every render",
        "correct": false,
        "why": "That would change on every render."
      }
    ]
  },
  {
    "id": "ex-xrqn9ynq",
    "version": 1,
    "section": "uncontrolled-and-formdata",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "In the uncontrolled form, where does the date live while the user types?",
    "hint": "React reads it once.",
    "choices": [
      {
        "text": "In a `useState` per field",
        "correct": false,
        "why": "That is the controlled form."
      },
      {
        "text": "In the planner's context",
        "correct": false,
        "why": "Only the finished session goes there."
      },
      {
        "text": "In the DOM input itself, until submit",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "In `localStorage`",
        "correct": false,
        "why": "Nothing is stored."
      }
    ]
  },
  {
    "id": "ex-kp5y33d7",
    "version": 1,
    "section": "uncontrolled-and-formdata",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why `defaultValue={30}` and not `value={30}` in the uncontrolled form?",
    "hint": "A `value` with no `onChange`…",
    "choices": [
      {
        "text": "`defaultValue` is faster to render",
        "correct": false,
        "why": "Speed is not the point."
      },
      {
        "text": "`value` would freeze the field",
        "correct": true,
        "why": "Right, and React warns about it."
      },
      {
        "text": "`value` does not accept numbers",
        "correct": false,
        "why": "It does."
      },
      {
        "text": "`FormData` reads only default values",
        "correct": false,
        "why": "It reads what is in the field."
      }
    ]
  },
  {
    "id": "ex-pdsweq76",
    "version": 1,
    "section": "uncontrolled-and-formdata",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each need to the kind of input that fits it.",
    "hint": "Does the screen react while the user types?",
    "pairs": [
      {
        "left": "A live character count",
        "right": "Controlled"
      },
      {
        "left": "A form whose values matter only on submit",
        "right": "Uncontrolled"
      },
      {
        "left": "A starting value the field then keeps to itself",
        "right": "`defaultValue`"
      },
      {
        "left": "A field showing exactly what state holds",
        "right": "`value` with `onChange`"
      }
    ],
    "right_distractors": [
      "`value` with no `onChange`"
    ]
  },
  {
    "id": "ex-cvf4z7hd",
    "version": 1,
    "section": "native-validation",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "With `required` on the empty date, what happened on submit?",
    "hint": "The browser decides first.",
    "choices": [
      {
        "text": "`submit` fired and `addSession` threw",
        "correct": false,
        "why": "`submit` never fired."
      },
      {
        "text": "The browser refused it",
        "correct": true,
        "why": "Right: the field matched `:invalid`."
      },
      {
        "text": "React showed a message under the field",
        "correct": false,
        "why": "There was no React message yet."
      },
      {
        "text": "A session with no date was added",
        "correct": false,
        "why": "That was the controlled form."
      }
    ]
  },
  {
    "id": "ex-z2x9hzvz",
    "version": 1,
    "section": "native-validation",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which are limits of the browser's own validation? Choose every one.",
    "hint": "Four are listed; one of these is not a limit.",
    "choices": [
      {
        "text": "Its messages are the browser's",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "One field at a time",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "It knows types, not rules like \"four hours a day\"",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "It runs only after JavaScript loads",
        "correct": false,
        "why": "It works even if your script fails, which is why to keep it."
      }
    ]
  },
  {
