[
  {
    "id": "ex-cdbvcphx",
    "version": 1,
    "section": "controlled-inputs",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What makes the first form's date field controlled?",
    "hint": "Where does the value come from?",
    "choices": [
      {
        "text": "The `type=\"date\"` attribute",
        "correct": false,
        "why": "Any type can be controlled or not."
      },
      {
        "text": "Being inside a `<form>`",
        "correct": false,
        "why": "The form changes nothing about that."
      },
      {
        "text": "`value` and `onChange`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The `<label>` around it",
        "correct": false,
        "why": "The label names it."
      }
    ]
  },
  {
    "id": "ex-v0twdpp3",
    "version": 1,
    "section": "controlled-inputs",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why does the form's handler start with `event.preventDefault()`?",
    "hint": "What does a browser do on submit by default?",
    "choices": [
      {
        "text": "To stop the field values being cleared",
        "correct": false,
        "why": "That is not what it prevents."
      },
      {
        "text": "React requires it in every handler",
        "correct": false,
        "why": "Only where a default action must not happen."
      },
      {
        "text": "To stop a reload that loses the app",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "To make validation run",
        "correct": false,
        "why": "Native validation runs before `submit`."
      }
    ]
  },
