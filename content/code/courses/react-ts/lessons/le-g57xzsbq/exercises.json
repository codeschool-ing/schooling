    "choices": [
      {
        "text": "`latest` points at a beta of version 8",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Version 7 is faster",
        "correct": false,
        "why": "Speed was not the reason."
      },
      {
        "text": "Version 8 was withdrawn",
        "correct": false,
        "why": "It is in beta, not withdrawn."
      },
      {
        "text": "Zod requires version 7",
        "correct": false,
        "why": "Zod does not depend on it."
      }
    ]
  },
