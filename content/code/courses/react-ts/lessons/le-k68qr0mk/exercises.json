  {
    "id": "ex-ht8g9tvt",
    "version": 1,
    "section": "eslint",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did ESLint and Oxlint word the refs finding the same way?",
    "hint": "Where does Oxlint's rule come from?",
    "choices": [
      {
        "text": "Oxlint calls ESLint underneath and prints what it says",
        "correct": false,
        "why": "It is written in Rust and runs alone."
      },
      {
        "text": "It is the same check, copied from the React plugin",
        "correct": true,
        "why": "Right: `react-hooks/refs`."
      },
      {
        "text": "Both read the message from `eslint.config.js`",
        "correct": false,
        "why": "Oxlint does not read it."
      },
      {
        "text": "By chance",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-ptr2930v",
    "version": 1,
    "section": "eslint",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "What can ESLint check that Oxlint, as set up here, does not?",
    "hint": "Rules that need the types.",
    "choices": [
      {
        "text": "Reading a ref while a component is rendering",
        "correct": false,
        "why": "Both found that."
      },
      {
        "text": "A hook called inside an `if`",
        "correct": false,
        "why": "Oxlint refused that in lesson 6."
      },
      {
        "text": "Unformatted code",
        "correct": false,
        "why": "That is Prettier."
      },
      {
        "text": "A promise nobody awaited",
        "correct": true,
        "why": "Right: that rule needs type information."
      }
    ]
  },
