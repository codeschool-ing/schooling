  {
    "id": "ex-vfx2t1g5",
    "version": 1,
    "section": "prettier",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why were the tools committed before `prettier --write` ran?",
    "hint": "What should the diff show?",
    "choices": [
      {
        "text": "Prettier refuses to run on files git has not seen yet",
        "correct": false,
        "why": "It runs on any."
      },
      {
        "text": "Committing formats the files",
        "correct": false,
        "why": "Not yet: there was no hook."
      },
      {
        "text": "So the diff shows only Prettier's changes",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "To undo it if it failed",
        "correct": false,
        "why": "Not the reason given."
      }
    ]
  },
