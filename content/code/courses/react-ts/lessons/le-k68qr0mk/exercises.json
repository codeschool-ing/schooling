        "correct": false,
        "why": "It only lists names."
      },
      {
        "text": "`@eslint/js`",
        "correct": false,
        "why": "ESLint's own rules."
      },
      {
        "text": "`eslint-plugin-react-refresh`, for hot reload",
        "correct": false,
