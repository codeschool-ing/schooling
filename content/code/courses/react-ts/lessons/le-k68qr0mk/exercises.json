[
  {
    "id": "ex-snf62pet",
    "version": 1,
    "section": "what-a-linter-catches",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does a linter do?",
    "hint": "It never starts the app.",
    "choices": [
      {
        "text": "Runs the tests and reports which of them failed",
        "correct": false,
        "why": "That is Vitest."
      },
      {
        "text": "Checks the types",
        "correct": false,
        "why": "That is `tsc`."
      },
      {
        "text": "Reads code without running it and points at likely mistakes",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Rewrites the layout of every file in the project",
        "correct": false,
        "why": "That is a formatter."
      }
    ]
  },
  {
    "id": "ex-qxah386e",
    "version": 1,
    "section": "what-a-linter-catches",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did TypeScript accept `console.log(heading.current)` in the middle of a render?",
    "hint": "What is wrong with the line?",
    "choices": [
      {
        "text": "TypeScript does not read files that contain hooks",
        "correct": false,
        "why": "It reads them."
      },
      {
        "text": "Its types are fine; what is wrong is when the line runs",
        "correct": true,
        "why": "Right: when it runs is a fact about React."
      },
      {
        "text": "`heading.current` has the type `any`",
        "correct": false,
        "why": "It is `HTMLHeadingElement | null`."
      },
      {
        "text": "Type checking was switched off for the course screen",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-gbtxz3nr",
    "version": 1,
    "section": "what-a-linter-catches",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Oxlint reported the ref as a warning. What happened to `npm run lint`?",
    "hint": "A warning tells you.",
    "choices": [
      {
        "text": "It failed, as it would on any finding at all",
        "correct": false,
        "why": "Warnings do not fail it."
      },
      {
        "text": "It fixed the line by itself",
        "correct": false,
        "why": "No."
      },
      {
        "text": "It asked whether to carry on with the other files",
        "correct": false,
        "why": "No."
      },
      {
        "text": "It still succeeded",
        "correct": true,
        "why": "Right: an error stops you, a warning does not."
      }
    ]
  },
  {
