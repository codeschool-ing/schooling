  {
    "id": "ex-emf5bvjy",
    "version": 1,
    "section": "source-maps",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Where should a release's source maps go?",
    "choices": [
      {
        "text": "Somewhere the team keeps, never served",
        "correct": true,
        "why": "Right, or to a crash reporter."
      },
      {
        "text": "Nowhere; delete them",
        "correct": false,
        "why": "Then crashes cannot be read."
      },
      {
        "text": "Inside the app, next to the bundle it maps",
        "correct": false,
        "why": "They would be served to users."
      },
      {
        "text": "Into the git history of the public repository, beside the code",
        "correct": false,
        "why": "Not served to users is the point."
      }
    ]
  },
