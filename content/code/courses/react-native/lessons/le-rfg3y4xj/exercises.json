        "text": "A secret",
        "correct": true,
        "why": "Right: it is text in the app."
      }
    ]
  },
  {
    "id": "ex-vdz0sww8",
    "version": 1,
    "section": "boundary",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is `ErrorBoundary` a class?",
    "choices": [
      {
        "text": "Classes are faster",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Catching a render error needs a class",
        "correct": true,
        "why": "Right: `getDerivedStateFromError`."
      },
      {
        "text": "React Native has no function components",
        "correct": false,
        "why": "It has."
      },
      {
        "text": "Because the planner was written before hooks existed and was never updated",
        "correct": false,
        "why": "The planner uses hooks everywhere else."
      }
    ]
  },
  {
    "id": "ex-qjf90g0g",
    "version": 1,
    "section": "boundary",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does the boundary wrap the navigation inside the providers rather than around them?",
    "choices": [
      {
        "text": "Providers cannot throw",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "A crash keeps the cache and the journal",
        "correct": true,
        "why": "Right: only the screens are replaced."
      },
      {
        "text": "React requires it",
        "correct": false,
        "why": "No."
      },
      {
        "text": "To make the error message use the theme's colours from the provider",
        "correct": false,
        "why": "Not the reason."
      }
    ]
  },
