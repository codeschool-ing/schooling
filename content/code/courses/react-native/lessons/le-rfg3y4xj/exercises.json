  {
    "id": "ex-dhsf5ja0",
    "version": 1,
    "section": "inlined",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A release built on a server without `EXPO_PUBLIC_API_URL` fails on every phone. Why does the developer's build work?",
    "choices": [
      {
        "text": "Its terminal had the variable set",
        "correct": true,
        "why": "Right: inlined into his bundle."
      },
      {
        "text": "The variable is read at launch",
        "correct": false,
        "why": "It is fixed at build time."
      },
      {
        "text": "Phones block the server",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Development builds ignore `localhost` and use the address of the computer instead",
        "correct": false,
        "why": "They use whatever was inlined."
      }
    ]
  },
  {
