    "section": "dev-vs-release",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why was the *Text strings must be rendered* sentence absent from the release bundle?",
    "choices": [
      {
        "text": "The planner has no text",
        "correct": false,
        "why": "It has plenty."
      },
      {
        "text": "Hermes translates it",
        "correct": false,
        "why": "Bytecode keeps strings as they are."
      },
      {
        "text": "The check is development-only",
        "correct": true,
        "why": "Right: removed with `__DEV__`."
      },
      {
        "text": "Bundles are compressed",
        "correct": false,
        "why": "A search would still find it."
      }
    ]
  },
  {
    "id": "ex-3cn47wmm",
