        "correct": false,
        "why": "That is fine."
      },
      {
        "text": "A feature flag",
        "correct": false,
        "why": "Fine, if it is not secret."
      },
      {
        "text": "A plain number",
        "correct": false,
        "why": "Numbers are fine."
      },
