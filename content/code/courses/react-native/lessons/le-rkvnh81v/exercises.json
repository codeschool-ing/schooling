  {
    "id": "ex-z7m8hxz2",
    "version": 1,
    "section": "what-may",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "An update calls a native module the build does not contain. What happens?",
    "choices": [
      {
        "text": "The module is downloaded",
        "correct": false,
        "why": "Native code cannot arrive that way."
      },
      {
        "text": "The call is skipped",
        "correct": false,
        "why": "It throws."
      },
      {
        "text": "The store blocks the update before it reaches a phone, after checking the bundle",
        "correct": false,
        "why": "The store never sees it."
      },
      {
        "text": "It crashes on that call",
        "correct": true,
        "why": "Right, on every phone that took it."
      }
    ]
  },
  {
