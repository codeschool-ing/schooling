    "section": "what-ota",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does an over-the-air update download?",
    "choices": [
      {
        "text": "The Kotlin code",
        "correct": false,
        "why": "Native code is in the build."
      },
      {
        "text": "A new APK",
        "correct": false,
        "why": "That is a store release."
      },
      {
        "text": "A JavaScript bundle and its assets",
        "correct": true,
        "why": "Right: what `expo export` writes."
      },
      {
        "text": "Permissions",
        "correct": false,
        "why": "Those are native."
      }
    ]
  },
  {
    "id": "ex-06n6v1ym",
    "version": 1,
    "section": "what-ota",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why are the files of an export named by their content's hash?",
    "choices": [
      {
        "text": "A phone downloads only what it lacks",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "To hide them",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Stores require it",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "So that two builds of the same app cannot ever run the same bundle at the same time on one phone",
        "correct": false,
        "why": "No."
      }
    ]
  },
