    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does the planner use the `fingerprint` policy rather than `appVersion`?",
    "choices": [
      {
        "text": "`appVersion` is deprecated",
        "correct": false,
        "why": "It is not."
      },
      {
        "text": "It changes when the native side does, and only then",
        "correct": true,
        "why": "Right: nobody has to remember."
      },
      {
        "text": "It is shorter",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Stores require it",
        "correct": false,
        "why": "They know nothing of it."
      }
    ]
  },
