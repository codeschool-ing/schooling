[
  {
    "id": "ex-dpdfkggg",
    "version": 1,
    "section": "permissions",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "When should the planner ask for the camera?",
    "choices": [
      {
        "text": "At launch, with every other permission",
        "correct": false,
        "why": "Without context the answer is no."
      },
      {
        "text": "During installation from the store, before the app is first opened",
        "correct": false,
        "why": "The store grants nothing at install."
      },
      {
        "text": "When *Take a photo* is pressed",
        "correct": true,
        "why": "Right: the person knows why."
      },
      {
        "text": "After the photo is taken",
        "correct": false,
        "why": "The camera cannot open first."
      }
    ]
  },
  {
    "id": "ex-tqpg8cka",
    "version": 1,
    "section": "permissions",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A request returns `granted: false, canAskAgain: false`. What does the planner offer?",
    "choices": [
      {
        "text": "An explanation and a way to Settings",
        "correct": true,
        "why": "Right: only the person can change it now."
      },
      {
        "text": "Nothing; it hides the button",
        "correct": false,
        "why": "The person deserves to know why."
      },
      {
        "text": "A second request straight away",
        "correct": false,
        "why": "It would return the same answer, with no dialog."
      },
      {
        "text": "A reinstall of the app, which resets every permission it was ever given",
        "correct": false,
        "why": "Nobody should be asked that."
      }
    ]
  },
  {
    "id": "ex-2f9cm8b4",
    "version": 1,
    "section": "permissions",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does choosing a photo from the library need no permission?",
    "choices": [
      {
        "text": "Photos are public data",
        "correct": false,
        "why": "They are not."
      },
      {
        "text": "It does need one on Android, but only on Android",
        "correct": false,
        "why": "Neither platform needs it with the system picker."
      },
      {
        "text": "Expo grants it automatically",
        "correct": false,
        "why": "Nothing is granted."
      },
      {
        "text": "The system picker hands over only the chosen photo",
        "correct": true,
        "why": "Right: the app never sees the rest."
      }
    ]
  },
  {
    "id": "ex-2djfemd3",
    "version": 1,
    "section": "permissions",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each answer with what the app does.",
    "pairs": [
      {
        "left": "granted",
        "right": "goes on"
      },
      {
        "left": "refused, can ask again",
        "right": "explains and offers another way"
      },
      {
        "left": "refused, cannot ask again",
        "right": "explains and offers Settings"
      }
    ],
    "right_distractors": [
      "asks again at once"
    ]
  },
  {
    "id": "ex-9bhscbkz",
    "version": 1,
    "section": "declaring",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What is `cameraPermission` in the image picker's plugin options?",
    "choices": [
      {
        "text": "A switch that grants the camera",
        "correct": false,
        "why": "Only the person grants."
      },
      {
        "text": "The sentence iOS shows when it asks",
        "correct": true,
        "why": "Right, as `NSCameraUsageDescription`."
      },
      {
        "text": "The Android permission name",
        "correct": false,
        "why": "That comes from the library's manifest."
      },
      {
        "text": "A message for the store's reviewers, which never reaches the person using the app",
        "correct": false,
        "why": "The person reads it in the dialog."
      }
    ]
  },
  {
    "id": "ex-4ha65yyw",
    "version": 1,
    "section": "declaring",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "`CAMERA` is missing from the generated `AndroidManifest.xml`, yet the built app declares it. Why?",
    "choices": [
      {
        "text": "Prebuild failed",
        "correct": false,
        "why": "It succeeded."
      },
      {
        "text": "Gradle merges in the library's manifest",
        "correct": true,
        "why": "Right: each library carries one."
      },
      {
        "text": "The plugin writes it after the build has finished, into the APK itself",
        "correct": false,
        "why": "Plugins run during prebuild."
      },
      {
        "text": "Android adds the camera to every app",
        "correct": false,
        "why": "It does not."
      }
    ]
  },
