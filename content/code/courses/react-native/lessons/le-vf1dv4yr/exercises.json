        "text": "Point at the library",
        "correct": false,
        "why": "It does that."
      },
      {
        "text": "Announce the sentence",
        "correct": false,
        "why": "It is a `role=\"alert\"`."
      },
      {
        "text": "Ask again",
        "correct": true,
        "why": "Right: not straight away; the next press asks."
      },
      {
        "text": "Keep working without the camera, through the other button beside it",
        "correct": false,
        "why": "It does keep working."
      }
    ]
