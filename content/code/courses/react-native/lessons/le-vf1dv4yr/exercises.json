  {
    "id": "ex-mv1yknjg",
    "version": 1,
    "section": "picker",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A picked photo's `uri` points into the app's cache. Why is that a problem for keeping it?",
    "choices": [
      {
        "text": "Other apps can read the cache",
        "correct": false,
        "why": "They cannot."
      },
      {
        "text": "Images in the cache cannot be shown",
        "correct": false,
        "why": "They can."
      },
      {
        "text": "The cache is wiped every time the screen redraws itself",
        "correct": false,
        "why": "Not that often."
      },
      {
        "text": "The system may empty it",
        "correct": true,
        "why": "Right: when space runs short."
      }
    ]
  },
  {
    "id": "ex-t4wwbjvx",
    "version": 1,
    "section": "picker",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does a cancelled picker return?",
    "choices": [
      {
        "text": "`canceled: true`, and `assets: null`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "An empty photo",
        "correct": false,
        "why": "There is no photo."
      },
      {
        "text": "It throws an error",
        "correct": false,
        "why": "It resolves normally."
      },
      {
        "text": "The previous photo again",
        "correct": false,
        "why": "Nothing is remembered."
      }
    ]
  },
  {
    "id": "ex-qn6teh10",
    "version": 1,
    "section": "camera",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "After a first refusal, the planner shows a sentence. What does it NOT do?",
    "choices": [
