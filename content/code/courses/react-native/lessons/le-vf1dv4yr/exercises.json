  {
    "id": "ex-e7yfydw8",
    "version": 1,
    "section": "files",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does `keepPhoto` copy into `Paths.document`?",
    "choices": [
      {
        "text": "The system does not clear it",
        "correct": true,
        "why": "Right: kept until uninstall."
      },
      {
        "text": "Other apps can share it from there",
        "correct": false,
        "why": "No other app can read it."
      },
      {
        "text": "The picker refuses to show photos that stay in the cache folder",
        "correct": false,
        "why": "It shows them fine."
      },
      {
        "text": "It is faster than the cache",
        "correct": false,
        "why": "Not the reason."
      }
    ]
  },
  {
