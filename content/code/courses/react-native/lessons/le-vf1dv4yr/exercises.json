      {
        "text": "`expo-file-system` writes to the browser's disk",
        "correct": false,
        "why": "It does not run there."
      },
      {
        "text": "Metro takes `keepPhoto.web.ts` instead",
        "correct": true,
        "why": "Right: a platform file."
      },
      {
        "text": "It stores the photo on the server",
        "correct": false,
        "why": "Nothing is uploaded."
      }
    ]
