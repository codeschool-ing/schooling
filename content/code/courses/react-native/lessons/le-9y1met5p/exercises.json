    "drillable": true,
    "prompt": "Why is the reminder's date written without a `Z`?",
    "choices": [
      {
        "text": "Notifications ignore time zones",
        "correct": false,
        "why": "They do not."
      },
      {
        "text": "`Z` is not valid in JavaScript",
        "correct": false,
        "why": "It is."
      },
      {
        "text": "So that the reminder arrives at the same instant on every phone in every country",
        "correct": false,
        "why": "That is the opposite of what a person means."
      },
      {
        "text": "Six in the evening means the phone's own time",
        "correct": true,
        "why": "Right: with `Z` it would be Greenwich."
      }
    ]
