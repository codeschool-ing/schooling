  {
    "id": "ex-bnq8v591",
    "version": 1,
    "section": "javascript-side",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why is `firstWeekday` a `Function` and not an `AsyncFunction`?",
    "choices": [
      {
        "text": "Async functions are slower to write",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Swift cannot be async",
        "correct": false,
        "why": "It can."
      },
      {
        "text": "The text is right on the first render",
        "correct": true,
        "why": "Right: no effect, no loading state."
      },
      {
        "text": "Because an `AsyncFunction` would not run on the web, where the browser answers instead",
        "correct": false,
        "why": "The web version is a class either way."
      }
    ]
