  {
    "id": "ex-g7rkxzn5",
    "version": 1,
    "section": "native-code",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why does `firstWeekday` subtract one?",
    "choices": [
      {
        "text": "Arrays start at 0 in Kotlin",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "Calendar's Sunday is 1; `getDay()`'s is 0",
        "correct": true,
        "why": "Right: both platforms count from 1."
      },
      {
        "text": "To make Monday the first day",
        "correct": false,
        "why": "It keeps whatever the calendar says."
      },
      {
        "text": "Because JSI adds one to each number that it passes over to JavaScript",
        "correct": false,
        "why": "It adds nothing."
      }
    ]
  },
  {
    "id": "ex-kphdmt4e",
    "version": 1,
    "section": "native-code",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A native function reads a large file. What should it be?",
    "choices": [
      {
        "text": "A `Function`",
        "correct": false,
        "why": "That blocks the JavaScript thread."
      },
      {
        "text": "A `View`",
        "correct": false,
        "why": "That is for components."
      },
      {
        "text": "`Events`",
        "correct": false,
        "why": "Those are for values over time."
      },
      {
        "text": "An `AsyncFunction`",
        "correct": true,
        "why": "Right: a promise in JavaScript."
      }
    ]
  },
