    "drillable": true,
    "prompt": "Why `-storepass:env PLANNER_KEY_PASSWORD` rather than the password itself?",
    "choices": [
      {
        "text": "So that the password is written into the keystore itself",
        "correct": false,
        "why": "No."
      },
      {
        "text": "keytool requires it",
        "correct": false,
        "why": "It accepts both."
      },
      {
        "text": "It encrypts the keystore twice",
        "correct": false,
        "why": "No."
      },
      {
        "text": "It stays out of history and the process list",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
