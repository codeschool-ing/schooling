[
  {
    "id": "ex-9ewav16p",
    "version": 1,
    "section": "signing",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "When does a phone accept an update to an installed app?",
    "choices": [
      {
        "text": "When its version is higher",
        "correct": false,
        "why": "Necessary, not enough."
      },
      {
        "text": "When it comes from a store",
        "correct": false,
        "why": "Not the rule."
      },
      {
        "text": "When it is signed by the same key",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "When the person confirms it",
        "correct": false,
        "why": "The key decides."
      }
    ]
  },
  {
    "id": "ex-yvwvgjy3",
    "version": 1,
    "section": "signing",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "With Play App Signing, what happens if you lose the upload key?",
    "choices": [
      {
        "text": "Play can replace it when you ask",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Users must reinstall",
        "correct": false,
        "why": "Phones see Google's key."
      },
      {
        "text": "The app can never be updated",
        "correct": false,
        "why": "That was before Play App Signing."
      },
      {
        "text": "Google keeps a copy of the upload key as well as of the app signing key",
        "correct": false,
        "why": "It keeps only the app signing key."
      }
    ]
  },
  {
