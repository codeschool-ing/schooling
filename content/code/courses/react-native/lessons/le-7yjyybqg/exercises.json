  {
    "id": "ex-n5tna69h",
    "version": 1,
    "section": "release-build",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Expo's template builds a release with no keystore given. What signs it?",
    "choices": [
      {
        "text": "Nothing; it is unsigned",
        "correct": false,
        "why": "Phones refuse unsigned apps."
      },
      {
        "text": "The debug key",
        "correct": true,
        "why": "Right: `CN=Android Debug`."
      },
      {
        "text": "Google's key",
        "correct": false,
        "why": "Only Play adds that."
      },
      {
        "text": "A fresh key per release build, thrown away when the build ends",
        "correct": false,
        "why": "It is the same debug key every time."
      }
    ]
  },
  {
    "id": "ex-n0sr1t7n",
    "version": 1,
    "section": "release-build",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why pass `android.injected.signing.*` on the command line instead of editing `build.gradle`?",
    "choices": [
      {
        "text": "Gradle forbids editing",
        "correct": false,
        "why": "It does not."
      },
      {
        "text": "The file is generated; an edit would be lost",
        "correct": true,
        "why": "Right: lesson 2's rule."
      },
      {
        "text": "Because a password in `build.gradle` would be readable by each module of the project",
        "correct": false,
        "why": "It can read variables."
      },
      {
        "text": "It is faster",
        "correct": false,
        "why": "Not the reason."
      }
    ]
  },
  {
    "id": "ex-3782qwbb",
    "version": 1,
    "section": "release-build",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does Google Play take?",
    "choices": [
      {
        "text": "A debug APK",
        "correct": false,
        "why": "Never."
      },
      {
        "text": "The keystore",
        "correct": false,
        "why": "Never."
      },
      {
        "text": "The JavaScript bundle on its own",
        "correct": false,
        "why": "It goes inside the app."
      },
      {
        "text": "An AAB",
        "correct": true,
        "why": "Right: Play builds each phone's APK from it."
      }
    ]
