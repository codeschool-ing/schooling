  {
    "id": "ex-g8rqzee4",
    "version": 1,
    "section": "security",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does contextIsolation keep out of the page's reach?",
    "choices": [
      {
        "text": "The DOM",
        "correct": false,
        "why": "The page has its DOM."
      },
      {
        "text": "localStorage",
        "correct": false,
        "why": "The page has it."
      },
      {
        "text": "The network",
        "correct": false,
        "why": "That is the CSP's job, partly."
      },
      {
        "text": "ipcRenderer, and the preload's variables",
        "correct": true,
        "why": "Right, so the page cannot invoke a channel of its choosing."
      }
    ]
  },
  {
    "id": "ex-nkjkr773",
    "version": 1,
    "section": "security",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "A colleague's preload exposes send: (channel, data) => ipcRenderer.invoke(channel, data) to save typing. What does the lesson's table say is wrong?",
    "choices": [
      {
        "text": "Nothing, since contextIsolation is still on",
        "correct": false,
        "why": "The door is now as wide as every handler there is."
      },
      {
        "text": "invoke is slower than send",
        "correct": false,
        "why": "Not the point."
      },
      {
        "text": "It cannot be checked",
        "correct": true,
        "why": "Right: a general send cannot be checked. Expose small, specific functions."
      },
      {
        "text": "The preload must be ES modules",
        "correct": false,
        "why": "The opposite."
      }
    ]
  },
