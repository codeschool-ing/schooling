  {
    "id": "ex-kgth900a",
    "version": 1,
    "section": "first-window",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why does the lesson prefer a custom scheme to Vite's base: \"./\"?",
    "choices": [
      {
        "text": "base is not supported by Vite 8",
        "correct": false,
        "why": "It is."
      },
      {
        "text": "fetch would still fail on file://",
        "correct": true,
        "why": "Right. A served origin mends both."
      },
      {
        "text": "base breaks the phone build of lesson 2",
        "correct": false,
        "why": "Not the reason given."
      },
      {
        "text": "Relative paths are slower",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-6r0cdj4m",
    "version": 1,
