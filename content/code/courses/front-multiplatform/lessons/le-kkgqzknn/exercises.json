    "prompt": "What does protocol.handle refuse, and why?",
    "choices": [
      {
        "text": "Requests for JSON, which the page should never fetch",
        "correct": false,
        "why": "courses.json is fetched through it."
      },
      {
        "text": "Everything before the window is shown",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Requests from Playwright",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Leaving dist/",
        "correct": true,
        "why": "Right: a crafted .. in an address could otherwise read other files."
      }
    ]
  },
