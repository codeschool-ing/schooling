[
  {
    "id": "ex-2776knqy",
    "version": 1,
    "section": "two-processes",
    "type": "matching",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Match each part of the planner's Electron app to what it is.",
    "pairs": [
      {
        "left": "electron/main.mjs",
        "right": "the main process, in Node.js"
      },
      {
        "left": "the window",
        "right": "a renderer: a Chromium page"
      },
      {
        "left": "electron/preload.cjs",
        "right": "puts window.desktop on the page"
      }
    ],
    "right_distractors": [
      "a WebView the system provides"
    ]
  },
  {
    "id": "ex-7784w2d7",
    "version": 1,
    "section": "two-processes",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is a page that can require(\"fs\") dangerous, by the lesson?",
    "choices": [
      {
        "text": "It loads more slowly",
        "correct": false,
        "why": "Not the danger."
      },
      {
        "text": "Chromium refuses to draw it",
        "correct": false,
        "why": "It would draw."
      },
      {
        "text": "Any injected script could read and delete files",
        "correct": true,
        "why": "Right, with the user's permissions."
      },
      {
        "text": "The store rejects apps whose pages use Node",
        "correct": false,
        "why": "Not the lesson's reason."
      }
    ]
  },
  {
    "id": "ex-zqq2c2mw",
    "version": 1,
    "section": "two-processes",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the smallest Electron app bigger than the planner's whole web build?",
    "choices": [
      {
        "text": "It carries its own Chromium and Node.js",
        "correct": true,
        "why": "Right, in every app."
      },
      {
        "text": "It includes every npm package",
        "correct": false,
        "why": "No."
      },
      {
        "text": "Electron compiles the web code into native code, which is larger",
        "correct": false,
        "why": "Nothing is compiled; the page runs as it is."
      },
      {
        "text": "It adds a second copy of dist/",
        "correct": false,
        "why": "No."
      }
    ]
  },
  {
    "id": "ex-gqxv2eba",
