  {
    "id": "ex-cpn924z5",
    "version": 1,
    "section": "preload-and-ipc",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the preload a .cjs file?",
    "choices": [
      {
        "text": "Electron cannot run ES modules anywhere",
        "correct": false,
        "why": "main.mjs is an ES module."
      },
      {
        "text": "CommonJS is faster",
        "correct": false,
        "why": "Not the reason."
      },
      {
        "text": "A sandboxed preload cannot load ES modules",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Vite builds it",
        "correct": false,
        "why": "Vite does not touch it."
      }
    ]
  },
