  {
    "id": "ex-axaqb058",
    "version": 1,
    "section": "in-pandas",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Which pandas defaults did earlier lessons have to override? Choose all that apply.",
    "hint": "Types, losses, blank keys.",
    "choices": [
      {
        "text": "`read_csv` guessing types",
        "correct": true,
        "why": "Yes: `dtype=str`."
      },
      {
        "text": "`errors=\"coerce\"` hiding losses",
        "correct": true,
        "why": "Yes: the count beside it."
      },
      {
        "text": "`groupby` dropping blank keys",
        "correct": true,
        "why": "Yes: `dropna=False`."
      },
      {
        "text": "`merge` refusing repeated keys",
        "correct": false,
        "why": "It does not refuse; `validate` makes it."
      }
    ]
  },
  {
    "id": "ex-e8110xfe",
    "version": 1,
    "section": "in-pandas",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "The pandas totals are floats yet match SQL's `numeric` to the centavo. Why did lesson 7 still use `Decimal`?",
    "hint": "How long is the chain of arithmetic?",
    "choices": [
      {
        "text": "pandas cannot sum floats correctly",
        "correct": false,
        "why": "It sums them as floats do."
      },
      {
        "text": "Long float chains drift",
        "correct": true,
        "why": "Right; short sums round back."
      },
      {
        "text": "`Decimal` is faster than float",
        "correct": false,
        "why": "It is slower."
      },
      {
        "text": "The shops' file has three decimals",
        "correct": false,
        "why": "It has two."
      }
    ]
  },
  {
    "id": "ex-39w9hpj2",
    "version": 1,
    "section": "in-dplyr",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What is readr's equivalent of pandas' `dtype=str`?",
    "hint": "A default column type.",
    "choices": [
      {
        "text": "`distinct()`",
        "correct": false,
        "why": "That removes repeated rows."
      },
      {
        "text": "`pmax(..., 0)`",
        "correct": false,
        "why": "That clips at zero."
      },
      {
        "text": "`as.numeric(total)`",
        "correct": false,
        "why": "That converts one column."
      },
      {
        "text": "`col_types = cols(.default = col_character())`",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
