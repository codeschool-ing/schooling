        "correct": false,
        "why": "It is for people."
      },
      {
        "text": "Every version is checked against it",
        "correct": true,
        "why": "Right: a specification a person can check."
      },
      {
        "text": "Because words run faster than code",
        "correct": false,
        "why": "Words do not run."
      }
    ]
