  {
    "id": "ex-zskwmrrt",
    "version": 1,
    "section": "one-task",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A site order placed at 22:30 on 30 November in São Paulo is written with which date?",
    "hint": "UTC is three hours ahead.",
    "choices": [
      {
        "text": "30 November, in local time",
        "correct": false,
        "why": "The site writes UTC."
      },
      {
        "text": "29 November, three hours earlier",
        "correct": false,
        "why": "UTC is ahead, not behind."
      },
      {
        "text": "No date, only the time",
        "correct": false,
        "why": "Every timestamp has a date."
      },
      {
        "text": "1 December, in UTC",
        "correct": true,
        "why": "Right: ignore the `Z` and it lands in December."
      }
    ]
  },
  {
    "id": "ex-exkkx0an",
    "version": 1,
    "section": "in-sql",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "What does `SELECT DISTINCT *` remove?",
    "hint": "Every column is compared.",
    "choices": [
      {
        "text": "Rows that repeat the order number",
        "correct": false,
        "why": "That would be a key."
      },
      {
        "text": "Rows that repeat in every column",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Rows with any blank value",
        "correct": false,
        "why": "Blanks are kept."
      },
      {
        "text": "Cancelled orders",
        "correct": false,
        "why": "The `WHERE` does that."
      }
    ]
  },
  {
    "id": "ex-njdm7r3w",
    "version": 1,
    "section": "in-sql",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Which SQL function turns a negative total into zero in `task.sql`?",
    "hint": "The larger of two values.",
    "choices": [
      {
        "text": "`coalesce`",
        "correct": false,
        "why": "That picks the first non-blank."
      },
      {
        "text": "`abs(total)`",
        "correct": false,
        "why": "That would make it positive."
      },
      {
        "text": "`greatest`",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "`round`",
        "correct": false,
        "why": "That rounds."
      }
    ]
  },
  {
    "id": "ex-dvwvmmeb",
    "version": 1,
    "section": "in-sql",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
