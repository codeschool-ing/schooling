        "why": "That ignores the conversion."
      },
      {
        "text": "Gives 04:30 on 1 December",
        "correct": false,
        "why": "That goes the wrong way."
      },
      {
        "text": "Stops with an error",
        "correct": false,
        "why": "The `Z` is valid input."
      }
    ]
