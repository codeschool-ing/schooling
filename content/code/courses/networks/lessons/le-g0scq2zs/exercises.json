  {
    "id": "ex-z0pym725",
    "version": 1,
    "section": "method",
    "type": "ordering",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Put the five checks in the order they are made.",
    "hint": "From the bottom.",
    "items": [
      "The interface has an address",
      "The gateway answers",
      "A far address answers",
      "A name resolves",
      "The service answers on its port"
    ],
    "trap": "Testing the name before a far address can blame DNS for a route that is missing."
  },
  {
    "id": "ex-63zatrc2",
    "version": 1,
    "section": "method",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why test with an address as well as a name?",
    "hint": "A name involves one more thing.",
    "choices": [
      {
        "text": "Addresses are faster to type",
        "correct": false,
        "why": "Speed of typing is not it."
      },
      {
        "text": "Routers refuse names",
        "correct": false,
        "why": "Routers never see names at all."
      },
      {
        "text": "Only a name needs DNS",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Names only work over IPv6",
        "correct": false,
        "why": "Names resolve to both."
      }
    ]
  },
  {
    "id": "ex-j91d5zqp",
    "version": 1,
    "section": "method",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Steps 1 to 3 pass and step 4 fails. Where is the fault?",
    "hint": "The first step that fails.",
    "choices": [
      {
        "text": "In the cable or the interface",
        "correct": false,
        "why": "Step 1 passed."
      },
      {
        "text": "In name resolution",
        "correct": true,
        "why": "Right. Step 4 is DNS."
      },
      {
        "text": "In the web server",
        "correct": false,
        "why": "Step 5 was never reached."
      },
      {
        "text": "Nowhere yet; test step 5 first",
        "correct": false,
        "why": "A step above a failure proves nothing."
      }
    ]
  },
  {
    "id": "ex-38x09591",
    "version": 1,
    "section": "no-gateway",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "With no default route, ping www.example.com said Temporary failure in name resolution. Why a DNS error?",
    "hint": "Where is the DNS server?",
    "choices": [
      {
        "text": "It was unreachable too",
        "correct": true,
        "why": "Right. It could not be reached either."
      },
      {
        "text": "The DNS server had stopped",
        "correct": false,
        "why": "It was fine; unreachable."
      },
      {
        "text": "ping always blames DNS first",
        "correct": false,
        "why": "It reported what failed first."
      },
      {
        "text": "The name was misspelt",
        "correct": false,
        "why": "It resolved once the route was back."
      }
    ]
  },
