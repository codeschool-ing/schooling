  {
    "id": "ex-6059p1a7",
    "version": 1,
    "section": "wrong-dns",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why did tcpdump show ARP requests and no DNS query?",
    "hint": "192.168.10.53 is on the office network.",
    "choices": [
      {
        "text": "tcpdump cannot see DNS",
        "correct": false,
        "why": "It can; port 53 was in the filter."
      },
      {
        "text": "ARP for it got no reply",
        "correct": true,
        "why": "Right. The query needs a MAC first."
      },
      {
        "text": "DNS is carried inside ARP",
        "correct": false,
        "why": "They are separate."
      },
      {
        "text": "The router blocked the query",
        "correct": false,
        "why": "The query never reached it."
      }
    ]
  },
