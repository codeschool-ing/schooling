      },
      {
        "left": "ra",
        "right": "This server recurses"
      },
      {
        "left": "aa",
        "right": "The zone's own server answered"
      }
    ],
    "right_distractors": [
      "The answer is encrypted"
    ]
  },
  {
    "id": "ex-48ns4gjw",
    "version": 1,
    "section": "asking-dns",
    "type": "ordering",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Put the fields of an answer line in the order dig prints them.",
    "hint": "www.example.com. 300 IN A 192.0.2.80",
