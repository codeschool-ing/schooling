  {
    "id": "ex-jpv9zrte",
    "version": 1,
    "section": "asking-dns",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each dig header flag to its meaning.",
    "hint": "qr rd ra, and one more.",
