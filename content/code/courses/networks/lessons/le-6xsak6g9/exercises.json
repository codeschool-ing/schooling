  {
    "id": "ex-hzxgfq76",
    "version": 1,
    "section": "record-types",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Asking for shop.example.com returned two lines. Why?",
    "hint": "An alias.",
    "choices": [
      {
        "text": "The resolver followed the CNAME",
        "correct": true,
        "why": "Right. Alias, then the A of www."
      },
      {
        "text": "shop has two addresses",
        "correct": false,
        "why": "The second line is www's."
      },
      {
        "text": "dig asked twice",
        "correct": false,
        "why": "One question, one answer with two records."
      },
      {
        "text": "It is a mistake in the zone",
        "correct": false,
        "why": "It is how aliases work."
      }
    ]
  },
  {
