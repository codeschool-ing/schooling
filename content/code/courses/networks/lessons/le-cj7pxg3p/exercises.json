  {
    "id": "ex-y1t1052n",
    "version": 1,
    "section": "seven-layers",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "The office switch loses power. Which layers stop working for the laptops plugged into it?",
    "hint": "Each layer uses the one below.",
    "choices": [
      {
        "text": "Layer 1 and every layer above",
        "correct": true,
        "why": "Right. A layer fails with the ones below it."
      },
      {
        "text": "Only layers 1 and 2",
        "correct": false,
        "why": "Everything above them needs them."
      },
      {
        "text": "Only the application",
        "correct": false,
        "why": "The application is only where it shows."
      },
      {
        "text": "None, the router takes over",
        "correct": false,
        "why": "The router is on the other side of the switch."
      }
    ]
  },
  {
    "id": "ex-7xj2s716",
    "version": 1,
    "section": "seven-layers",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why is the OSI model still taught, when its own protocols lost to TCP/IP?",
    "hint": "Think of the reception's call.",
    "choices": [
      {
        "text": "The internet still runs on it",
        "correct": false,
        "why": "It runs on TCP/IP."
      },
      {
        "text": "Exams require it",
        "correct": false,
        "why": "That is not a reason to learn it."
      },
      {
        "text": "It replaced TCP/IP when ISO published it in 1984",
        "correct": false,
        "why": "It was published in 1984, and lost."
      },
      {
        "text": "It turns a vague fault into ordered questions",
        "correct": true,
        "why": "Right."
      }
    ]
  },
  {
    "id": "ex-v5jacj2q",
    "version": 1,
    "section": "seven-layers",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "Why does a round trip across the course's lab internet take a fraction of a millisecond?",
    "hint": "Where is the lab?",
    "choices": [
      {
        "text": "Its links are fibre",
        "correct": false,
        "why": "There are no physical links."
      },
      {
        "text": "The routers are very fast",
        "correct": false,
        "why": "They are the same computer."
      },
      {
        "text": "It is one computer",
        "correct": true,
        "why": "Right. Every machine is a namespace on it."
      },
      {
        "text": "The times are made up",
        "correct": false,
        "why": "They were measured."
      }
    ]
  },
  {
    "id": "ex-d9cghb0f",
    "version": 1,
    "section": "link-layer",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "ip link shows eth0 with UP but not LOWER_UP. What is the likely cause?",
    "hint": "Switched on, no signal.",
    "choices": [
      {
        "text": "The DNS server is down",
        "correct": false,
        "why": "That is far above the link."
      },
      {
        "text": "The IP address is wrong",
        "correct": false,
        "why": "An address is layer 3; this is below it."
      },
      {
        "text": "No cable, or nothing live at its end",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "The interface was switched off",
        "correct": false,
        "why": "Then UP would be missing too."
      }
    ]
  },
