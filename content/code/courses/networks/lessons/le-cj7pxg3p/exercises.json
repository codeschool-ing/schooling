  {
    "id": "ex-4twxf2vk",
    "version": 1,
    "section": "link-layer",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Does a router forward a frame's MAC address to the next network?",
    "hint": "A MAC means something only on its link.",
    "choices": [
      {
        "text": "Yes, unchanged",
        "correct": false,
        "why": "It builds a new frame for the next link."
      },
      {
        "text": "No, each link gets new MACs",
        "correct": true,
        "why": "Right. The IP addresses travel; the MACs do not."
      },
      {
        "text": "Yes, if the switch allows it",
        "correct": false,
        "why": "Switches do not route."
      },
      {
        "text": "Only for broadcast",
        "correct": false,
        "why": "Broadcasts stop at the router."
      }
    ]
  },
  {
    "id": "ex-anse82cy",
    "version": 1,
    "section": "link-layer",
    "type": "quiz",
    "difficulty": "easy",
    "drillable": true,
    "prompt": "After the ping, ip neigh lists the server as REACHABLE. What does the laptop gain?",
    "hint": "A cache.",
    "choices": [
      {
        "text": "A faster cable",
        "correct": false,
        "why": "Nothing physical changed."
      },
      {
        "text": "A route to the internet",
        "correct": false,
        "why": "Routes are a different table."
      },
      {
        "text": "A permanent MAC entry",
        "correct": false,
        "why": "Entries expire and are asked again."
      },
      {
        "text": "No ARP for the next packets",
        "correct": true,
        "why": "Right. It knows the MAC for now."
      }
    ]
  },
