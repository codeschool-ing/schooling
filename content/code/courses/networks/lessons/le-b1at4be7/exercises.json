[
  {
    "id": "ex-fc17dj5p",
    "version": 1,
    "section": "what-a-certificate-says",
    "type": "matching",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Match each certificate field to what it says.",
    "hint": "openssl x509 printed them.",
    "pairs": [
      {
        "left": "subject",
        "right": "Who it is about"
      },
      {
        "left": "issuer",
        "right": "Who signed it"
      },
      {
        "left": "notAfter",
        "right": "When it stops being valid"
      },
      {
        "left": "Subject Alternative Name",
        "right": "The names it covers"
      }
    ],
    "right_distractors": [
      "The server's password"
    ]
  },
  {
    "id": "ex-83tsb3tk",
    "version": 1,
    "section": "what-a-certificate-says",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Which field do clients actually check the name against?",
    "hint": "Section 02.",
