      {
        "text": "The two trust stores",
        "correct": true,
        "why": "Right. Java often carries its own."
      },
      {
        "text": "The PC's clock only",
        "correct": false,
        "why": "Both would see the same clock."
      },
      {
        "text": "The Wi-Fi",
        "correct": false,
        "why": "The network is shared."
      }
    ]
  },
