  {
    "id": "ex-4h4t4cxh",
    "version": 1,
    "section": "trust-store",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What makes Example Root CA a root?",
    "hint": "Compare subject and issuer.",
    "choices": [
      {
        "text": "It is the oldest certificate in the store",
        "correct": false,
        "why": "Age does not make a root."
      },
      {
        "text": "Its name ends in Root CA",
        "correct": false,
        "why": "The name is only a name."
      },
      {
        "text": "It signed itself",
        "correct": true,
        "why": "Right. Subject and issuer are the same."
      },
      {
        "text": "It is valid for ten years",
        "correct": false,
        "why": "Long validity is common, not defining."
      }
    ]
  },
  {
