  {
    "id": "ex-cje70kxr",
    "version": 1,
    "section": "what-a-certificate-says",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "A server's private key is copied by an attacker. What is the fix?",
    "hint": "The certificate is public anyway.",
    "choices": [
      {
        "text": "A new key and a new certificate",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Change the server's password",
        "correct": false,
        "why": "The key is what proves ownership."
      },
      {
        "text": "Restart nginx",
        "correct": false,
        "why": "It would load the same key."
      },
      {
        "text": "Nothing; the certificate is still valid",
        "correct": false,
        "why": "That is exactly the danger."
      }
    ]
  },
  {
    "id": "ex-t2p5rxx0",
    "version": 1,
    "section": "what-a-certificate-says",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does CA:FALSE in www.example.com's certificate forbid?",
    "hint": "Basic Constraints.",
    "choices": [
      {
        "text": "Signing other certificates",
        "correct": true,
        "why": "Right."
      },
      {
        "text": "Serving HTTPS",
        "correct": false,
        "why": "That is what it is for."
      },
      {
        "text": "Being renewed",
        "correct": false,
        "why": "Renewal is a new certificate."
      },
      {
        "text": "Covering more than one name",
        "correct": false,
        "why": "It covers three."
      }
    ]
  },
  {
    "id": "ex-ne0snx0a",
    "version": 1,
    "section": "chain-of-trust",
    "type": "ordering",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Put the chain in order, from the certificate the server presents up to the root.",
    "hint": "depth 0 to depth 2.",
    "items": [
      "www.example.com",
      "Example Issuing CA 1",
      "Example Root CA"
    ],
    "trap": "The root sits at the top, and the client already has it; the server's own certificate is at depth 0."
  },
  {
    "id": "ex-vgm7xas4",
    "version": 1,
    "section": "chain-of-trust",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "Why did the server not send the root certificate?",
    "hint": "Where does trust start?",
    "choices": [
      {
        "text": "It is too big to send",
        "correct": false,
        "why": "Size is not the reason."
      },
      {
        "text": "The root is secret",
        "correct": false,
        "why": "Its certificate is public; its key is secret."
      },
      {
        "text": "TLS 1.3 forbids it",
        "correct": false,
        "why": "It is pointless, not forbidden."
      },
      {
        "text": "The client must already have it",
        "correct": true,
        "why": "Right. A root sent by the server proves nothing."
      }
    ]
  },
  {
    "id": "ex-440n1epf",
    "version": 1,
    "section": "chain-of-trust",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why do certificate authorities sign sites with an intermediate rather than the root?",
    "hint": "The root's key.",
    "choices": [
      {
        "text": "Intermediates are faster to check",
        "correct": false,
        "why": "Speed is not it."
      },
      {
        "text": "The root's key stays offline",
        "correct": true,
        "why": "Right. A bad intermediate can be replaced."
      },
      {
        "text": "Browsers refuse roots",
        "correct": false,
        "why": "Roots are what browsers trust."
      },
      {
        "text": "It makes certificates cheaper",
        "correct": false,
        "why": "The reason is the root's key."
      }
    ]
  },
