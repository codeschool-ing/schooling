  {
    "id": "ex-j9qtzbqe",
    "version": 1,
    "section": "tls-handshake",
    "type": "multiple-choice",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "What does TLS add to a connection? Choose all that apply.",
    "hint": "Three things.",
    "choices": [
      {
        "text": "Confidentiality",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "Integrity",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "Authentication of the server",
        "correct": true,
        "why": "Yes."
      },
      {
        "text": "Speed",
        "correct": false,
        "why": "The handshake costs a round trip."
      },
      {
        "text": "Hiding which site you visit",
        "correct": false,
        "why": "The name is in the ClientHello."
      }
    ]
  },
