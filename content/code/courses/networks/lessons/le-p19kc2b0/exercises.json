    "section": "tls-handshake",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "From which message on is the TLS 1.3 handshake encrypted?",
    "hint": "Both halves of the key.",
    "choices": [
      {
        "text": "From the ClientHello",
        "correct": false,
        "why": "No key exists yet."
      },
      {
        "text": "After the client's Finished",
        "correct": false,
        "why": "The certificate was already encrypted."
      },
      {
        "text": "Only the HTTP request",
        "correct": false,
        "why": "The certificate is encrypted too."
      },
      {
        "text": "After ServerHello",
        "correct": true,
        "why": "Right. Even the certificate is hidden."
      }
    ]
  },
