        "why": "Right."
      },
      {
        "text": "The certificate expired",
        "correct": false,
        "why": "TLS worked; a status came back."
      },
      {
        "text": "DNS gave the wrong address",
        "correct": false,
        "why": "The right server answered."
      }
    ]
  },
