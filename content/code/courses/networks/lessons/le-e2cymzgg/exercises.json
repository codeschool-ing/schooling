      },
      {
        "left": "230",
        "right": "Logged in"
      },
      {
        "left": "226",
        "right": "The transfer finished"
      }
    ],
    "right_distractors": [
      "The file was not found"
    ]
  },
  {
    "id": "ex-wxqp3cxf",
    "version": 1,
    "section": "ftp-by-hand",
    "type": "quiz",
    "difficulty": "medium",
    "drillable": true,
    "prompt": "An FTP reply starts with 5. What does that say?",
    "hint": "2 done, 3 go on.",
    "choices": [
      {
        "text": "The server wants the next part of the login",
        "correct": false,
        "why": "That is 3."
      },
      {
        "text": "The transfer finished",
        "correct": false,
        "why": "That is a 2, 226."
      },
      {
        "text": "The command failed",
        "correct": true,
        "why": "Right. 4 and 5 are failures."
      },
      {
        "text": "A data connection is about to open",
        "correct": false,
        "why": "That is 150."
      }
    ]
  },
  {
    "id": "ex-xe22ytr3",
    "version": 1,
    "section": "ftp-by-hand",
    "type": "quiz",
