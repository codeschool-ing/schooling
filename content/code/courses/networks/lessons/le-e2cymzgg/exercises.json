    "choices": [
      {
        "text": "It named 192.168.10.20 but came from 203.0.113.2",
        "correct": true,
        "why": "Right. The router rewrote the packet, not the command."
      },
      {
        "text": "PORT is not a real FTP command",
        "correct": false,
        "why": "It is, and older than EPSV."
      },
      {
        "text": "The password was wrong",
        "correct": false,
        "why": "The login had worked."
      },
      {
        "text": "Port 21 was closed",
        "correct": false,
        "why": "The command reached the server."
      }
    ]
  },
  {
