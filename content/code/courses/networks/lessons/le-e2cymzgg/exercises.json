    "difficulty": "hard",
    "drillable": true,
    "prompt": "What makes a mode passive in FTP?",
    "hint": "Who opens what.",
    "choices": [
      {
        "text": "The client opens both",
        "correct": true,
        "why": "Right. The server only listens."
      },
      {
        "text": "The server opens both connections",
        "correct": false,
        "why": "Nothing opens the control connection but the client."
      },
      {
        "text": "No password is sent at all",
        "correct": false,
        "why": "Anonymous is a different matter."
      },
      {
        "text": "The data travels on port 21",
        "correct": false,
        "why": "Data has its own connection."
      }
    ]
  },
  {
    "id": "ex-7yah8e1b",
    "version": 1,
    "section": "two-connections",
    "type": "quiz",
    "difficulty": "hard",
    "drillable": true,
    "prompt": "Why did vsftpd answer 500 Illegal PORT command to the laptop?",
