    "choices": [
      {
        "text": "The password is wrong",
        "correct": false,
        "why": "Then there would be no login."
      },
      {
        "text": "The passive range is blocked",
        "correct": true,
        "why": "Right. Port 21 open, data ports not."
      },
      {
        "text": "Port 21 is blocked on the server",
        "correct": false,
        "why": "Then there would be no login either."
      },
      {
        "text": "The folder is empty",
        "correct": false,
        "why": "An empty listing still arrives."
      }
    ]
  },
