# Build output
/bin/
/dist/
*.exe

# Go
*.test
*.out
/vendor/

# Node — the browser suites install playwright without saving it
/node_modules/
npm-debug.log*

# Terraform — state never belongs in the repository; it lives in a bucket,
# versioned and locked. A .tfvars file usually carries values that are not
# meant to be read by anybody who clones this.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# Local environment
.env
.env.*
!.env.example

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
